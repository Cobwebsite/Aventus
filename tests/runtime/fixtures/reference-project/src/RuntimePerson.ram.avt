import { RuntimePerson } from "./RuntimePerson.data.avt";

export class RuntimePersonRAM extends Aventus.Ram<RuntimePerson> implements Aventus.IRam {
    public static getInstance() {
        return Aventus.Instance.get(RuntimePersonRAM);
    }

    public override defineIndexKey(): keyof RuntimePerson {
        return 'id';
    }

    protected override getTypeForData(objJson: Aventus.KeysObject<RuntimePerson> | RuntimePerson): new () => RuntimePerson {
        return RuntimePerson;
    }

    protected override async transformCreateRequestToItem(item: RuntimePerson): Promise<Aventus.ResultWithError<RuntimePerson>> {
        const result = new Aventus.ResultWithError<RuntimePerson>();
        result.result = item;
        return result;
    }

    protected override async transformCreateRequestListToItem(items: RuntimePerson[]): Promise<Aventus.ResultWithError<RuntimePerson[]>> {
        const result = new Aventus.ResultWithError<RuntimePerson[]>();
        result.result = items;
        return result;
    }

    protected override async transformUpdateRequestToItem(item: RuntimePerson): Promise<Aventus.ResultWithError<RuntimePerson>> {
        return this.transformCreateRequestToItem(item);
    }

    protected override async transformUpdateRequestListToItem(items: RuntimePerson[]): Promise<Aventus.ResultWithError<RuntimePerson[]>> {
        return this.transformCreateRequestListToItem(items);
    }
}
