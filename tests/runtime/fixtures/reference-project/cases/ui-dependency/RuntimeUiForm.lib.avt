import { FormHandler } from "Aventus@UI:Aventus.Form.package.avt";
import { Required, Email } from "Aventus@UI:Aventus.Form.Validators.package.avt";

export class RuntimeUiForm {
    public static async inspect() {
        const handler = new FormHandler<{ email: string, profile: { name: string } }>({
            email: [Required, Email], profile: () => true,
        }, {
            defaultValues: { email: "", profile: { name: "start" } },
            onValidateFallback: () => {},
        });
        const directRequired = new Required().validate("", "email", async () => {});
        const directEmail = new Email().validate("wrong", "email", async () => {});
        const empty = await handler.validate();
        handler.item.email = "wrong";
        const invalid = await handler.validate();
        handler.parts.email?.onValidation.add(async (errors) => errors);
        const invalidWithListener = await handler.validate();
        handler.parts.email?.onValidation.add(async () => []);
        const invalidWithEmptyListener = await handler.validate();
        handler.item.email = "alice@example.test";
        handler.item.profile.name = "changed";
        const valid = await handler.validate();
        handler.reset();
        const firstReset = { email: handler.item.email, profile: handler.item.profile.name };
        handler.item.profile.name = "changed again";
        handler.reset();
        return { directRequired, directEmail, empty, invalid, invalidWithListener, invalidWithEmptyListener, valid,
            firstReset, resetEmail: handler.item.email, resetProfile: handler.item.profile.name,
            defaultEmail: handler.defaultValues.email, defaultProfile: handler.defaultValues.profile.name };
    }
}
