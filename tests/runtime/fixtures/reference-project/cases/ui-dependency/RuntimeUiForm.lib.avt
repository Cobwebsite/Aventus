import { FormHandler } from "Aventus@UI:Aventus.Form.package.avt";
import { Required, Email } from "Aventus@UI:Aventus.Form.Validators.package.avt";

export class RuntimeUiForm {
    public static async inspect() {
        const handler = new FormHandler<{ email: string }>({ email: [Required, Email] }, {
            defaultValues: { email: "" },
            onValidateFallback: () => {},
        });
        const directRequired = new Required().validate("", "email", async () => {});
        const directEmail = new Email().validate("wrong", "email", async () => {});
        const empty = await handler.validate();
        handler.item.email = "wrong";
        const invalid = await handler.validate();
        handler.parts.email?.onValidation.add(async (errors) => errors);
        const invalidWithListener = await handler.validate();
        handler.item.email = "alice@example.test";
        const valid = await handler.validate();
        handler.reset();
        return { directRequired, directEmail, empty, invalid, invalidWithListener, valid, resetEmail: handler.item.email };
    }
}
