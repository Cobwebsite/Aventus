import { Date, DateTime, Time } from 'Aventus@Main:Aventus.package.avt';

export class RuntimeAttributeTypes extends Aventus.WebComponent implements Aventus.DefaultComponent {
    @Attribute()
    public caption: string = 'initial';

    @Attribute()
    public mode: 'compact' | 'expanded' = 'compact';

    @Attribute()
    public day: Date = Date.parse('2024-02-29');

    @Attribute()
    public moment: DateTime = DateTime.parse('2024-02-29T12:30:00');

    @Attribute()
    public hour: Time = Time.parse('12:30:00');

    @Property()
    public selectedday: Date = Date.parse('2024-02-29');
}

