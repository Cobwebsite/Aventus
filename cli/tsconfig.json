{
	"compilerOptions": {
		"target": "ESNext",
		"lib": [
			"ES2023",
			"dom"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"strict": false,
		"outDir": "out",
		"rootDir": "src",
		"noImplicitAny": false,
		"noImplicitReturns": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"paths": {
			"@server/*": [
				"../server/src/*"
			]
		},
		"plugins": [
			{
				"transform": "typescript-transform-paths"
			}
		]
	},
	"include": [
		"src",
	],
	"exclude": [
		".vscode-test"
	],
	"references": [
		{
			"path": "../server/"
		}
	]
}