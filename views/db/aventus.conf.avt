{
	"module": "dbEditor",
	"componentPrefix": "av",
	"hideWarnings": true,
	"build": [
		{
			"name": "Main",
			"disabled": true,
			"src": [
				"./src/components/*",
				"./src/lib/*"
			],
			"dependencies": {
				"Aventus@UI": {},
				"OneMoreUI": {
					"isLocal": true
				},
				"VscodeView@Main": {
					"isLocal": true,
					"include": "full"
				}
			},
			"compile": [
				{
					"output": [
						"../../client/views/db/index.js",
						"./dist/index.js"
					]
				}
			]
		}
	],
	"static": [
		{
			"name": "Main",
			"input": "./src/static",
			"output": [
				"../../client/views/db",
				"./dist"
			]
		}
	]
}