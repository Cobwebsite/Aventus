:host {
	align-items: center;
	display: flex;
	font-size: 12px;
	justify-content: space-between;
	padding: 6px 14px;
	position: relative;
	user-select: none;

	&:hover {
		background-color: rgba(255, 255, 255, 0.03);
	}

	.field-name-container {
		align-items: center;
		display: flex;
		gap: 6px;

		.field-name {
			color: var(--text-primary);
			cursor: pointer;
			font-weight: 450;
		}

		.field-edit {
			background-color: var(--bg-main);
			border: 1px solid var(--color-accent);
			border-radius: 4px;
			color: var(--text-primary);
			display: none;
			font-size: 12px;
			outline: none;
			padding: 2px 6px;
			width: 100%;
			user-select: all;
		}

		.field-pk-badge {
			color: var(--color-pk);
			display: none;
			font-size: 10px;
			font-weight: bold;
		}
	}

	.field-type {
		color: var(--text-secondary);
		font-size: 11px;
	}
}

:host([primary]) {
	.field-name-container {
		.field-pk-badge {
			display: inline;
		}
	}
}

:host([is_editing]) {
	.field-name-container {
		.field-name {
			display: none;
		}

		.field-edit {
			display: inline-block;
		}
	}
}

:host([pulse]) {
    animation: field-glow 2s ease-out 1;
}

@keyframes field-glow {
	0% {
		background-color: rgba(59, 130, 246, 0.4);
	}

	100% {
		background-color: transparent;
	}
}