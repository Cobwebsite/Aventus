<div class="logo-section">
    <h1 class="logo-title">{{ this.editor.schema?.name }}</h1>
</div>

<div class="controls-section">

    if(this.hasNewContent) {
        <av-button color="warning" @click="updateSchema">
            <mi-icon icon="refresh"></mi-icon>
        </av-button>
    }

    <av-button color="success" @click="exportSchema" disabled="{{ this.disableSave }}">
        <mi-icon icon="save"></mi-icon>
    </av-button>

    <av-button color="{{ this.editor.allAreLocked ? 'error' : 'warning' }}" @click="toggleLockAll">
        if(this.editor.allAreLocked) {
            <mi-icon icon="lock"></mi-icon>
        }
        else {
            <mi-icon icon="lock_open"></mi-icon>
        }
    </av-button>


    <div class="divider"></div>

    <av-button disabled="{{ this.disableUndo }}" @click="undo">
        <mi-icon icon="undo"></mi-icon>
    </av-button>

    <av-button disabled="{{ this.disableRedo }}" @click="redo">
        <mi-icon icon="redo"></mi-icon>
    </av-button>

    <av-button @click="triggerSearch">
        <mi-icon icon="search"></mi-icon>
    </av-button>

    <!-- Zoom Controls -->
    <div class="zoom-controls">
        <button class="btn-zoom" title="Zoom arrière" @click="zoomOut">
            <mi-icon icon="remove"></mi-icon>
        </button>
        <span class="zoom-level">{{ Math.round(this.editor.scale * 100) }}%</span>
        <button class="btn-zoom" title="Zoom avant" @click="zoomIn">
            <mi-icon icon="add"></mi-icon>
        </button>
        <button class="btn-zoom" title="Réinitialiser le zoom" @click="zoomResetEmit">
            <mi-icon icon="sync"></mi-icon>
        </button>
    </div>
</div>