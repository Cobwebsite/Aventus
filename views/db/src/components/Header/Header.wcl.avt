import { ToastManager } from "Aventus@UI:Aventus.Toast.package.avt";
import { API } from "../../lib/API.lib.avt";
import { Editor } from "../Editor/Editor.wcl.avt";
import { Toast } from "OneMoreUI:OneMoreUI.Components.Interaction.package.avt";

export class Header extends Aventus.WebComponent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    // @ViewElement()
    // protected fileInput!: HTMLInputElement;

    @Injectable()
    public editor!: Editor;

    @Watch()
    public disableSave: boolean = false;

    @Watch()
    @Injectable()
    public hasNewContent: boolean = false;


    public get disableUndo(): boolean {
        return !this.editor.canUndo;
    }
    public get disableRedo(): boolean {
        return !this.editor.canRedo;
    }
    //#endregion


    //#region constructor

    //#endregion


    //#region methods

    /**
    * 
    */
    protected exportSchema() {
        Toast.add({
            message: "Test 124",
            closable: true,
            title: "Test"
        })
        this.editor.exportSchema();
    }
    /**
    * 
    */
    protected toggleLockAll() {
        this.editor.toggleLockAll();

    }
    /**
    * 
    */
    protected undo() {
        this.editor.undo();
    }
    /**
    * 
    */
    protected redo() {
        this.editor.redo();
    }
    /**
    * 
    */
    protected triggerSearch() {
        this.editor.searchActive = true;
    }
    /**
    * 
    */
    protected zoomOut() {
        this.editor.zoomOut();
    }
    /**
    * 
    */
    protected zoomIn() {
        this.editor.zoomIn();
    }
    /**
    * 
    */
    protected zoomResetEmit() {
        this.editor.zoomResetEmit();
    }

    /**
     * 
     */
    protected updateSchema() {
        this.editor.reloadFile();
    }


    protected override postCreation(): void {
        API.onIsDirtyChange.add((value) => {
            this.disableSave = !value;
        });
    }

    //#endregion

}