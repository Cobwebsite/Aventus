<div class="table-header-color-bar" @click="changeColor"></div>
<om-color-picker @element="colorPicker" class="table-color-picker" @bind="this.table.color"></om-color-picker>
<!-- Header -->
<div class="table-header" @mousedown="onMouseDown">
    <!-- Lock Button -->
    <button class="node-lock-btn" title="{{ this.locked ? 'Déverrouiller la table' : 'Verrouiller la table' }}"
        @click="toggleLock">
        {{ this.locked ? '🔒' : '🔓' }}
    </button>



    <!-- Editable Table Name -->
    <span class="table-title-span" @dblclick="startEditTable">
        {{ this.table.name }}
    </span>
    <input @element="tableInputRef" @bind="this.editTableName" class="inline-edit-input" @blur="saveEditTable"
        @keydown="keyDownEditTable" />
</div>

<!-- Fields -->
<div class="table-fields" @mousedown="prevent">
    for(let field of this.table.fields) { 
        <av-table-field :locked="this.locked" :field="field" :table="this"></av-table-field>
    }
</div>

<om-menu @element="menuEl">
    <om-menu-item icon="colors" label="Color" @click="changeColor"></om-menu-item>
    if(this.locked) {
        <om-menu-item icon="lock_open" label="Unlock" @click="toggleLock"></om-menu-item>
    }
    else {
        <om-menu-item icon="lock" label="Lock" @click="toggleLock"></om-menu-item>
    }
    <om-menu-item icon="edit" label="Rename" @click="startEditTable"></om-menu-item>
</om-menu>