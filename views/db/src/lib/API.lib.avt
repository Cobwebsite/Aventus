import { Callback } from "Aventus@Main:Aventus.package.avt";
import { DEFAULT_SCHEMA } from "./DefaultSchema.lib.avt";
import type { Schema } from "./Definition.lib.avt";
import { Process } from "Aventus@UI:Aventus.package.avt";

export class API {
    public static readonly onIsDirtyChange: Callback<(value: boolean) => void> = new Callback();
    public static readonly onHasNewContent: Callback<(value: Schema) => void> = new Callback();
    public static init() {
        if(VscodeView.Router.isVscode) {
            VscodeView.Router.getInstance().addRoute<boolean>({
                channel: "is_dirty",
                callback: (data) => {
                    this.onIsDirtyChange.trigger(data);
                }
            });

            VscodeView.Router.getInstance().addRoute<Schema>({
                channel: "update_content",
                callback: (data) => {
                    this.onHasNewContent.trigger(data);
                }
            });
        }
    }

    public static async loadSchema(): Promise<Schema | undefined> {
        if(VscodeView.Router.isVscode) {
            const result = await Process.execute(VscodeView.Router.getInstance().sendWithResponse<Schema>({
                channel: "getData",
            }));
            if(result) {
                return result;
            }
        }
        else {
            return DEFAULT_SCHEMA;
        }
        return undefined;
    }

    public static async save(): Promise<void> {
        if(!VscodeView.Router.isVscode) return;
        await VscodeView.Router.getInstance().sendWithResponse<boolean>({
            channel: "save"
        });
    }

    public static async triggerChange(schema: Schema): Promise<void> {
        if(!VscodeView.Router.isVscode) return;
        await VscodeView.Router.getInstance().sendWithResponse<boolean>({
            channel: "triggerChange",
            body: schema,
        });

    }




}