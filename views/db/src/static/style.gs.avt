:root {
	--bg-main: #0d1117;
	--bg-surface: #161b22;
	--bg-header: #21262d;
	--border-color: #30363d;
	--border-hover: #8b949e;
	--text-primary: #e6edf3;
	--text-secondary: #8b949e;
	--color-accent: #3b82f6;
	--color-accent-hover: #1d4ed8;
	--color-pk: #f59e0b;
	--color-area: #ef4444;
}

@import './_onemoreui.gs.avt';

html,
body {
	background-color: var(--bg-main);
	color: var(--text-primary);
	font-family: "Segoe WPC", "Segoe UI", sans-serif;
	height: 100%;
	margin: 0;
	overflow: hidden;
	padding: 0;
	width: 100%;
}
