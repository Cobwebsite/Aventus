<div class="section-header">
    <h2>Generated code</h2>
</div>

<div class="output-grid">
    <!-- Config Panel -->
    <div class="config-panel">
        <div class="panel-header">
            <h3>Configuration</h3>
        </div>
        <div class="panel-body">
            <div class="form-group">
                <om-input label="Nom de la migration :" @bind="this.migrationName"></om-input>
                <small>Unique identifier for the migration (ex: 0001_update).</small>
            </div>
            <div class="form-group">
                <om-input label="C# classname" @bind="this.migrationClassName"></om-input>
                <small>Valid name for the C# class inherit from <code>Migration</code>.</small>
            </div>
            <div class="form-group">
                <om-input label="Save directory" @bind="this.saveDir">
                    <mi-icon icon="folder" slot="append" @click="selectDir"></mi-icon>
                </om-input>
            </div>
            <div class="quick-stats">
                <h4>Statistics :</h4>
                <ul>
                    <li>Created tables : <span>{{ this.comparaison.addedTables.length }}</span></li>
                    <li>Renamed tables : <span>{{ this.comparaison.renamedTables.length }}</span></li>
                    <li>Deleted tables : <span>{{ this.comparaison.deletedTables.length }}</span></li>
                    <li>Changes applied : <span>{{ this.statsModified }}</span></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Code Display Panel -->
    <div class="code-panel">
        <div class="panel-header">
            <h3>Source code C#</h3>
            <div class="code-actions">
                <om-button outline @click="copy">Copy</om-button>
                <om-button @click="save">Save</om-button>
            </div>
        </div>
        <div class="code-viewport">
            <av-code language="csharp" @element="codeEl"></av-code>
        </div>
    </div>
</div>

<div class="action-footer">
    <om-button @click="back">Retour</om-button>
</div>