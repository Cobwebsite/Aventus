<div class="content">
    <av-import-schema class="step" @element="importEl" active="{{ MainState.instance.step == 0 }}"></av-import-schema>
    <av-resolution class="step" active="{{ MainState.instance.step == 1 }}"></av-resolution>
    <av-migration-writter class="step" active="{{ MainState.instance.step == 2 }}"></av-migration-writter>
</div>