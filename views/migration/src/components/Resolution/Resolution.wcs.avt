:host {
	.diff-container {
		align-items: start;
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr 1.25fr;


		.panel {
			background: var(--surface-100);
			border: 1px solid var(--border-color);
			border-radius: var(--border-radius-lg);
			box-shadow: var(--elevation-2);
			overflow: hidden;

			.panel-header {
				align-items: center;
				background: rgba(255, 255, 255, 0.02);
				border-bottom: 1px solid var(--border-color);
				display: flex;
				justify-content: space-between;
				padding: 1.25rem 1.5rem;

				h3 {
					font-size: 1.1rem;
					font-weight: 600;
					margin: 0;
				}
			}

			.panel-body {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				padding: 1.5rem;

				.mapping-card {
					background: var(--surface-200);
					border: 1px solid var(--border-color);
					border-radius: var(--border-radius-md);
					padding: 1.25rem;

					h4 {
						font-size: 1rem;
						font-weight: 500;
						margin: 0;
						margin-bottom: 0.25rem;
					}

					.card-desc {
						color: var(--neutral);
						font-size: 0.8rem;
						margin-bottom: 1rem;
					}

					.mapping-adder {
						align-items: center;
						display: flex;
						gap: 0.5rem;

						om-select {
							min-width: 0;
						}
					}

					.mapping-list {
						display: flex;
						flex-direction: column;
						gap: 0.5rem;
						margin-bottom: 1rem;

						.mapping-item {
							align-items: center;
							background: rgba(255, 255, 255, 0.02);
							border: 1px solid var(--border-color);
							border-radius: var(--border-radius-lg);
							display: flex;
							font-size: 0.85rem;
							justify-content: space-between;
							padding: 0.5rem 0.75rem;
						}

						.mapping-names {
							align-items: center;
							display: flex;
							font-family: var(--font-mono);
							gap: 0.5rem;
						}

						.mapping-arrow {
							color: var(--info);
						}

						.mapping-delete {
							background: transparent;
							border: none;
							border-radius: 4px;
							color: var(--error);
							cursor: pointer;
							font-size: 1rem;
							padding: 0.1rem 0.3rem;
						}

						.mapping-delete:hover {
							background: var(--error-600);
						}
					}



					.table-selector-wrapper {
						align-items: center;
						display: flex;
						gap: 0.75rem;
						margin-bottom: 1rem;


						label {
							flex-shrink: 0;
						}
					}
				}
			}

		}

	}
}
