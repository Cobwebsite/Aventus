import { Alert } from "OneMoreUI:OneMoreUI.Components.Interaction.package.avt";
import { Generator, type ProcessFieldsResult } from "../../../../lib/Generator.lib.avt";
import { MainState } from "../../../MainState.lib.avt";

export class RenamedField extends Aventus.WebComponent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    @Watch((target: RenamedField) => {
        target.oldField = "";
        target.newField = "";
    })
    protected mappingFieldTable?: string;

    public get tableComparisons(): ProcessFieldsResult[] {
        return MainState.instance.comparison.tableComparisons;
    }
    public get mappingFieldTableInfo(): ProcessFieldsResult {
        for(let table of this.tableComparisons) {
            if(table.newTableName == this.mappingFieldTable) return table;
        }
        return {
            addedFields: [],
            deletedFields: [],
            hasChanges: false,
            isRename: false,
            modifiedFields: [],
            newTableName: '',
            oldTableName: '',
            renamedFields: []
        };
    }

    public get fieldsMapping(): Record<string, string> {
        const table = this.mappingFieldTable!;
        if(!MainState.instance.mappings.fields[table]) {
            MainState.instance.mappings.fields[table] = {};
        }
        return MainState.instance.mappings.fields[table];
    }

    @Watch()
    public oldField: string = "";

    @Watch()
    public newField: string = "";
    //#endregion


    //#region constructor

    //#endregion


    //#region methods

    /**
     * 
     */
    protected addFieldMapping() {
        if(!this.newField || !this.oldField || !this.mappingFieldTable) {
            Alert.open({
                type: "error",
                title: "Missing data",
                content: "Please select a value for the old field and the new field"
            });
            return;
        }

        const table = this.mappingFieldTable;
        if(!MainState.instance.mappings.fields[table]) {
            MainState.instance.mappings.fields[table] = { [this.oldField]: this.newField };
        }
        else {
            MainState.instance.mappings.fields[table][this.oldField] = this.newField;
        }
        Generator.compareSchemas();
    }

    /**
     * 
     */
    protected removeFieldMapping(e: Event) {
        if(!this.mappingFieldTable) return;
        if(e.currentTarget instanceof HTMLElement) {
            const field = e.currentTarget.dataset.field!;

            if(MainState.instance.mappings.fields[this.mappingFieldTable]) {
                delete MainState.instance.mappings.fields[this.mappingFieldTable][field];
            }
        }
        Generator.compareSchemas();
    }
    //#endregion

}