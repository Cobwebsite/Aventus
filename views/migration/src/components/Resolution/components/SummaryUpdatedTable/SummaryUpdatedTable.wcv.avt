<div class="diff-table-group">
    <div class="diff-table-header">
        <span class="diff-table-title">
            {{ this.change.isRename ? `Renamed table : ${this.change.oldTableName} ➔ ${this.change.newTableName}` : `Edited table : ${this.change.newTableName}` }}
        </span>
        <span class="badge">{{ this.change.isRename ? 'Renamed' : 'Edited' }}</span>
    </div>
    <div class="diff-table-body">
        for(let renameField of this.change.renamedFields) {
            <div class="diff-item">
                <span class="diff-tag diff-tag-ren">Renamed</span>
                <span>
                    <span class="diff-change-old">{{ renameField.oldName }}</span>
                    <span>➔</span>
                    <span class="diff-change-new">{{ renameField.newName }}</span>
                </span>
            </div>
        }

        for(let deletedField of this.change.deletedFields) {
            <div class="diff-item">
                <span class="diff-tag diff-tag-del">Removed</span>
                <span class="diff-change-old">{{ deletedField.name }}</span>
            </div>
        }

        for(let addedField of this.change.addedFields) {
            <div class="diff-item">
                <span class="diff-tag diff-tag-add">Added</span>
                <span class="diff-change-new">{{ addedField.name }}</span>
                <span class="diff-item-detail">{{ `(${addedField.type.name}${addedField.nullable ? ', null' : ''})` }}</span>
            </div>
        }

        for(let modifiedField of this.change.modifiedFields) {
            <div class="diff-item">
                <span class="diff-tag diff-tag-mod">Edited</span>
                <span>{{ modifiedField.name }}</span>
                <span class="diff-item-detail">
                    if(modifiedField.changes.type) {
                        <span>
                            <span>type: </span>
                            <span class="diff-change-old">{{modifiedField.changes.type!.old}}</span>
                            <span>➔</span>
                            <span class="diff-change-new">{{modifiedField.changes.type!.new}}</span>
                        </span>
                    }

                    if(modifiedField.changes.nullable) {
                        <span>
                            <span>nullable: </span>
                            <span class="diff-change-old">{{modifiedField.changes.nullable!.old}}</span>
                            <span>➔</span>
                            <span class="diff-change-new">{{modifiedField.changes.nullable!.new}}</span>
                        </span>
                    }

                    if(modifiedField.changes.unique) {
                        <span>
                            <span>unique: </span>
                            <span class="diff-change-old">{{modifiedField.changes.unique!.old}}</span>
                            <span>➔</span>
                            <span class="diff-change-new">{{modifiedField.changes.unique!.new}}</span>
                        </span>
                    }
                </span>
            </div>
        }
    </div>
</div>