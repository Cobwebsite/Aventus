import type { Select } from "OneMoreUI:OneMoreUI.Components.Form.Select.package.avt";
import { MainState } from "../../../MainState.lib.avt";
import { Generator, type CompareSchemasResult } from "../../../../lib/Generator.lib.avt";
import { Alert } from "OneMoreUI:OneMoreUI.Components.Interaction.package.avt";

export class RenamedTable extends Aventus.WebComponent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    @Watch()
    public newTable: string = "";

    @Watch()
    public oldTable: string = "";


    public get comparison(): CompareSchemasResult {
        return MainState.instance.comparison;
    }

    public get tables(): Record<string, string> {
        return MainState.instance.mappings.tables;
    }
    //#endregion


    //#region constructor

    //#endregion


    //#region methods
    /**
     * 
     */
    protected removeTableMapping(e: Event) {
        if(e.currentTarget instanceof HTMLElement) {
            const field = e.currentTarget.dataset.table!;
            delete MainState.instance.mappings.tables[field];
        }
        Generator.compareSchemas();
    }

    /**
     * 
     */
    protected addTableMapping() {
        if(!this.newTable || !this.oldTable) {
            Alert.open({
                type: "error",
                title: "Missing data",
                content: "Please select a value for the old field and the new field"
            });
            return;
        }

        MainState.instance.mappings.tables[this.oldTable] = this.newTable;
        Generator.compareSchemas();
    }
    //#endregion

}