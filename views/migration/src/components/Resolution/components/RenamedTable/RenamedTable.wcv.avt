<h4>Renamed tables</h4>
<p class="card-desc">If a table is renamed, associate it with the old name with the new one.</p>
<div class="mapping-list">
    if(Object.keys(this.tables).length == 0) {
        <div class="no-table">No association table.</div>
    }
    else {
        for(let oldName in this.tables) {
            <div class="mapping-item">
                <span class="mapping-names">
                    <span>{{ oldName }}</span>
                    <span class="mapping-arrow">➔</span>
                    <span>{{ this.tables[oldName] }}</span>
                </span>
                <button class="mapping-delete" @click="removeTableMapping" data-table="{{ oldName }}">✕</button>
            </div>
        }
    }
</div>
<div class="mapping-adder">
    <om-select @bind="this.oldTable">
        <om-option value="">-- Deleted table --</om-option>
        for(let deletedTable of this.comparison.deletedTables) {
            <om-option value="{{ deletedTable.name }}">{{ deletedTable.name }}</om-option>
        }
    </om-select>
    <span class="arrow-indicator">➔</span>
    <om-select @bind="this.newTable">
        <om-option value="">-- Added table --</om-option>
        for(let addedTable of this.comparison.addedTables) {
            <om-option value="{{ addedTable.name }}">{{ addedTable.name }}</om-option>
        }
    </om-select>
    <om-button @click="addTableMapping">Lier</om-button>
</div>