for(let deletedTable of this.comparison.deletedTables) {
    <div class="diff-table-group">
        <div class="diff-table-header">
            <span class="diff-table-title" style="color: var(--color-danger)">Deleted table : {{ deletedTable.name }}</span>
            <span class="badge">Deleted</span>
        </div>
        <div class="diff-table-body">
            for(let deletedTableField of deletedTable.fields) {
                <div class="diff-item">
                    <span class="diff-tag">-</span>
                    <span class="diff-change-old">{{ deletedTableField.name }}</span>
                </div>
            }
        </div>
    </div>
}