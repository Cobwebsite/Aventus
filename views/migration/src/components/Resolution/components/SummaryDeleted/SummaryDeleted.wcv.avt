for(let deletedTable of this.comparison.deletedTables) {
    <div class="diff-table-group" style="border-color: rgba(239, 68, 68, 0.4)">
        <div class="diff-table-header" style="background: rgba(239, 68, 68, 0.05)">
            <span class="diff-table-title" style="color: var(--color-danger)">Table Supprimée : {{ deletedTable.name }}</span>
            <span class="badge badge-old">Supprimé</span>
        </div>
        <div class="diff-table-body">
            for(let deletedTableField of deletedTable.fields) {
                <div class="diff-item">
                    <span class="diff-tag diff-tag-del">-</span>
                    <span class="diff-change-old">{{ deletedTableField.name }}</span>
                </div>
            }
        </div>
    </div>
}