:host {
	width: 100%;

	.diff-table-group {
		background: rgba(15, 23, 42, 0.15);
		border: 1px solid var(--error);
		border-radius: var(--border-radius-lg);
		margin-bottom: 1rem;
		overflow: hidden;

		.diff-table-header {
			align-items: center;
			background: var(--error-100);
			border-bottom: 1px solid var(--border-color);
			display: flex;
			justify-content: space-between;
			padding: 0.75rem 1rem;

			.diff-table-title {
				font-family: var(--font-mono);
				font-size: 0.95rem;
				font-weight: 600;
			}

			.badge {
				background: var(--error-200);
				border: 1px solid var(--error);
				border-radius: 50px;
				color: var(--color-error);
				font-size: 0.75rem;
				font-weight: 600;
				padding: 0.25rem 0.65rem;
			}

		}

		.diff-table-body {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			padding: 0.75rem 1rem;

			.diff-item {
				align-items: center;
				display: flex;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				gap: 0.75rem;
				padding: 0.25rem 0;

				.diff-tag {
					align-items: center;
					align-items: center;
					background: var(--error-200);
					border-radius: 4px;
					display: flex;
					font-family: var(--font-sans);
					font-weight: 600;
					height: 20px;
					justify-content: center;
					line-height: 20px;
					padding-bottom: 3px;
					width: 20px;
				}

				.diff-item-detail {
					color: var(--neutral);
				}
			}



		}

	}
}
