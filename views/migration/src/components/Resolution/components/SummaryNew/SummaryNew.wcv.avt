for(let addedTable of this.comparison.addedTables) {
    <div class="diff-table-group">
        <div class="diff-table-header">
            <span class="diff-table-title">Table Ajoutée : {{ addedTable.name }}</span>
            <span class="badge badge-new">Nouveau</span>
        </div>
        <div class="diff-table-body">
            for(let addedTableField of addedTable.fields) {
                <div class="diff-item">
                    <span class="diff-tag diff-tag-add">+</span>
                    <span>{{ addedTableField.name }}</span>
                    <span class="diff-item-detail">{{ `(${addedTableField.type.name}${addedTableField.nullable ? ', null' : ''}${addedTableField.primaryKey ? ', PK' : ''})` }}</span>
                </div>
            }
        </div>
    </div>
}