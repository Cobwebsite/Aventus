import { Alert, Modal } from "OneMoreUI:OneMoreUI.Components.Interaction.package.avt";
import type { DatabaseModel } from "../../data/DatabaseModel.lib.avt";
import { uuidv4, Watcher } from "Aventus@Main:Aventus.package.avt";
import { Api } from "../../lib/Api.lib.avt";

export class CreateDatabaseModal extends Modal<DatabaseModel> implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    @Watch()
    public formNewDb: DatabaseModel = {
        UUID: uuidv4(),
        Database: "Spalio2",
        Host: "localhost",
        Password: "",
        Path: "",
        Type: "mysql",
        Username: "root",
        SavePassword: false
    };
    //#endregion


    //#region constructor

    //#endregion


    //#region methods
    /**
     * @inheritdoc
     */
    public override configure(): Aventus.Modal.ModalOptions<DatabaseModel> {
        return {
            closeWithClick: false,
        };
    }


    /**
     * 
     */
    protected async save() {
        const form = Watcher.extract(this.formNewDb)
        if(!await Api.testConnection(form)) {
            Alert.open({
                title: "Connection error",
                type: "error",
                content: "There is a problem with the credentials provided"
            });
            return;
        }
        this.resolve(Watcher.extract(form));
    }


    //#endregion

}