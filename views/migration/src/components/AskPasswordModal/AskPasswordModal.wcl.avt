import { Modal } from "OneMoreUI:OneMoreUI.Components.Interaction.package.avt";

export class AskPasswordModal extends Modal<string> implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    @Watch()
    @Injectable()
    public dbName: string = "";

    @Watch()
    public password: string = "";
    //#endregion


    //#region constructor

    //#endregion


    //#region methods
    /**
     * @inheritdoc
     */
    public override configure(): Aventus.Modal.ModalOptions<string> {
        return {
            closeWithEsc: true,
            closeWithClick: false,
        };
    }


    /**
     * 
     */
    protected save() {
       this.resolve(this.password)
    }


    //#endregion

}