<block name="header">
    <div>Password for : {{ this.dbName }}</div>
</block>
<av-row>
    <av-col size="12">
        <om-password label="Password" @bind="this.password"></om-password>
    </av-col>
</av-row>
<block name="footer">
    <om-button outline @click="reject">Cancel</om-button>
    <om-button color="primary" @click="save">Save</om-button>
</block>