import { Alert, Confirm } from "OneMoreUI:OneMoreUI.Components.Interaction.package.avt";
import { Generator } from "../../lib/Generator.lib.avt";
import { BaseContent } from "../BaseContent/BaseContent.wcl.avt";
import { CreateDatabaseModal } from "../CreateDatabaseModal/CreateDatabaseModal.wcl.avt";
import { MainState } from "../MainState.lib.avt";
import { Api } from "../../lib/Api.lib.avt";
import type { DatabaseModel } from "../../data/DatabaseModel.lib.avt";
import { compareObject, Watcher } from "Aventus@Main:Aventus.package.avt";
import { AskPasswordModal } from "../AskPasswordModal/AskPasswordModal.wcl.avt";


type FormType = {
    Type: string,
    Host: string,
    Username: string,
    Password: string,
    Database: string,
};

export class ImportSchema extends BaseContent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    @Watch()
    public databasesSource: DatabaseModel[] = [];

    @Watch()
    public databasesTarget: DatabaseModel[] = [];

    @Watch()
    public dbSource?: DatabaseModel = undefined;
    @Watch()
    public dbTarget?: DatabaseModel = undefined;
    //#endregion


    //#region constructor

    //#endregion


    //#region methods


    /**
     * 
     */
    protected selectDatabaseSource(e: Event) {
        const el = e.currentTarget;
        if(el instanceof HTMLElement) {
            const index = Number(el.dataset.index);
            const db = this.databasesSource[index];
            this.dbSource = db;
        }
    }
    /**
    * 
    */
    protected selectDatabaseTarget(e: Event) {
        const el = e.currentTarget;
        if(el instanceof HTMLElement) {
            const index = Number(el.dataset.index);
            const db = this.databasesTarget[index];
            this.dbTarget = db;
        }
    }

    /**
     * 
     */
    protected async deleteDatabaseSource(e: Event) {
        const el = e.currentTarget;
        if(el instanceof HTMLElement) {
            const index = Number(el.dataset.index);
            const db = this.databasesSource[index];
            const result = await Confirm.open({
                title: "Delete database",
                content: "Do you want to delete the database " + db.Database + "?",
                type: "error"
            });
            if(result) {
                if(compareObject(db, this.dbSource)) {
                    this.dbSource = undefined;
                }
                this.databasesSource = await Api.deleteDatabase('source', Watcher.extract(db));
            }
        }

    }

    protected async deleteDatabaseTarget(e: Event) {
        const el = e.currentTarget;
        if(el instanceof HTMLElement) {
            const index = Number(el.dataset.index);
            const db = this.databasesTarget[index];
            const result = await Confirm.open({
                title: "Delete database",
                content: "Do you want to delete the database " + db.Database + "?",
                type: "error"
            });
            if(result) {
                if(compareObject(db, this.dbTarget)) {
                    this.dbTarget = undefined;
                }
                this.databasesTarget = await Api.deleteDatabase('target', Watcher.extract(db));
            }
        }
    }

    /**
     * 
     */
    protected async createDatabaseSource() {
        const modal = new CreateDatabaseModal();
        const result = await modal.show();
        if(result) {
            this.databasesSource = await Api.setDatabase('source', result);
        }
    }

    protected async createDatabaseTarget() {
        const modal = new CreateDatabaseModal();
        const result = await modal.show();
        if(result) {
            this.databasesTarget = await Api.setDatabase('target', result);
        }
    }

    protected async loadData() {
        const db = await Api.getDatabases();
        this.databasesSource = db?.source ?? [];
        this.databasesTarget = db?.target ?? [];
    }

    protected getIcon(db: DatabaseModel) {
        if(db.Type == "mysql") return Api.wwwroot + "img/mysql.svg";
        if(db.Type == "mssql") return Api.wwwroot + "img/mssql.svg";
        if(db.Type == "postgresql") return Api.wwwroot + "img/postgresql.svg";
        if(db.Type == "sqlite") return Api.wwwroot + "img/sqlite.svg";

        return "";
    }

