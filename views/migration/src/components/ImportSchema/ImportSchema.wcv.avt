<div class="section-header">
    <h2>Data Sources</h2>
    <p>Provide data source or schema to generate the migration</p>
</div>
<div class="schemas-grid">
    <div class="schema-card">
        <div class="card-header">
            <h3>Database Source</h3>
            <p>Provide the initial data source model. You can skip this step if it's the initial migration.</p>
        </div>
        <div class="list">
            for(let i = 0; i < this.databasesSource.length; i++) {
                @Context('database', this.databasesSource[i])
                <div class="database" active="{{ compareObject(this.dbSource, database) }}" @click="selectDatabaseSource" data-index="{{ i }}">
                    <av-img src="{{this.getIcon(database)}}"></av-img>
                    <div>{{ database.Database }} ({{ database.Host }})</div>
                    <mi-icon icon="delete" @click="deleteDatabaseSource" data-index="{{ i }}"></mi-icon>
                </div>
            }
            <div class="add" @click="createDatabaseSource">
                <mi-icon icon="add"></mi-icon>
            </div>
        </div>
        <!-- <div class="or">
            OR
        </div>
        <div class="import-file">
            <mi-icon icon="upload"></mi-icon>
            <span>Import schema file (*.db.avt)</span>
        </div> -->
    </div>

    <div class="schema-card">
        <div class="card-header">
            <h3>Database Final</h3>
            <p>Provide the final data source model.</p>
        </div>
        <div class="list">
            for(let i = 0; i < this.databasesTarget.length; i++) {
                @Context('database', this.databasesTarget[i])
                <div class="database" active="{{ compareObject(this.dbTarget, database) }}" @click="selectDatabaseTarget" data-index="{{ i }}">
                    <av-img src="{{this.getIcon(database)}}"></av-img>
                    <div>{{ database.Database }} ({{ database.Host }})</div>
                    <mi-icon icon="delete" @click="deleteDatabaseTarget" data-index="{{ i }}"></mi-icon>
                </div>
            }
            <div class="add" @click="createDatabaseTarget">
                <mi-icon icon="add"></mi-icon>
            </div>
        </div>
        <!-- <div class="or">
            OR
        </div>
        <div class="import-file">
            <mi-icon icon="upload"></mi-icon>
            <span>Import schema file (*.db.avt)</span>
        </div> -->
    </div>
</div>
<div class="action-footer">
    <om-button @click="analyzeAndCompare" @element="nextEl">Compare schemas</om-button>
</div>