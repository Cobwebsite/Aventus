{
	"module": "migration",
	"componentPrefix": "av",
	"hideWarnings": true,
	"build": [
		{
			"name": "Main",
			"disabled": true,
			"src": [
				"./src/components/*",
				"./src/data/*",
				"./src/lib/*"
			],
			"dependencies": {
				"Aventus@UI": {},
				"OneMoreUI": "1.0.3",
				"VscodeView": {
					"version": "1.0.1",
					"include": "full"
				}
			},
			"compile": [
				{
					"output": [
						"../../client/views/migration/index.js",
						"./dist/index.js"
					]
				}
			]
		}
	],
	"static": [
		{
			"name": "Main",
			"input": "./src/static",
			"output": [
				"../../client/views/migration",
				"./dist"
			]
		}
	]
}