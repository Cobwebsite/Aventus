type Dependency = {
    name: string;
    version: string;
    uri: string;
};

export class Dependencies extends Aventus.WebComponent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props
    @Attribute()
    public no_deps!: boolean;

    @Watch((target: Dependencies) => {
        target.no_deps = target.dependencies.length == 0;
    })
    private dependencies: Dependency[] = [{
        name: "AventusUI",
        version: "1.0.0",
        uri: "https://aventusjs.com/aventusUI.def.avt"
    }, {
        name: "AventusUI2",
        version: "1.0.0",
        uri: "https://aventusjs.com/aventusUI.def.avt"
    }];
    //#endregion


    //#region variables

    @ViewElement()
    protected temp!: HTMLElement[];
    //#endregion


    //#region constructor

    //#endregion


    //#region methods

    //#endregion

}