import { HttpResponse } from "./HttpResponse.lib.avt";

export class HttpCache {

    private static cache: Map<string, HttpResponse> = new Map();
    private static pending: Map<string, Promise<HttpResponse>> = new Map();

    public static fetch(fullUrl: string, request: RequestInit): Promise<HttpResponse> {
        const key = this.generateCacheKey(fullUrl, request);
        if(key) {
            const value = this.cache.get(key);
            if(value) return Promise.resolve(value);
            const pending = this.pending.get(key);
            if(pending) return pending;
        }

        let transport: Promise<Response>;
        try {
            transport = fetch(fullUrl, request);
        }
        catch(error) {
            return Promise.reject(error);
        }
        let pending: Promise<HttpResponse>;
        pending = Promise.resolve(transport).then(result => {
            const response = new HttpResponse(result);
            if(key && this.pending.get(key) === pending) {
                this.cache.set(key, response);
            }
            return response;
        }).finally(() => {
            if(key && this.pending.get(key) === pending) {
                this.pending.delete(key);
            }
        });
        if(key) {
            this.pending.set(key, pending);
        }
        return pending;
    }

    public static clear(fullUrl: string, request: RequestInit): void {
        const key = this.generateCacheKey(fullUrl, request);
        if(key) {
            this.pending.delete(key);
            if(this.cache.has(key)) {
                this.cache.delete(key);
            }
        }
    }

    private static generateCacheKey(fullUrl: string, request: RequestInit): string | undefined {
        const method = request.method;
        const body = request.body;
        const accept = request.headers ? new Headers(request.headers).get('Accept') ?? '' : '';
        let bodyKey: string = "";
        if(typeof body == 'string') {
            bodyKey = this.hashStringToInt(body) + '';
        }
        else if(body instanceof FormData) {
            // si file => no key
        }

        return fullUrl + "°" + method + "°" + bodyKey + "°" + accept;
    }

    private static hashStringToInt(str: string): number {
        let hash = 0x811c9dc5;
        for(let i = 0; i < str.length; i++) {
            hash ^= str.charCodeAt(i);
            hash += (hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24);
        }
        return hash >>> 0;
    }
}
