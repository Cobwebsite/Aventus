import { Converter } from "../tools/Converter.lib.avt";

export class HttpResponse {

    public get status(): number {
        return this.response.status;
    }
    public get statusText(): string {
        return this.response.statusText;
    }
    public get redirected(): boolean {
        return this.response.redirected;
    }
    public get ok(): boolean {
        return this.response.ok;
    }
    public get type(): ResponseType {
        return this.response.type;
    }
    public get url(): string {
        return this.response.url;
    }

    public get headers(): Headers {
        return this.response.headers;
    }

    private response: Response;
    public constructor(response: Response) {
        this.response = response;
    }

    private bodyFormat?: 'json' | 'blob' | 'text';
    private bodyPromise?: Promise<any>;

    private async readBody<T>(format: 'json' | 'blob' | 'text', read: () => Promise<T>): Promise<T> {
        if(this.bodyFormat && this.bodyFormat !== format) {
            throw new TypeError(`Response body already read as ${this.bodyFormat}`);
        }
        if(!this.bodyPromise) {
            this.bodyFormat = format;
            this.bodyPromise = read();
        }
        return this.bodyPromise;
    }

    public json<T = any>(): Promise<T> {
        return this.readBody('json', async () => Converter.transform<T>(await this.response.json()));
    }

    public blob(): Promise<Blob> {
        return this.readBody('blob', () => this.response.blob());
    }

    public text(): Promise<string> {
        return this.readBody('text', () => this.response.text());
    }

}
