@Storybook({
    prefix: "Ram"
})
export abstract class GenericRam<
    Index,
    Item extends IRamData,
    Request extends HttpRequest | Item = KeysObject<Item>,
    ResourceSimple extends HttpResource | Item = Item,
    ResourceDetails extends ResourceSimple = ResourceSimple,
> implements IRam {

    public static readonly info: Map<IRam, new () => any> = new Map([]);

    /**
     * The current namespace
     */
    public static Namespace: string = "";
    // public static get Namespace(): string { return ""; }
    /**
     * Get the unique type for the data. Define it as the namespace + class name
     */
    public static get Fullname(): string { return this.Namespace + "." + this.name; }


    private subscribers: RamSubscribers<RamItem<ResourceDetails, Request>> = {
        created: [],
        updated: [],
        deleted: [],
    };
    protected recordsSubscribers: Map<Index, RamSubscribers<RamItem<ResourceDetails, Request>>> = new Map();
    /**
     * List of stored item by index key
     */
    protected records: Map<Index, RamItem<ResourceDetails, Request>> = new Map();

    protected actionGuard: ActionGuard = new ActionGuard();

    @InternalProtected()
    public ramMapping: { [key: string]: { ram: IRam, asArray: boolean; }; } = {};

    protected constructor() {
        if(this.constructor == GenericRam) {
            throw "can't instanciate an abstract class";
        }

        // RamManager.check();
    }

    //#region index key
    /**
     * Define the field where the index key is location
     * Example : 'id';
     */
    public abstract defineIndexKey(): keyof ResourceDetails;

    /**
     * Get item id
     */
    @BindThis()
    public getIdWithError(item: KeysObject<ResourceDetails> | ResourceDetails): ResultRamWithError<Index> {
        let action: ResultRamWithError<Index> = new ResultRamWithError();
        let idTemp = item[this.defineIndexKey()];
        if(idTemp !== undefined) {
            action.result = idTemp;
        }
        else {
            action.errors.push(new RamError(RamErrorCode.noId, "no key found for item"));
        }
        return action;
    }
    /**
     * Get item id
     */
    @BindThis()
    public getId(item: KeysObject<ResourceDetails> | ResourceDetails): Index {
        let result = this.getIdWithError(item);
        if(result.success) {
            return result.result as Index;
        }
        throw 'no key found for item';
    }
    //#endregion	

    //#region tool
    /**
     * Prevent adding Watch element
     */
    protected removeWatch<X>(element: X): X {
        let byPass = element as any;
        if(byPass.__isProxy) {
            return byPass.getTarget();
        }
        return element;
    }

    /**
     * Add function update, onUpdate, offUpdate, delete, onDelete, offDelete
     */
    protected addRamAction<B extends (new (...args: any[]) => IRamData) & { className?: string; }>(Base: B) {
        let that = this;
        return class ActionClass extends Base implements IRamAction<ResourceDetails, Request> {
            public static override get className(): string {
                return Base.className || Base.name;
            }
            public get className(): string {
                return Base.className || Base.name;
            }
            public async update(newData: Request): Promise<this | undefined> {
                return (await that.update(newData)) as this | undefined;
            }
            public async updateWithError(newData: Request): Promise<ResultRamWithError<RamItem<this, Request>>> {
                return (await that.updateWithError(newData)) as unknown as ResultRamWithError<RamItem<this, Request>>;
            }
            public onUpdate(callback: (item: this) => void) {
                let id = that.getId(this);
                if(!that.recordsSubscribers.has(id)) {
                    that.recordsSubscribers.set(id, {
                        created: [],
                        updated: [],
                        deleted: []
                    });
                }
                let sub = that.recordsSubscribers.get(id);
                if(sub && !sub.updated.includes(callback as any)) {
                    sub.updated.push(callback as any);
                }
            }
            public offUpdate(callback: (item: this) => void) {
                let id = that.getId(this);
                let sub = that.recordsSubscribers.get(id);
                if(sub) {
                    let index = sub.updated.indexOf(callback as any);
                    if(index != -1) {
                        sub.updated.splice(index, 1);
                    }
                }
            }
            public async delete(): Promise<void> {
                let id = that.getId(this);
                await that.deleteById(id);
            }
            public async deleteWithError(): Promise<VoidRamWithError> {
                const result = new VoidRamWithError();
                let queryId = that.getIdWithError(this);
                if(!queryId.success || !queryId.result) {
                    result.errors = queryId.errors;
                    return result;
                }

                const queryDelete = await that.deleteByIdWithError(queryId.result);
                result.errors = queryDelete.errors;
                return result;
            }
            public onDelete(callback: (item: this) => void) {
                let id = that.getId(this);
                if(!that.recordsSubscribers.has(id)) {
                    that.recordsSubscribers.set(id, {
                        created: [],
                        updated: [],
                        deleted: []
                    });
                }
                let sub = that.recordsSubscribers.get(id);
                if(sub && !sub.deleted.includes(callback as any)) {
                    sub.deleted.push(callback as any);
                }
            }
            public offDelete(callback: (item: this) => void) {
                let id = that.getId(this);
                let sub = that.recordsSubscribers.get(id);
                if(sub) {
                    let index = sub.deleted.indexOf(callback as any);
                    if(index != -1) {
                        sub.deleted.splice(index, 1);
                    }
                }
            }
        };
    }

    /**
     * Define the right type base of the json received
     */
    protected abstract getTypeForData(objJson: any): new () => ResourceDetails;
    /**
     * Define all the types you ram is capable of
     */
    @InternalProtected()
    public ramForTypes(): (new () => ResourceDetails)[] {
        return [this.getTypeForData({})];
    }
    /**
     * Transform the object into the object stored inside Ram
     */
    protected getObjectForRam(objJson: any): RamItem<ResourceDetails, Request> {
        let Item = this.addRamAction(this.getTypeForData(objJson));
        let item = new Item();
        this.mergeObject(item, objJson);
        return item;
    }


