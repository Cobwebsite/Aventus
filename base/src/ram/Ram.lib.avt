import { RamError, RamErrorCode, ResultRamWithError, VoidRamWithError } from "./Error.lib.avt";
import { ResultWithError, VoidWithError } from "../tools/Error.lib.avt";
import { Json, type JsonFromOptions } from "../tools/Json.lib.avt";
import { ActionGuard } from "../tools/Mutex.lib.avt";
import type { Request as HttpRequest, Resource as HttpResource } from "../http/type.lib.avt";

@Storybook({
    prefix: "Ram"
})
export interface IRamData { }
@Storybook({
    prefix: "Ram"
})
export interface IRam {
    // ramForTypes(): (new () => any)[];
    // ramMapping: { [key: string]: { ram: IRam, asArray: boolean; }; };
    // onCreated(cb: (item: any) => void);
    // offCreated(cb: (item: any) => void);
    // onUpdated(cb: (item: any) => void);
    // offUpdated(cb: (item: any) => void);
    // onDeleted(cb: (item: any) => void);
    // offDeleted(cb: (item: any) => void);
    // getId(item: any): any;
}

@Storybook({
    prefix: "Ram"
})
export type KeysObject<Item> = { [Key in keyof Item]?: any; };
@Storybook({
    prefix: "Ram"
})
export interface IRamAction<Resource, Request> {
    update(newData: Request): Promise<this | undefined>;
    updateWithError(newData: Request): Promise<ResultRamWithError<this>>;
    onUpdate(callback: (item: this) => void): void;
    offUpdate(callback: (item: this) => void): void;
    delete(): Promise<void>;
    deleteWithError(): Promise<VoidRamWithError>;
    onDelete(callback: (item: this) => void): void;
    offDelete(callback: (item: this) => void): void;
}
@Storybook({
    prefix: "Ram"
})
export type RamItem<Resource extends IRamData, Request> = Resource & IRamAction<Resource, Request>;
@Storybook({
    prefix: "Ram"
})
interface RamSubscribers<Item> {
    created: ((item: Item) => void)[];
    updated: ((item: Item) => void)[];
    deleted: ((item: Item) => void)[];
}

