    /**
     * Add element inside Ram or update it. The instance inside the ram is unique and ll never be replaced
     */
    protected async addOrUpdateData(item: ResourceDetails): Promise<ResultWithError<{ kind: 'created' | 'updated', value: RamItem<ResourceDetails, Request>; }>> {
        const resultTemp: ResultWithError<{ kind: 'created' | 'updated', value: RamItem<ResourceDetails, Request>; }> = new ResultWithError();
        try {
            const id = resultTemp.extract(() => this.getIdWithError(item));
            if(id === undefined) return resultTemp;

            if(this.records.has(id)) {
                let uniqueRecord = this.records.get(id)!;
                await resultTemp.runAsync(() => this.beforeRecordSet(uniqueRecord));
                // this.unlinkRamItem(uniqueRecord);
                if(resultTemp.success)
                    this.mergeObject(uniqueRecord, item);
                await resultTemp.runAsync(() => this.afterRecordSet(uniqueRecord));
                // this.linkRamItem(uniqueRecord);
                resultTemp.result = {
                    kind: 'updated',
                    value: this.records.get(id)!
                };
            }
            else {
                let realObject = this.getObjectForRam(item);
                await resultTemp.runAsync(() => this.beforeRecordSet(realObject));
                this.records.set(id, realObject);
                await resultTemp.runAsync(() => this.afterRecordSet(realObject));
                // this.linkRamItem(realObject);
                resultTemp.result = {
                    kind: 'created',
                    value: this.records.get(id)!
                };
            }
        }
        catch(e) {
            resultTemp.errors.push(new RamError(RamErrorCode.unknow, e));
        }
        return resultTemp;
    }

    /**
     * Merge object and create real instance of class
     */
    protected mergeObject(item: ResourceDetails | undefined, objJson: KeysObject<ResourceDetails> | ResourceDetails, options?: JsonFromOptions) {
        if(!item) {
            return;
        }
        if(!options) {
            options = {
                replaceUndefined: true
            };
        }
        Json.classFromJson(item, objJson, options);
    }

    /**
     * Create or update the item
     */
    @BindThis()
    public async save(item: Request, ...args: any[]): Promise<RamItem<ResourceDetails, Request> | undefined> {
        let action = await this.saveWithError(item, ...args);
        if(action.success) {
            return action.result;
        }
        return undefined;
    }
    /**
     * Create or update the item
     */
    @BindThis()
    public async saveWithError(item: Request, ...args: any[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        let action: ResultRamWithError<RamItem<ResourceDetails, Request>> = new ResultRamWithError();
        const id = action.extract(() => this.getIdWithError(item));
        if(id !== undefined) {
            if(id) {
                return this.updateWithError(item, ...args);
            }
            else {
                return this.createWithError(item, ...args);
            }
        }
        return action;
    }
    //#endregion

    //#region records operation
    protected async beforeRecordSet(item: RamItem<ResourceDetails, Request>): Promise<VoidWithError> {
        return new VoidWithError();
    }
    protected async afterRecordSet(item: RamItem<ResourceDetails, Request>): Promise<VoidWithError> {
        return new VoidWithError();
    }
    protected async beforeRecordDelete(item: RamItem<ResourceDetails, Request>): Promise<VoidWithError> {
        return new VoidWithError();
    }
    protected async afterRecordDelete(item: RamItem<ResourceDetails, Request>): Promise<VoidWithError> {
        return new VoidWithError();
    }
    //#endregion

    //#region listener
    protected publish(type: 'created' | 'updated' | 'deleted', data: RamItem<ResourceDetails, Request>) {
        let callbacks = [...this.subscribers[type]];
        for(let callback of callbacks) {
            callback(data);
        }
        let sub = this.recordsSubscribers.get(this.getId(data));
        if(sub) {
            let localCallbacks = [...sub[type]];
            for(let localCallback of localCallbacks) {
                localCallback(data);
            }
        }
    }
    private subscribe(type: 'created' | 'updated' | 'deleted', cb: (item: RamItem<ResourceDetails, Request>) => void) {
        if(!this.subscribers[type].includes(cb)) {
            this.subscribers[type].push(cb);
        }
    }
    private unsubscribe(type: 'created' | 'updated' | 'deleted', cb: (item: RamItem<ResourceDetails, Request>) => void) {
        let index = this.subscribers[type].indexOf(cb);
        if(index != -1) {
            this.subscribers[type].splice(index, 1);
        }
    }
    /**
    * Add a callback that ll be triggered when a new item is stored
    */
    @BindThis()
    public onCreated(cb: (item: RamItem<ResourceDetails, Request>) => void) {
        this.subscribe('created', cb);
    }
    /**
     * Remove a created callback
     */
    @BindThis()
    public offCreated(cb: (item: RamItem<ResourceDetails, Request>) => void) {
        this.unsubscribe('created', cb);
    }
    /**
     * Add a callback that ll be triggered when an item is updated
     */
    @BindThis()
    public onUpdated(cb: (item: RamItem<ResourceDetails, Request>) => void) {
        this.subscribe('updated', cb);
    }
    /**
     * Remove an updated callback
     */
    @BindThis()
    public offUpdated(cb: (item: RamItem<ResourceDetails, Request>) => void) {
        this.unsubscribe('updated', cb);
    }
    /**
     * Add a callback that ll be triggered when an item is deleted
     */
    @BindThis()
    public onDeleted(cb: (item: RamItem<ResourceDetails, Request>) => void) {
        this.subscribe('deleted', cb);
    }
    /**
     * Remove an deleted callback
     */
    @BindThis()
    public offDeleted(cb: (item: RamItem<ResourceDetails, Request>) => void) {
        this.unsubscribe('deleted', cb);
    }

    //#endregion

    //#region get
    /**
     * Get an item by id if exist (alias for getById)
     */
    @BindThis()
    public async get(id: Index): Promise<RamItem<ResourceDetails, Request> | undefined> {
        return await this.getById(id);
    };
    /**
     * Get an item by id if exist (alias for getById)
     */
    @BindThis()
    public async getWithError(id: Index): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        return await this.getByIdWithError(id);
    };
    /**
     * Get an item by id if exist
     */
    @BindThis()
    public async getById(id: Index): Promise<RamItem<ResourceDetails, Request> | undefined> {
        let action = await this.getByIdWithError(id);
        if(action.success) {
            return action.result;
        }
        return undefined;
    }

    /**
     * Get an item by id if exist
     */
    @BindThis()
    public async getByIdWithError(id: Index): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        return this.actionGuard.run(['getByIdWithError', id], async () => {
            let action: ResultRamWithError<RamItem<ResourceDetails, Request>> = new ResultRamWithError();
            await action.runAsync(() => this.beforeGetById(id));
            if(action.success) {
                if(this.records.has(id)) {
                    const item = this.records.get(id)!;
                    action.result = item;
                    await action.runAsync(() => this.afterGetById(item));
                }
                else {
                    action.errors.push(new RamError(RamErrorCode.noItemInsideRam, "can't find the item " + id + " inside ram"));
                }
            }
            return action;
        });
    }
    /**
     * Trigger before getting an item by id
     */
    protected async beforeGetById(id: Index): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after getting an item by id
     */
    protected async afterGetById(result: RamItem<ResourceDetails, Request>): Promise<VoidWithError> {
        return new VoidWithError();
    };

    /**
     * Get multiple items by ids
     */
    @BindThis()
    public async getByIds(ids: Index[]): Promise<RamItem<ResourceDetails, Request>[]> {
        let result = await this.getByIdsWithError(ids);
        if(result.success) {
            return result.result ?? [];
        }
        return [];
    };
    /**
     * Get multiple items by ids
     */
    @BindThis()
    public async getByIdsWithError(ids: Index[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>[]>> {
        return this.actionGuard.run(['getByIdsWithError', ids], async () => {
            const action: ResultRamWithError<RamItem<ResourceDetails, Request>[]> = new ResultRamWithError();
            await action.runAsync(() => this.beforeGetByIds(ids));
            if(action.success) {
                const result: RamItem<ResourceDetails, Request>[] = [];
                for(let id of ids) {
                    let rec = this.records.get(id);
                    if(rec) {
                        result.push(rec);
                    }
                    else {
                        action.errors.push(new RamError(RamErrorCode.noItemInsideRam, "can't find the item " + id + " inside ram"));
                    }
                }
                if(action.success) {
                    action.result = result;
                    await action.runAsync(() => this.afterGetByIds(result));
                }
            }
            return action;
        });
    };
    /**
     * Trigger before getting a list of items by id
     */
    protected async beforeGetByIds(ids: Index[]): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after getting a list of items by id
     */
    protected async afterGetByIds(result: RamItem<ResourceDetails, Request>[]): Promise<VoidWithError> {
        return new VoidWithError();
    };

    /**
     * Get all elements inside the Ram
     */
    @BindThis()
    public async getAll(): Promise<RamItem<ResourceSimple, Request>[]> {
        let result = await this.getAllWithError();
        if(result.success) {
            return result.result ?? [];
        }
        return [];
    }
    /**
     * Get all elements inside the Ram
     */
    @BindThis()
    public async getAllWithError(): Promise<ResultRamWithError<RamItem<ResourceSimple, Request>[]>> {
        return this.actionGuard.run(['getAllWithError'], async () => {
            let action: ResultRamWithError<RamItem<ResourceSimple, Request>[]> = new ResultRamWithError();
            await action.runAsync(() => this.beforeGetAll());
            if(action.success) {
                const result = Object.values(this.records);
                action.result = result;
                await action.runAsync(() => this.afterGetAll(result));
            }
            return action;
        });
    }


    /**
     * Trigger before getting all items inside Ram
     */
    protected async beforeGetAll(): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after getting all items inside Ram
     */
    protected async afterGetAll(result: RamItem<ResourceSimple, Request>[]): Promise<VoidWithError> {
        return new VoidWithError();
    };



    /**
     * Get all elements inside the Ram 
     */
    @BindThis()
    public async getList(): Promise<RamItem<ResourceSimple, Request>[]> {
        return await this.getAll();
    };
    /**
     * Get all elements inside the Ram 
     */
    @BindThis()
    public async getListWithError(): Promise<ResultRamWithError<RamItem<ResourceSimple, Request>[]>> {
        return await this.getAllWithError();
    }

    /**
     * Get all elements inside the Ram 
     */
    @BindThis()
    public async getRecords(): Promise<Map<Index, RamItem<ResourceSimple, Request>>> {
        const result = await this.getRecordsWithError();
        if(result.success) {
            return result.result ?? new Map();
        }
        return new Map();
    };
    /**
     * Get all elements inside the Ram 
     */
    @BindThis()
    public async getRecordsWithError(): Promise<ResultRamWithError<Map<Index, RamItem<ResourceSimple, Request>>>> {
        let action: ResultRamWithError<Map<Index, RamItem<ResourceSimple, Request>>> = new ResultRamWithError();
        action.runAsync(() => this.getAllWithError());
        if(action.success) {
            action.result = this.records;
        }
        return action;
    }
    //#endregion

    //#region create
    /**
     * Create a list of items inside ram
     */
    @BindThis()
    public async createList(list: Request[]): Promise<RamItem<ResourceDetails, Request>[]> {
        let result = await this.createListWithError(list);
        return result.result ?? [];
    }
    /**
     * Create a list of items inside ram
     */
    @BindThis()
    public async createListWithError(list: Request[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>[]>> {
        list = this.removeWatch(list);
        return this.actionGuard.run(['_createList'], async () => {
            let action: ResultRamWithError<RamItem<ResourceDetails, Request>[]> = new ResultRamWithError();
            await action.runAsync(() => this.beforeCreateList(list));
            for(let item of list) {
                await action.runAsync(() => this.beforeCreateItem(item, true));
            }
            const resources = await action.extractAsync(() => this.transformCreateRequestListToItem(list));
            if(!resources) return action;

            const result: RamItem<ResourceDetails, Request>[] = [];
            for(let item of resources) {
                const resultItem = await action.extractAsync(() => this.addOrUpdateData(item));
                if(!resultItem) return action;
                await action.runAsync(() => this.afterCreateItem(resultItem.value, true));

                if(action.success) {
                    result.push(resultItem.value);
                    this.publish('created', resultItem.value);
                }
            }

            action.result = result;

            await action.runAsync(() => this.afterCreateList(result));

            return action;
        });
    }


    /**
     * Create an item inside ram
     */
    @BindThis()
    public async create(item: Request, ...args: any[]): Promise<RamItem<ResourceDetails, Request> | undefined> {
        let action = await this.createWithError(item, args);
        if(action.success) {
            return action.result;
        }
        return undefined;
    }
    /**
     * Create an item inside ram
     */
    @BindThis()
    public async createWithError(item: Request, ...args: any[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        item = this.removeWatch(item);
        return this.actionGuard.run(['_create', item], async () => {
            let action: ResultRamWithError<RamItem<ResourceDetails, Request>> = new ResultRamWithError();
            await action.runAsync(() => this.beforeCreateItem(item, false));
            const resource = await action.extractAsync(() => this.transformCreateRequestToItem(item));
            if(!resource) return action;

            const id = await action.extract(() => this.getIdWithError(resource));
            if(id !== undefined) {
                const resultTemp = await action.extractAsync(() => this.addOrUpdateData(resource));
                if(!resultTemp) return action;

                await action.runAsync(() => this.afterCreateItem(resultTemp.value, false));

                if(action.success) {
                    action.result = resultTemp.value;
                    this.publish('created', resultTemp.value);
                }
            }

            return action;
        });
    }

    /**
     * Transform request to resource item
     */
    protected abstract transformCreateRequestToItem(item: Request): Promise<ResultWithError<ResourceDetails>>;

    /**
     * Transform request to resource item
     */
    protected abstract transformCreateRequestListToItem(list: Request[]): Promise<ResultWithError<ResourceDetails[]>>;

    /**
     * Trigger before creating a list of items
     */
    protected async beforeCreateList(list: Request[]): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger before creating an item
     */
    protected async beforeCreateItem(item: Request, fromList: boolean): Promise<VoidWithError> {
        return new VoidWithError();
    };

    /**
     * Trigger after creating an item
     */
    protected async afterCreateItem(result: RamItem<ResourceDetails, Request>, fromList: boolean): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after creating a list of items
     */
    protected async afterCreateList(result: RamItem<ResourceDetails, Request>[]): Promise<VoidWithError> {
        return new VoidWithError();
    };

    //#endregion

    //#region update
    /**
     * Update a list of items inside ram
     */
    @BindThis()
    public async updateList(list: Request[]): Promise<RamItem<ResourceDetails, Request>[]> {
        let result = await this.updateListWithError(list);
        return result.result ?? [];
    };
    /**
     * Update a list of items inside ram
     */
    @BindThis()
    public async updateListWithError(list: Request[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>[]>> {
        list = this.removeWatch(list);
        return this.actionGuard.run(['_updateList'], async () => {
            let action: ResultRamWithError<RamItem<ResourceDetails, Request>[]> = new ResultRamWithError();
            await action.runAsync(() => this.beforeUpdateList(list));
            for(let item of list) {
                await action.runAsync(() => this.beforeUpdateItem(item, true));
            }

            const resources = await action.extractAsync(() => this.transformUpdateRequestListToItem(list));
            if(!resources) return action;

            const result: RamItem<ResourceDetails, Request>[] = [];
            for(let item of resources) {
                const resultItem = await action.extractAsync(() => this.addOrUpdateData(item));
                if(!resultItem) return action;
                await action.runAsync(() => this.afterUpdateItem(resultItem.value, true));

                if(action.success) {
                    result.push(resultItem.value);
                    this.publish('created', resultItem.value);
                }
            }

            action.result = result;

            await action.runAsync(() => this.afterUpdateList(result));

            return action;
        });
    };

    /**
     * Update an item inside ram
     */
    @BindThis()
    public async update(item: Request, ...args: any[]): Promise<RamItem<ResourceDetails, Request> | undefined> {
        let action = await this.updateWithError(item, args);
        if(action.success) {
            return action.result;
        }
        return undefined;
    }
    /**
     * Update an item inside ram
     */
    @BindThis()
    public async updateWithError(item: Request, ...args: any[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        item = this.removeWatch(item);
        return this.actionGuard.run(['_update', item], async () => {
            let action: ResultRamWithError<RamItem<ResourceDetails, Request>> = new ResultRamWithError();
            const id = await action.extract(() => this.getIdWithError(item));
            if(id === undefined) return action;

            if(this.records.has(id)) {
                const currentEl = this.records.get(id) as any;
                if(currentEl == item) {
                    console.warn("You are updating the same item. You should clone the object first to avoid weird effect");
                }
                await action.runAsync(() => this.beforeUpdateItem(item, false));
                const resource = await action.extractAsync(() => this.transformUpdateRequestToItem(item));
                if(!resource) return action;
                const resultTemp = await action.extractAsync(() => this.addOrUpdateData(resource));
                if(!resultTemp) return action;

                await action.runAsync(() => this.afterUpdateItem(resultTemp.value, false));

                if(action.success) {
                    action.result = resultTemp.value;
                    this.publish('updated', resultTemp.value);
                }
            }
            else {
                action.errors.push(new RamError(RamErrorCode.noItemInsideRam, "can't update the item " + id + " because it wasn't found inside ram"));
            }


            return action;
        });
    }

    /**
     * Transform request to resource item
     */
    protected abstract transformUpdateRequestToItem(item: Request): Promise<ResultWithError<ResourceDetails>>;

    /**
     * Transform request to resource item
     */
    protected abstract transformUpdateRequestListToItem(list: Request[]): Promise<ResultWithError<ResourceDetails[]>>;

    /**
     * Trigger before updating a list of items
     */
    protected async beforeUpdateList(list: Request[]): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
    * Trigger before updating an item
    */
    protected async beforeUpdateItem(item: Request, fromList: boolean): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after updating an item
     */
    protected async afterUpdateItem(result: RamItem<ResourceDetails, Request>, fromList: boolean): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after updating a list of items
     */
    protected async afterUpdateList(result: RamItem<ResourceDetails, Request>[]): Promise<VoidWithError> {
        return new VoidWithError();
    };


    //#endregion

    //#region delete
    /**
     * Delete a list of items inside ram
     */
    @BindThis()
    public async deleteList(list: ResourceDetails[]): Promise<RamItem<ResourceDetails, Request>[]> {
        let result = await this.deleteListWithError(list);
        return result.result ?? [];
    };
    /**
     * Delete a list of items inside ram
     */
    @BindThis()
    public async deleteListWithError(list: ResourceDetails[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>[]>> {
        list = this.removeWatch(list);
        let action: ResultRamWithError<RamItem<ResourceDetails, Request>[]> = new ResultRamWithError();
        action.result = [];
        await action.runAsync(() => this.beforeDeleteList(list));

        const result: RamItem<ResourceDetails, Request>[] = [];
        for(let item of list) {
            const resultItem = await action.extractAsync(() => this._delete(item, true));
            if(!resultItem) return action;
            result.push(resultItem);
        }
        if(action.success) {
            action.result = result;
            await action.runAsync(() => this.afterDeleteList(result));
        }
        return action;
    };
    /**
     * Delete an item inside ram
     */
    @BindThis()
    public async delete(item: ResourceDetails, ...args: any[]): Promise<RamItem<ResourceDetails, Request> | undefined> {
        let action = await this.deleteWithError(item, args);
        if(action.success) {
            return action.result;
        }
        return undefined;
    };
    /**
    * Delete an item inside ram
    */
    @BindThis()
    public async deleteWithError(item: ResourceDetails, ...args: any[]): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        return await this._delete(item, false);
    };
    /**
     * Delete an item by id inside ram
     */
    @BindThis()
    public async deleteById(id: Index): Promise<RamItem<ResourceDetails, Request> | undefined> {
        let action = await this.deleteByIdWithError(id);
        if(action.success) {
            return action.result;
        }
        return undefined;
    }
    /**
    * Delete an item by id inside ram
    */
    @BindThis()
    public async deleteByIdWithError(id: Index): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        let item = this.records.get(id);
        if(item) {
            return await this._delete(item, false);
        }
        let result: ResultRamWithError<RamItem<ResourceDetails, Request>> = new ResultRamWithError();
        result.errors.push(new RamError(RamErrorCode.noItemInsideRam, "can't delete the item " + id + " because it wasn't found inside ram"));
        return result;
    }
    private async _delete(item: ResourceDetails, fromList: boolean): Promise<ResultRamWithError<RamItem<ResourceDetails, Request>>> {
        item = this.removeWatch(item);
        return this.actionGuard.run(['_delete', item], async () => {
            let action: ResultRamWithError<RamItem<ResourceDetails, Request>> = new ResultRamWithError();
            const id = action.extract(() => this.getIdWithError(item));
            if(id === undefined) return action;

            let oldItem = this.records.get(id);
            if(oldItem) {
                await action.runAsync(() => this.beforeDeleteItem(oldItem, fromList));
                await action.runAsync(() => this.beforeRecordDelete(oldItem));
                this.records.delete(id);
                await action.runAsync(() => this.afterRecordDelete(oldItem));
                await action.runAsync(() => this.afterDeleteItem(oldItem, fromList));
                if(action.success) {
                    action.result = oldItem;
                    this.publish('deleted', oldItem);
                }
                this.recordsSubscribers.delete(id);
            }
            else {
                action.errors.push(new RamError(RamErrorCode.noItemInsideRam, "can't delete the item " + id + " because it wasn't found inside ram"));
            }

            return action;
        });
    }
    /**
     * Trigger before deleting a list of items
     */
    protected async beforeDeleteList(list: ResourceDetails[]): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger before deleting an item
     */
    protected async beforeDeleteItem(item: ResourceDetails, fromList: boolean): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after deleting an item
     */
    protected async afterDeleteItem(result: RamItem<ResourceDetails, Request>, fromList: boolean): Promise<VoidWithError> {
        return new VoidWithError();
    };
    /**
     * Trigger after deleting a list of items
     */
    protected async afterDeleteList(result: RamItem<ResourceDetails, Request>[]): Promise<VoidWithError> {
        return new VoidWithError();
    }
    //#endregion

}

/**
 * Default Ram with number as Index
 */
@Storybook({
    prefix: "Ram"
})
export abstract class Ram<
    Item extends IRamData,
    Request extends HttpRequest | Item = Item,
    ResourceSimple extends HttpResource | Item = Item,
    ResourceDetails extends ResourceSimple = ResourceSimple,
> extends GenericRam<number, Item, Request, ResourceSimple, ResourceDetails> {

}
