import { ActionGuard, Callback, Instance, Watcher, WebComponent } from "Aventus@Main:Aventus.package.avt";


@Dependencies([{ type: WebComponent, strong: true }])
export class I18nClass {
    private currentLocale: string = "en-GB";
    private availableLocales: string[] = [];
    private fallback: string = "en-GB";
    protected langMutex: ActionGuard = new ActionGuard();

    public readonly onLocaleChange: Callback<(newLocale: string, oldLocale: string) => void> = new Callback();

    private watcher: { [key: string]: any; } = Watcher.get({
        locale: {}
    });
    protected get locale(): any {
        return this.watcher['locale'];
    }
    protected set locale(value: any) {
        this.watcher['locale'] = value;
    }
    protected files: string[] = [];
    protected waitingFiles: string[] = [];

    protected __translations: { [lang: string]: {}; } = {};

    public async setLocale(lang: string): Promise<void> {
        if(!this.availableLocales.includes(lang)) {
            throw `The locale ${lang} can't be found inside the locales : ${this.availableLocales.join(", ")}`;
        }
        let oldLocale = this.currentLocale;
        this.currentLocale = lang;
        localStorage.setItem("AventusI18nLang", lang);
        if(!this.__translations[lang]) {
            await this.langMutex.run([""], async () => {
                const proms: Promise<string>[] = [];
                for(let file of this.files) {
                    let uri = file.replace(/\$locale/g, lang);
                    proms.push(Aventus.ResourceLoader.load(uri));
                }
                const results = await Promise.all(proms);
                let items = {};
                for(let result of results) {
                    try {
                        this.merge(items, JSON.parse(result));
                    } catch(e) {
                        console.error(e);
                    }
                }
                this.__translations[lang] = items;
                // this.waitingFiles = [];
            });
        }
        this.locale = this.__translations[lang];
        this.onLocaleChange.trigger(oldLocale, lang);
    }
    public getLocale(): string {
        return this.currentLocale;
    }

    private merge(from: { [key: string]: any; }, to: { [key: string]: any; }) {
        for(let key in to) {
            let val = to[key];
            if(typeof val == 'object') {
                let temp = {};
                this.merge(temp, val);
                from[key] = temp;
            }
            else {
                from[key] = val;
            }
        }
    }

    public registerLocales(locales: string[]) {
        for(let locale of locales) {
            if(!this.availableLocales.includes(locale)) {
                this.availableLocales.push(locale);
            }
        }
    }
    public registerFallback(fallback: string) {
        if(!this.availableLocales.includes(fallback)) {
            throw `The fallback ${fallback} can't be found inside the locales : ${this.availableLocales.join(", ")}`;
        }

        this.fallback = fallback;



        // determine language
        const userLang = localStorage.getItem("AventusI18nLang") ?? navigator.language;

        if(this.availableLocales.includes(userLang)) {
            this.currentLocale = userLang;
            return;
        }

        let prefix = userLang.split("-")[0];
        if(this.availableLocales.includes(prefix)) {
            this.currentLocale = prefix;
            return;
        }

        this.currentLocale = this.fallback;
        this.onLocaleChange.trigger(this.currentLocale, this.currentLocale);
    }

    private registerFileTimeout: number = 0;
    public registerFile(file: string, options?: { delay?: boolean, load?: boolean; }): void {
        if(this.files.includes(file)) return;

        this.waitingFiles.push(file);

        options = options ?? {};

        if(options.load === false) return;

        if(options.delay === false) {
            this.loadFileDelay();
            return;
        }

        clearTimeout(this.registerFileTimeout);
        this.registerFileTimeout = setTimeout(() => {
            this.loadFileDelay();
        }, 200);
    }

    protected async loadFileDelay(): Promise<void> {
        await this.langMutex.run([""], async () => {
            const lang = this.currentLocale;
            const proms: Promise<string>[] = [];
            for(let file of this.waitingFiles) {
                let uri = file.replace(/\$locale/g, lang).toLowerCase();
                proms.push(Aventus.ResourceLoader.load(uri));
            }
            const results = await Promise.all(proms);
            let items = this.locale;
            for(let result of results) {
                try {
                    this.merge(items, JSON.parse(result));
                } catch(e) {
                    console.error(e);
                }
            }
            for(let file of this.waitingFiles) {
                this.files.push(file);
            }
            this.__translations[lang] = items;
            this.waitingFiles = [];
        });
    }

    public init(): Promise<void> {
        return this.loadFileDelay();
    }


    public hasKey(key: string): boolean {
        return this.locale[key] !== undefined;
    }

    @BindThis()
    public t(key: string, params: { [key: string]: string; } = {}): string {
        let translation = this.locale[key];
        if(translation === undefined) {
            translation = key;
        }
        for(let key in params) {
            let regex = new RegExp("(?<!\\\\)\\{ *" + key + " *\\}", "g");
            translation = translation.replace(regex, params[key]);
        }
        return translation;
    }
}

export const I18n: I18nClass = Instance.get(I18nClass);