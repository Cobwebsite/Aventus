
/**
 * A sophisticated image display component that handles responsive sizing, different content modes (stretch, contains, cover), and asynchronous loading of both raster images and SVG files. It ensures images are displayed correctly within their container, even with dynamic resizing.
 */
export class Img extends Aventus.WebComponent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props
    /**
     * If true, the image will be loaded and cached as a base64 string.
     */
    @Attribute()
    public cache!: boolean;

    /**
     * The URL of the image to display. Changes to this property trigger onSrcChanged().
     */
    @Property((target: Img) => {
        target.onSrcChanged();
    })
    public src?: string;

    /**
     * Determines how the image content should fit within its container. - 'stretch': Stretches the image to fill the container. - 'contains': Scales the image to fit within the container while preserving its aspect ratio. - 'cover': Scales the image to cover the entire container while preserving its aspect ratio.
     */
    @Property((target: Img) => {
        if(target.src != "") {
            target.calculateSize();
        }
    })
    public mode: 'stretch' | 'contains' | 'cover' = "contains";
    //#endregion


    //#region variables

    /**
     * Reference to the HTMLImageElement within the component's template, used for raster images.
     */
    @ViewElement()
    protected imgEl!: HTMLImageElement;
    /**
     * Reference to the HTMLDivElement within the component's template, used for SVG content.
     */
    @ViewElement()
    protected svgEl!: HTMLDivElement;

    /**
     * A flag to prevent redundant size calculations during calculateSize.
     */
    private isCalculing?: boolean;
    /**
     * The maximum number of retry attempts for calculateSize if initial dimensions are zero.
     */
    private maxCalculateSize: number = 10;
    /**
     * Stores the aspect ratio (width / height) of the image.
     */
    private ratio: number = 1;
    /**
     * An instance of Aventus.ResizeObserver to detect changes in the component's dimensions.
     */
    private resizeObserver?: Aventus.ResizeObserver;
    //#endregion


    //#region states

    //#endregion


    //#region constructor

    //#endregion


    //#region methods
    /**
     * Calculates and applies the correct width, height, transform (for centering), and opacity styles to the image or SVG element based on the mode and available space. Includes retry logic if the element's dimensions are initially zero.
     */
    private calculateSize(attempt = 0) {
        if(this.isCalculing || !this.imgEl || !this.svgEl) {
            return;
        }
        if(this.src == "") {
            return;
        }
        this.isCalculing = true;
        if(getComputedStyle(this).display == 'none') {
            return;
        }
        if(attempt == this.maxCalculateSize) {
            this.isCalculing = false;
            return;
        }

        let element: HTMLImageElement | HTMLDivElement = this.imgEl;
        if(this.src?.endsWith(".svg")) {
            element = this.svgEl;
        }
        this.style.width = '';
        this.style.height = '';
        element.style.width = '';
        element.style.height = '';

        if(element.offsetWidth == 0 && element.offsetHeight == 0) {
            setTimeout(() => {
                this.isCalculing = false;
                this.calculateSize(attempt + 1);
            }, 100);
            return;
        }

        let style = getComputedStyle(this);
        let addedY = Number(style.paddingTop.replace("px", "")) + Number(style.paddingBottom.replace("px", "")) + Number(style.borderTopWidth.replace("px", "")) + Number(style.borderBottomWidth.replace("px", ""));
        let addedX = Number(style.paddingLeft.replace("px", "")) + Number(style.paddingRight.replace("px", "")) + Number(style.borderLeftWidth.replace("px", "")) + Number(style.borderRightWidth.replace("px", ""));
        let availableHeight = this.offsetHeight - addedY;
        let availableWidth = this.offsetWidth - addedX;

        let sameWidth = (element.offsetWidth == availableWidth);
        let sameHeight = (element.offsetHeight == availableHeight);
        this.ratio = element.offsetWidth / element.offsetHeight;
        if(sameWidth && !sameHeight) {
            // height is set
            element.style.width = (availableHeight * this.ratio) + 'px';
            element.style.height = availableHeight + 'px';
        }
        else if(!sameWidth && sameHeight) {
            // width is set
            element.style.width = availableWidth + 'px';
            element.style.height = (availableWidth / this.ratio) + 'px';
        }
        else if(!sameWidth && !sameHeight) {
            if(this.mode == "stretch") {
                element.style.width = '100%';
                element.style.height = '100%';
            }
            else if(this.mode == "contains") {
                // suppose this height is max
                let newWidth = (availableHeight * this.ratio);
                if(newWidth <= availableWidth) {
                    //we can apply this value
                    element.style.width = newWidth + 'px';
                    element.style.height = availableHeight + 'px';
                }
                else {
                    element.style.width = availableWidth + 'px';
                    element.style.height = (availableWidth / this.ratio) + 'px';
                }

            }
            else if(this.mode == "cover") {
                // suppose this height is min
                let newWidth = (availableHeight * this.ratio);
                if(newWidth >= availableWidth) {
                    //we can apply this value
                    element.style.width = newWidth + 'px';
                    element.style.height = availableHeight + 'px';
                }
                else {
                    element.style.width = availableWidth + 'px';
                    element.style.height = (availableWidth / this.ratio) + 'px';
                }
            }
        }

        //center img
        let diffTop = (this.offsetHeight - element.offsetHeight - addedY) / 2;
        let diffLeft = (this.offsetWidth - element.offsetWidth - addedX) / 2;
        element.style.transform = "translate(" + diffLeft + "px, " + diffTop + "px)";
        element.style.opacity = '1';
        this.isCalculing = false;
    }
    /**
     * Asynchronously loads the image or SVG content based on the src property. If an SVG, it fetches and injects the content. If cache is true, it loads raster images as base64. Calls calculateSize() after loading.
     */
    private async onSrcChanged() {
        if(!this.src || !this.svgEl || !this.imgEl) {
            return;
        }
        if(this.src.endsWith(".svg")) {
            let svgContent = await Aventus.ResourceLoader.load(this.src);
            this.svgEl.innerHTML = svgContent;
            this.calculateSize();
        }
        else if(this.cache) {
            let base64 = await Aventus.ResourceLoader.load({
                url: this.src,
                type: 'img'
            });
            this.imgEl.setAttribute("src", base64);
            this.calculateSize();
        }
        else {
            this.imgEl.setAttribute("src", this.src);
            this.calculateSize();
        }
    }

    /**
     * Lifecycle hook called before the component is destroyed. Disconnects the resizeObserver to prevent memory leaks.
     */
    protected override postDestruction(): void {
        this.resizeObserver?.disconnect();
        this.resizeObserver = undefined;
    }

    /**
     * Lifecycle hook called after the component is created. Initializes and observes the component with Aventus.ResizeObserver to react to dimension changes and trigger calculateSize().
     */
    protected override postCreation(): void {
        this.resizeObserver = new Aventus.ResizeObserver({
            fps: 10,
            callback: () => {
                this.calculateSize();
            }
        });
        this.resizeObserver.observe(this);
    }
    //#endregion

}
