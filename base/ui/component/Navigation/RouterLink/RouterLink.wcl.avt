import { RouterStateManager } from "../../../lib/RouterStateManager.lib.avt";

namespace Navigation {
    /**
     * Provides declarative navigation within an Aventus application. It functions similarly to an HTML tag but integrates with the application's router for client-side routing, applying an "active" class based on the current route/state.
     */
    @Deprecated()
    export class RouterLink extends Aventus.WebComponent implements Aventus.DefaultComponent {

        //#region static

        //#endregion


        //#region props
        /**
         * Specifies the internal route state path to navigate to.
         */
        @Attribute()
        public state?: string;

        /**
         * If set, defines a custom pattern to determine when the link should be considered "active", overriding the default behavior of matching state.
         */
        @Attribute()
        public active_state?: string;
        //#endregion


        //#region variables

        //#endregion


        //#region constructor

        //#endregion


        //#region methods
        /**
         * Callback triggered when the active state of the link changes.
         */
        public onActiveChange: Aventus.Callback<(isActive: boolean) => void> = new Aventus.Callback();
        /**
         * Sets up a PressManager to handle click events on the link. When clicked, it normalizes the state path (handling relative paths) and uses Aventus.State.activate to navigate via the RouterStateManager.
         */
        protected addClickEvent() {
            new Aventus.PressManager({
                element: this,
                onPress: () => {
                    if(this.state === undefined) return;

                    let state = this.state;
                    if(this.state.startsWith(".")) {
                        state = Aventus.Instance.get(RouterStateManager).getState()?.name ?? "";
                        if(!state.endsWith("/")) {
                            state += "/";
                        }
                        state += this.state;
                        state = Aventus.Uri.normalize(state);
                    }
                    Aventus.State.activate(state, Aventus.Instance.get(RouterStateManager));
                }
            });
        }
        /**
         * Subscribes to the RouterStateManager to listen for state changes. When the current state matches state (or active_state), it adds the "active" class to the component and triggers onActiveChange. When inactive, it removes the class.
         */
        protected registerActiveStateListener() {

            let activeState = this.state;
            if(this.active_state) {
                activeState = this.active_state;
            }
            if(activeState === undefined) return;
            
            Aventus.Instance.get(RouterStateManager).subscribe(activeState, {
                active: () => {
                    this.classList.add("active");
                    this.onActiveChange.trigger(true);
                },
                inactive: () => {
                    this.classList.remove("active");
                    this.onActiveChange.trigger(false);
                }
            });
        }
        /**
         * Utility method to prevent the default behavior of an event.
         */
        protected prevent(e: Event) {
            e.preventDefault();
        }
        /**
         * Lifecycle hook called after the component is created. Registers the active listener and adds the click event handler.
         */
        protected override postCreation(): void {
            this.registerActiveStateListener();
            this.addClickEvent();
        }
        //#endregion
    }
}