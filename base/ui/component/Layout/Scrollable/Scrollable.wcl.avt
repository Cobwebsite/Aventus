import { DragAndDrop } from "Aventus@Main:Aventus.package.avt";

namespace Layout {
    export class Scrollable extends Aventus.WebComponent implements Aventus.DefaultComponent {

        //#region static

        //#endregion


        //#region props
        /**
         * Sets the zoom level to apply to the container's content. Changes trigger a recalculation of dimensions and transformations.
         */
        @Property((target: Scrollable) => {
            target.changeZoom();
        })
        public zoom: number = 1;
        /**
         * Reflects whether the vertical scrollbar is currently visible.
         */
        @Attribute()
        private y_scroll_visible!: boolean;

        /**
         * Reflects whether the horizontal scrollbar is currently visible.
         */
        @Attribute()
        private x_scroll_visible!: boolean;

        /**
         * Determines if the custom scrollbars will be floating over the content or occupy space.
         */
        @Attribute()
        public floating_scroll!: boolean;

        /**
         * Determines if horizontal scrolling is allowed.
         */
        @Attribute()
        public x_scroll!: boolean;

        /**
         * Determines if vertical scrolling is allowed.
         */
        @Attribute()
        public y_scroll: boolean = true;

        /**
         * If true, the custom scrollers will hide when not in use and reappear on interaction.
         */
        @Attribute()
        public auto_hide!: boolean;

        /**
        * If true, disables all user interaction (scrolling, zooming, dragging) with the component.
        */
        @Attribute()
        public disable!: boolean;

        /**
        * Internal property to prevent user text selection during drag interactions.
        */
        @Attribute()
        private no_user_select!: boolean;

        /**
        * If true, allows scrolling by dragging with the mouse.
        */
        @Attribute()
        public mouse_drag!: boolean;

        /**
         * If true, sets the internal content containers to display: flex and flex-direction: column, useful for allowing content to take up remaining space.
         */
        @Attribute()
        public flex!: boolean;
        //#endregion


        //#region variables
        /**
         * Reference to the internal DIV element that wraps the actual scrollable content.
         */
        @ViewElement()
        private contentWrapper!: HTMLDivElement;

        /**
         * Reference to the internal DIV element that handles zooming transformations.
         */
        @ViewElement()
        private contentZoom!: HTMLDivElement;

        /**
         * Reference to the main container element of the Scrollable component.
         */
        @ViewElement()
        private mainContainer!: HTMLDivElement;

        /**
         * Reference to an internal DIV element used for adjusting content area based on scrollbar presence.
         */
        @ViewElement()
        private contentHidder!: HTMLDivElement;

        /**
         * Reference to the container element for the vertical scrollbar.
         */
        @ViewElement()
        private verticalScrollerContainer!: HTMLDivElement;

        /**
         * Reference to the draggable element representing the vertical scrollbar thumb.
         */
        @ViewElement()
        private verticalScroller!: HTMLDivElement;

        /**
         * Reference to the container element for the horizontal scrollbar.
         */
        @ViewElement()
        private horizontalScrollerContainer!: HTMLDivElement;

        /**
         * Reference to the draggable element representing the horizontal scrollbar thumb.
         */
        @ViewElement()
        private horizontalScroller!: HTMLDivElement;


        /**
         * An instance of Aventus.ResizeObserver to detect size changes of the component and its content.
         */
        private observer?: Aventus.ResizeObserver;
        /**
         * Stores the actual dimensions (offsetWidth, offsetHeight) of the content wrapper.
         */
        private contentWrapperSize: { x: number, y: number; } = { x: 0, y: 0 };

        /**
        * Stores the current visible dimensions (width, height) of the content area.
        */
        private display: { x: number, y: number; } = { x: 0, y: 0 };

        /**
         * Stores the calculated margin adjustments due to scrollbar presence.
         */
        private margin: { x: number, y: number; } = {
            x: 0,
            y: 0
        };

        /**
         * Utility object to access horizontal/vertical scroller elements.
         */
        private scroller: {
            x: () => HTMLDivElement,
            y: () => HTMLDivElement,
        } = {
                x: () => {
                    if(!this.horizontalScroller) {
                        throw 'can\'t find the horizontalScroller';
                    }
                    return this.horizontalScroller;
                },
                y: () => {
                    if(!this.verticalScroller) {
                        throw 'can\'t find the verticalScroller';
                    }
                    return this.verticalScroller;
                }
            };

        /**
         * Stores the maximum scrollable distance (width, height) in pixels.
         */
        private max: { x: number, y: number; } = {
            x: 0,
            y: 0
        };

        /**
         * Stores setTimeout IDs for auto-hiding scrollbars.
         */
        private hideDelay: { x: number, y: number; } = { x: 0, y: 0 };

        /**
         * Getter for the current horizontal scroll position.
         */
        public get x(): number {
            return this.contentHidder.scrollLeft;
        }
        /**
         * Getter for the current vertical scroll position.
         */
        public get y(): number {
            return this.contentHidder.scrollTop;
        }

        /**
         * Getter for the maximum horizontal scroll position.
         */
        public get xMax(): number {
            return this.max.x;
        }
        /**
         * Getter for the maximum vertical scroll position.
         */
        public get yMax(): number {
            return this.max.y;
        }

        private scrollTimeout: number = 0;

        @Signal((target: Scrollable) => {
            if(target.allowResizeObserver) {
                target.dimensionRefreshed();
            }
        })
        public allowResizeObserver: boolean = true;

        //#endregion


        //#region constructor

        //#endregion

        //#region events

        /**
         * Callback triggered whenever the scroll position changes.
         */
        public onScrollChange: Aventus.Callback<(x: number, y: number) => void> = new Aventus.Callback();
        /**
         * Callback triggered whenever the zoom level changes.
         */
        public onZoomChange: Aventus.Callback<(zoom: number) => void> = new Aventus.Callback();

        //#endregion

        //#region methods
        /**
         * Calculates the actual offsetWidth and offsetHeight of the content area, accounting for zoom, and determines if dimensions have changed.
         */
        private calculateRealSize(): boolean {
            if(!this.contentZoom || !this.mainContainer || !this.contentWrapper) {
                return false;
            }
            const currentOffsetWidth = this.contentZoom.offsetWidth;
            const currentOffsetHeight = this.contentZoom.offsetHeight;

            let hasChanged = false;

            if(this.contentWrapper.offsetWidth != this.contentWrapperSize.x || this.contentWrapper.offsetHeight != this.contentWrapperSize.y)
                hasChanged = true;

            this.contentWrapperSize.x = this.contentWrapper.offsetWidth;
            this.contentWrapperSize.y = this.contentWrapper.offsetHeight;

            if(this.zoom < 1) {
                // scale the container for zoom
                this.contentZoom.style.width = this.div(this.mainContainer.offsetWidth, this.zoom) + 'px';
                this.contentZoom.style.height = this.div(this.mainContainer.offsetHeight, this.zoom) + 'px';
                this.contentZoom.style.maxHeight = this.div(this.mainContainer.offsetHeight, this.zoom) + 'px';
                if(currentOffsetHeight != this.display.y || currentOffsetWidth != this.display.x)
                    hasChanged = true;

                this.display.y = currentOffsetHeight;
                this.display.x = currentOffsetWidth;
            }
            else {
                const newX = this.div(currentOffsetWidth, this.zoom);
                const newY = this.div(currentOffsetHeight, this.zoom);
                if(newY != this.display.y || newX != this.display.x)
                    hasChanged = true;

                this.display.y = newY;
                this.display.x = newX;

                this.contentZoom.style.width = '';
                this.contentZoom.style.height = '';
                this.contentZoom.style.maxHeight = '';
            }
            return hasChanged;
        }

        /**
         * Calculates and adjusts the position of the scrollbar containers based on direction.
         */
        private calculatePositionScrollerContainer(direction: 'x' | 'y') {
            if(direction == 'y') {
                this.calculatePositionScrollerContainerY();
            }
            else {
                this.calculatePositionScrollerContainerX();
            }
        }
        /**
         * Calculates and adjusts the position of the vertical scrollbar container.
         */
        private calculatePositionScrollerContainerY() {
            const leftMissing = this.mainContainer.offsetWidth - this.verticalScrollerContainer.offsetLeft;
            if(leftMissing > 0 && this.y_scroll_visible && !this.floating_scroll) {
                this.contentHidder.style.width = 'calc(100% - ' + leftMissing + 'px)';
                this.contentHidder.style.marginRight = leftMissing + 'px';
                this.margin.x = leftMissing;

            }
            else {
                this.contentHidder.style.width = '';
                this.contentHidder.style.marginRight = '';
                this.margin.x = 0;
            }
        }

        /**
         * Calculates and adjusts the position of the horizontal scrollbar container.
         */
        private calculatePositionScrollerContainerX() {
            const topMissing = this.mainContainer.offsetHeight - this.horizontalScrollerContainer.offsetTop;
            if(topMissing > 0 && this.x_scroll_visible && !this.floating_scroll) {
                this.contentHidder.style.height = 'calc(100% - ' + topMissing + 'px)';
                this.contentHidder.style.marginBottom = topMissing + 'px';
                this.margin.y = topMissing;
            }
            else {
                this.contentHidder.style.height = '';
                this.contentHidder.style.marginBottom = '';
                this.margin.y = 0;
            }
        }

        /**
         * Calculates and sets the size of the custom scrollbar thumb for a given direction.
         */
        private calculateSizeScroller(direction: 'x' | 'y') {
            const scrollerSize = (this.div((this.display[direction] - this.margin[direction]), this.contentWrapperSize[direction]) * 100);
            if(direction == "y") {
                this.scroller[direction]().style.height = scrollerSize + '%';
            }
            else {
                this.scroller[direction]().style.width = scrollerSize + '%';
            }
            let maxScrollContent = this.contentWrapperSize[direction] - this.display[direction];
            if(maxScrollContent < 0) {
                maxScrollContent = 0;
            }
            this.max[direction] = maxScrollContent + this.margin[direction];
        }

        /**
         * Applies the zoom transformation to contentZoom and triggers a dimension refresh.
         */
        private changeZoom() {
            this.contentZoom.style.transform = 'scale(' + this.zoom + ')';
            this.dimensionRefreshed(true);
        }

        /**
         * Recalculates and updates all scroll-related dimensions and positions. Manages scrollbar visibility and ensures correct layout after size changes.
         */
        private dimensionRefreshed(force: boolean = false) {
            if(!this.calculateRealSize() && !force) {
                return;
            }
            if(this.contentWrapperSize.y - this.display.y > 0) {
                if(!this.y_scroll_visible) {
                    this.y_scroll_visible = true;
                    this.calculatePositionScrollerContainer('y');
                }
                this.calculateSizeScroller('y');
            }
            else if(this.y_scroll_visible) {
                this.y_scroll_visible = false;
                this.calculatePositionScrollerContainer('y');
                this.calculateSizeScroller('y');
            }

            if(this.contentWrapperSize.x - this.display.x > 0) {
                if(!this.x_scroll_visible) {
                    this.x_scroll_visible = true;
                    this.calculatePositionScrollerContainer('x');
                }
                this.calculateSizeScroller('x');
            }
            else if(this.x_scroll_visible) {
                this.x_scroll_visible = false;
                this.calculatePositionScrollerContainer('x');
                this.calculateSizeScroller('x');
            }


        }
        /**
         * Creates and returns an Aventus.ResizeObserver instance configured to call dimensionRefreshed() on resize events.
         */
        private createResizeObserver() {
            let inProgress = false;
            return new Aventus.ResizeObserver({
                callback: entries => {
                    if(inProgress) {
                        return;
                    }
                    if(!this.allowResizeObserver) return;
                    inProgress = true;
                    this.dimensionRefreshed();
                    inProgress = false;
                },
                fps: 30
            });

        }
        /**
         * Initializes and attaches the ResizeObserver to monitor the component and its contentWrapper for size changes.
         */
        private addResizeObserver() {
            if(this.observer == undefined) {
                this.observer = this.createResizeObserver();
            }
            this.observer.observe(this.contentWrapper);
            this.observer.observe(this);
        }

        protected onScrollEvent(e: Event) {
            this.calculatePosition();
            window.dispatchEvent(new CustomEvent("scroll", { detail: { source: this } }));
        }

        /**
         * 
         */
        protected calculatePosition() {
            if(!this.hasAttribute('is-scrolling')) {
                this.setAttribute('is-scrolling', '');
            }
            const container = this.contentHidder;

            // Calcul de la position verticale
            if(this.y_scroll_visible) {
                const scrollTop = container.scrollTop;
                const scrollHeight = container.scrollHeight;
                const clientHeight = container.clientHeight;

                // Ratio de déplacement (0 à 1)
                const scrollPercentY = scrollTop / (scrollHeight - clientHeight);

                // Taille disponible dans le conteneur de la scrollbar
                const trackHeight = this.verticalScrollerContainer.offsetHeight;
                const thumbHeight = this.verticalScroller.offsetHeight;
                const maxMoveY = trackHeight - thumbHeight;

                // Application de la transformation
                const translateY = scrollPercentY * maxMoveY;
                this.verticalScroller.style.transform = `translateY(${translateY}px)`;

                if(this.auto_hide) {
                    this.verticalScrollerContainer.classList.remove("hide");
                    clearTimeout(this.hideDelay['y']);
                    this.hideDelay['y'] = setTimeout(() => {
                        this.verticalScrollerContainer.classList.add("hide");
                    }, 1000);
                }
            }

            // Calcul de la position horizontale
            if(this.x_scroll_visible) {
                const scrollLeft = container.scrollLeft;
                const scrollWidth = container.scrollWidth;
                const clientWidth = container.clientWidth;

                const scrollPercentX = scrollLeft / (scrollWidth - clientWidth);

                const trackWidth = this.horizontalScrollerContainer.offsetWidth;
                const thumbWidth = this.horizontalScroller.offsetWidth;
                const maxMoveX = trackWidth - thumbWidth;

                const translateX = scrollPercentX * maxMoveX;
                this.horizontalScroller.style.transform = `translateX(${translateX}px)`;

                if(this.auto_hide) {
                    this.horizontalScrollerContainer.classList.remove("hide");
                    clearTimeout(this.hideDelay['x']);
                    this.hideDelay['x'] = setTimeout(() => {
                        this.horizontalScrollerContainer.classList.add("hide");
                    }, 1000);
                }
            }

            this.triggerScrollChange();

            clearTimeout(this.scrollTimeout);
            this.scrollTimeout = setTimeout(() => {
                this.removeAttribute('is-scrolling');
            }, 150);
        }

        /**
         * Triggers the onScrollChange callback with the current x and y scroll positions.
         */
        private triggerScrollChange() {
            this.onScrollChange.trigger(this.x, this.y);
        }


        /**
         * Helper function for safe division, returning nb1 if nb2 is zero or falsy.
         */
        private div(nb1: number, nb2: number) {
            if(!nb2) return nb1;
            return nb1 / nb2;
        }

        private applyAutoHide() {
            if(this.auto_hide) {
                this.horizontalScrollerContainer.classList.remove("hide");
                clearTimeout(this.hideDelay['x']);
                this.hideDelay['x'] = setTimeout(() => {
                    this.horizontalScrollerContainer.classList.add("hide");
                }, 1000);

                this.verticalScrollerContainer.classList.remove("hide");
                clearTimeout(this.hideDelay['y']);
                this.hideDelay['y'] = setTimeout(() => {
                    this.verticalScrollerContainer.classList.add("hide");
                }, 1000);
            }
        }

        private addScrollDrag(direction: 'x' | 'y') {
            let scroller = this.scroller[direction]();
            let startScroll = 0;

            const drag = new DragAndDrop({
                element: scroller,
                applyDrag: false,
                usePercent: true,
                offsetDrag: 0,
                isDragEnable: () => !this.disable,
                onStart: (e) => {
                    this.no_user_select = true;
                    scroller.classList.add("active");
                    if(direction === 'y') {
                        startScroll = this.contentHidder.scrollTop;
                    } else {
                        startScroll = this.contentHidder.scrollLeft;
                    }
                },
                onMove: (e, position) => {
                    const scrollDelta = (position[direction] / 100) * this.contentWrapperSize[direction];

                    if(direction === 'y') {
                        this.contentHidder.scrollTop = startScroll + scrollDelta;
                    } else {
                        this.contentHidder.scrollLeft = startScroll + scrollDelta;
                    }
                },
                onStop: () => {
                    this.no_user_select = false;
                    scroller.classList.remove("active");
                }
            });
        }

        public scrollX(x: number) {
            this.contentHidder.scrollLeft = x;
            this.calculatePositionScrollerContainer('x');
        }
        public scrollY(y: number) {
            this.contentHidder.scrollTop = y;
            this.calculatePositionScrollerContainer('y');
        }

        private addAction() {
            if(this.mouse_drag) {
                let startScrollX = 0;
                let startScrollY = 0;
                let posX = 0;
                let posY = 0;

                this.addEventListener("pointerdown", (e) => {
                    if(!this.x_scroll_visible && !this.y_scroll_visible) {
                        return;
                    }
                    startScrollX = this.contentHidder.scrollLeft;
                    startScrollY = this.contentHidder.scrollTop;
                    posX = e.pageX;
                    posY = e.pageY;
                    this.no_user_select = true;
                });
                this.addEventListener("pointermove", (e) => {
                    if(this.x_scroll_visible) {
                        this.contentHidder.scrollLeft = startScrollX + (posX - e.pageX);
                    }
                    if(this.y_scroll_visible) {
                        this.contentHidder.scrollTop = startScrollY + (posY - e.pageY);
                    }
                });
                this.addEventListener("pointerup", (e) => {
                    this.no_user_select = false;
                });
                this.addEventListener("pointercancel", (e) => {
                    this.no_user_select = false;
                });

                // new PressManager({
                //     element: this,
                //     offsetDrag: 0,
                //     onDragStart: (e) => {
                //         if(!this.x_scroll_visible && !this.y_scroll_visible) {
                //             return false;
                //         }
                //         if(e.event instanceof PointerEvent) {
                //             startScrollX = this.contentHidder.scrollLeft;
                //             startScrollY = this.contentHidder.scrollTop;
                //             posX = e.event.pageX;
                //             posY = e.event.pageY;
                //             this.no_user_select = true;
                //             return true;
                //         }
                //         return false;
                //     },
                //     onDrag: (e) => {
                //         if(e.event instanceof PointerEvent) {

                //         }
                //     },
                //     onDragEnd: (e) => {
                //         this.no_user_select = false;
                //     }
                // });
            }
            this.addScrollDrag('x');
            this.addScrollDrag('y');
        }

        protected focusElementByAnchor() {
            const id = window.location.hash.substring(1);
            if(id) {
                const elements = this.getElementsInSlot();
                for(let element of elements) {
                    const target = element.id == id ? element : element.querySelector("#" + id);
                    if(target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                }
            }
        }

        protected addHashWatch() {
            window.addEventListener("hashchange", () => {
                if(this.offsetHeight > 0 && this.offsetWidth > 0) {
                    this.focusElementByAnchor();
                }
            });
            this.addEventListener("hashcheck", () => {
                if(this.offsetHeight > 0 && this.offsetWidth > 0) {
                    this.focusElementByAnchor();
                }
            });
        }

        /**
         * Lifecycle hook called after the component is created. Initializes dimensions, sets up resize observers, and adds interaction actions.
         */
        protected override postCreation(): void {
            this.dimensionRefreshed();
            this.addResizeObserver();
            this.applyAutoHide();
            this.addAction();
            this.focusElementByAnchor();
            this.addHashWatch();
        }

        //#endregion

    }
}