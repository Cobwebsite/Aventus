/**
 * Provides a simple web component to toggle the visibility of content, often with a collapsing/expanding animation driven by CSS.
 */
export class Collapse extends Aventus.WebComponent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props
    /**
     * Controls the collapsed/expanded state of the component. When true, the content is visible; when false, it's hidden.
     */
    @Attribute()
    public open!: boolean;
    /**
     * When true, disables the collapsing/expanding animation.
     */
    @Attribute()
    public no_animation!: boolean;

    @Attribute()
    public horizontal!: boolean;

    @Attribute()
    public reverse!: boolean;
    //#endregion


    //#region variables

    //#endregion


    //#region constructor

    //#endregion


    //#region methods

    /**
     * Dispatches a new event when a CSS transition ends, allowing parent components or external listeners to react.
     */
    protected transitionEnd(e: Event) {
        let cst = e.constructor as new (name: string, e: Event) => Event;
        const new_e = new cst(e.type, e);
        this.dispatchEvent(new_e);
    }
    /**
     * Toggles the open property, switching the collapse component's state between open and closed.
     */
    protected toggleOpen() {
        this.open = !this.open;
    }
    //#endregion

}