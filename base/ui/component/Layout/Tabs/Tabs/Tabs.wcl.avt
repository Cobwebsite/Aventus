import type { Constructor } from "../../../Form/Form/FormType.lib.avt";
import { Tab } from "../Tab/Tab.wcl.avt";
import { TabHeader } from "../TabHeader/TabHeader.wcl.avt";

namespace Layout.Tabs {
    /**
     * Abstract web component that serves as a container for a tabbed interface. It manages the loading, rendering, and activation of Tab content components and their corresponding TabHeader components.
     */
    export abstract class Tabs<T extends Tab, U extends TabHeader<T>> extends Aventus.WebComponent implements Aventus.DefaultComponent {

        //#region static

        //#endregion


        //#region props

        //#endregion


        //#region variables

        /**
         * Reference to the HTML element where the TabHeader components will be rendered.
         */
        @ViewElement()
        protected headerEl!: HTMLDivElement;
        /**
         * Reference to the HTML element where the Tab content components will be rendered.
         */
        @ViewElement()
        protected bodyEl!: HTMLDivElement;

        /**
         * Stores a reference to the currently active TabHeader component.
         */
        protected activeHeader?: TabHeader<T>;
        /**
         * An object that maps tab identifiers (from Tab.identifier()) to their corresponding Tab content components.
         */
        protected tabs: { [label: string]: T; } = {};
        //#endregion


        //#region constructor

        //#endregion


        //#region methods
        /**
         * Asynchronously discovers child Tab components within its slot. For each Tab, it instantiates a TabHeader (defined by defineTabHeader()), initializes it, and appends it to headerEl. It also determines the initial active tab.
         */
        protected async loadTabs() {
            // let elements = this.elements;
            let elements = this.getElementsInSlot();

            let first: U | null = null;
            for(let element of elements) {
                if(element instanceof Tab) {
                    element.style.display = 'none';
                    this.tabs[element.identifier()] = element as T;

                    let header = new (this.defineTabHeader())();
                    this.headerEl.appendChild(header);
                    await header.init(element as T, this);

                    if(first == null) {
                        first = header;
                    }
                    else if(!first.tab.selected && element.selected) {
                        first = header;
                    }
                    element.loaded = true;
                }
            }

            if(first) {
                this.setActive(first);
            }
            this.shadowRoot.querySelector<HTMLSlotElement>("slot")?.addEventListener("slotchange", this.reloadFromSlot);
        }

        @BindThis()
        protected async reloadFromSlot() {
            let elements = this.getElementsInSlot();
            let actualTabs = Object.keys(this.tabs);
            let first: U | null = null;
            let orders: string[] = [];
            for(let element of elements) {
                if(element instanceof Tab) {
                    element.style.display = 'none';
                    const el = element as T;
                    const identifier = element.identifier();
                    const indexActual = actualTabs.indexOf(identifier);
                    orders.push(identifier);
                    if(indexActual == -1) {
                        this.tabs[identifier] = el;
                        let header = new (this.defineTabHeader())();
                        this.headerEl.appendChild(header);
                        await header.init(el, this);
                        if(first == null) {
                            first = header;
                        }
                    }
                    else {
                        actualTabs.splice(indexActual, 1);
                        if(first == null) {
                            first = this.tabs[identifier].tabHeader as U;
                        }
                    }
                    element.loaded = true;
                }
            }

            for(let missing of actualTabs) {
                this.tabs[missing].tabHeader?.remove();
                delete this.tabs[missing];
            }

            let hasSelected = false;
            for(let identifier in this.tabs) {
                if(this.tabs[identifier].selected) {
                    if(!hasSelected) {
                        hasSelected = true;
                        first = this.tabs[identifier].tabHeader as U;
                    }
                    else {
                        this.tabs[identifier].selected = false;
                        this.tabs[identifier].tabHeader!.active = false;
                        this.tabs[identifier].style.display = 'none';
                        this.tabs[identifier].selected = false;
                    }
                }
            }

            if(first != null) {
                this.setActive(first);
            }

            for(let i = 0, j = 0; i < orders.length; i++, j++) {
                const shouldBe = this.tabs[orders[i]].tabHeader;
                if(!shouldBe) continue;

                while(j < this.headerEl.children.length && !(this.headerEl.children[j] instanceof TabHeader)) {
                    j++;
                }
                if(shouldBe != this.headerEl.children[j]) {
                    this.headerEl.appendChild(shouldBe);
                }
            }
        }

        /**
         * Sets a specific tab as active. It can accept a TabHeader instance, an index (number), or a tab identifier (string). It deactivates the previously active tab and activates the new one, managing their active and selected attributes and display styles.
         */
        public setActive(tabHeader: TabHeader<T> | number | string): boolean {
            if(typeof tabHeader == 'number') {
                if(this.headerEl.children.length > tabHeader) {
                    const header = this.headerEl.children[tabHeader];
                    if(header instanceof TabHeader) {
                        return this.setActive(header);
                    }
                }
                return false;
            }
            else if(typeof tabHeader == 'string') {
                const header = this.tabs[tabHeader].tabHeader as TabHeader<T>;
                if(header)
                    return this.setActive(header);
                return false;
            }

            if(this.activeHeader) {
                this.activeHeader.active = false;
                this.activeHeader.tab.selected = false;
                this.activeHeader.tab.style.display = 'none';
            }

            this.activeHeader = tabHeader;
            this.activeHeader.active = true;
            this.activeHeader.tab.style.display = '';
            this.activeHeader.tab.selected = true;
            return true;
        }

        /**
         * Abstract method that concrete Tabs implementations must provide. It should return the constructor for the specific TabHeader component to be used.
         */
        protected abstract defineTabHeader(): Constructor<U>;

        /**
         * Lifecycle hook called after the component is created. Overrides the base method to load the tabs when the component is instantiated.
         */
        protected override postCreation(): void {
            super.postCreation();
            this.loadTabs();
        }
        //#endregion

    }
}