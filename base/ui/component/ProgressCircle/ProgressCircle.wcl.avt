/**
 * Renders a circular progress indicator using SVG. It allows customization of the progress value and the thickness of the circle stroke.
 */
export class ProgressCircle extends Aventus.WebComponent implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props
    /**
     * Represents the progress percentage (0-100). Changes to this property trigger the render() method.
     */
    @Property((target: ProgressCircle) => {
        target.render();
    })
    public value: number = 40;

    /**
     * Defines the thickness of the progress circle's stroke. Changes to this property trigger the render() method.
     */
    @Property((target: ProgressCircle) => {
        target.render();
    })
    public stroke_width: number = 6;
    //#endregion


    //#region variables
    /**
     * Reference to the HTML element within the component's template where the SVG will be rendered.
     */
    @ViewElement()
    protected containerEl!: HTMLDivElement;

    /**
     * Reference to the dynamically created SVG element.
     */
    private svg?: SVGSVGElement;
    /**
     * Reference to the SVG circle element representing the background of the progress circle.
     */
    private backCircle?: SVGCircleElement;
    /**
     * Reference to the SVG circle element representing the filled progress of the circle.
     */
    private percentCircle?: SVGCircleElement;
    //#endregion


    //#region constructor

    //#endregion


    //#region methods
    /**
     * Ensures the input value is within the valid range of 0 to 100.
     */
    private getLimitedValue(input: number | undefined) {
        if(input === undefined) {
            return 0;
        } else if(input > 100) {
            return 100;
        } else {
            return input;
        }
    }

    /**
     * The core rendering logic for the progress circle. It calculates the necessary SVG attributes (radius, circumference, stroke-dashoffset) based on the component's dimensions, value, and stroke_width. It then creates or updates the SVG and its circle elements, appending them to containerEl.
     */
    protected render() {
        let min = Math.min(this.offsetWidth, this.offsetHeight);
        if(min == 0) return;
        const value = this.getLimitedValue(this.value);
        const radius = min / 2;
        const strokeWidth = this.stroke_width;
        const normalizedRadius = radius - strokeWidth / 2;
        const circumference = normalizedRadius * 2 * Math.PI;
        const strokeDashoffset = (value / 100) * circumference;
        const offset = circumference - strokeDashoffset;
        let appendSvg = false;
        if(!this.svg) {
            appendSvg = true;
            this.svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        }

        this.svg.setAttribute("width", radius * 2 + "");
        this.svg.setAttribute("height", radius * 2 + "");
        this.svg.setAttribute("viewBox", "0 0 " + (radius * 2) + " " + (radius * 2));

        if(!this.backCircle) {
            this.backCircle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            this.svg.appendChild(this.backCircle);
        }
        this.backCircle.classList.add("back-circle");
        this.backCircle.setAttribute("r", normalizedRadius + "");
        this.backCircle.setAttribute("cx", radius + "");
        this.backCircle.setAttribute("cy", radius + "");
        this.backCircle.setAttribute("stroke-width", strokeWidth + "");
        this.backCircle.setAttribute("stroke-linecap", "round");


        if(!this.percentCircle) {
            this.percentCircle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            this.svg.appendChild(this.percentCircle);
        }
        this.percentCircle.classList.add("percent-circle");
        this.percentCircle.setAttribute("r", normalizedRadius + "");
        this.percentCircle.setAttribute("cx", radius + "");
        this.percentCircle.setAttribute("cy", radius + "");
        this.percentCircle.setAttribute("stroke-width", strokeWidth + "");
        this.percentCircle.setAttribute("stroke-dasharray", circumference + " " + circumference);
        this.percentCircle.setAttribute("stroke-dashoffset", offset + "");
        this.percentCircle.setAttribute("stroke-linecap", "round");

        if(appendSvg) {
            this.containerEl.appendChild(this.svg);
        }
    }
    /**
     * Lifecycle hook called after the component is created. It attaches a ResizeObserver to the component to re-render the progress circle whenever the component's size changes, ensuring responsiveness. Also performs an initial render.
     */
    protected override postCreation(): void {
        new Aventus.ResizeObserver(() => {
            this.render();
        }).observe(this);
        this.render();
    }
    //#endregion

}