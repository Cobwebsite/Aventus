import { GenericError, HttpRoute, isClass, ResultWithError, VoidWithError, type Asyncable } from "Aventus@Main:Aventus.package.avt";
import type { Constructor, ExtractError, FormHandlerConfig, FormPart, FormPartValidate, FormSchema, FormValidate, FormValidateResult, IForm, IFormElement, InternalForm, InternalFormPart, OmitClass, SubmitFunction, WithError } from "./FormType.lib.avt";
import { Validator } from "./Validator.lib.avt";
import { Form } from "./Form.wcl.avt";

namespace Form {

    /**
     * Provides core logic for handling forms, including data management, validation, and submission.
     */
    export class FormHandler<T, R = any> {

        /**
         * Global configuration settings for FormHandler instances.
         */
        @Internal()
        public static _globalConfig?: FormHandlerConfig<any>;

        /**
         * List of constructors for elements that implement IForm.
         */
        @Internal()
        public static _IFormElements: Constructor<IForm, true>[] = [Form];


        /**
         * Internal watcher instance for tracking form data changes.
         */
        private __watcher: any;

        /**
         * The data item associated with the form.
         */
        public get item(): T {
            return this.__watcher.item;
        }

        /**
         * Sets the data item associated with the form.
         */
        public set item(item: T) {
            this.__watcher.item = item;
        }

        /**
         * Provides access to the internal form parts for the schema.
         */
        public get parts(): InternalForm<T> {
            return this.__watcher.form;
        }

        /**
         * Internal map of registered form elements by field name.
         */
        private _elements: { [K in keyof T]?: IFormElement[]; } = {};

        /**
         * Provides access to the registered form elements.
         */
        public get elements(): { [K in keyof T]?: IFormElement[]; } {
            return { ...this._elements };
        }
        /**
         * Global validation function for the form.
         */
        private _globalValidation?: FormValidate;
        /**
         * Indicates if validation should occur on input change.
         */
        private _validateOnChange: boolean = false;
        /**
         * Fallback handler for validation errors not linked to a specific input.
         */
        private _onValidateFallback?: (errors: { [K in keyof T]?: string[]; }) => Asyncable<void>;
        /**
         * Fallback handler for server-side errors not linked to a specific input.
         */
        private _onServerFallback?: (errors: Aventus.GenericError[]) => Asyncable<void>;
        /**
         * Function to extract field-specific error messages from a generic error.
         */
        private _extractor: (error: Aventus.GenericError) => { fieldName: string, messages: string[]; }[];
        /**
         * Callback executed upon successful form submission.
         */
        private _onSuccess?: (result: ExtractError<R>) => Asyncable<void>;
        /**
         * The internal function responsible for submitting the form.
         */
        private _submitFct?: SubmitFunction<T, R>;
        /**
         * Checks if a submission function is defined for the form.
         */
        public get hasSubmitFct(): boolean {
            return this._submitFct != undefined;
        }

        /**
         * The default values for the form fields.
         */
        public defaultValues: T;
        /**
         * Callback triggered when an item's property changes.
         */
        public onItemChange: Aventus.Callback<(action: Aventus.WatchAction, path: string, value: any) => void> = new Aventus.Callback();


        /**
         * Initializes a new FormHandler instance with a given schema and optional configuration.
         */
        public constructor(schema: FormSchema<T>, config?: FormHandlerConfig<T, R>) {
            this.writeValidationIntoConsole = this.writeValidationIntoConsole.bind(this);
            this.writeErrorIntoConsole = this.writeErrorIntoConsole.bind(this);
            this.defaultExtractor = this.defaultExtractor.bind(this);
            this._globalValidation = config?.validate ?? FormHandler._globalConfig?.validate;
            this._validateOnChange = config?.validateOnChange ?? FormHandler._globalConfig?.validateOnChange ?? false;
            this._onValidateFallback = config?.onValidateFallback ?? FormHandler._globalConfig?.onValidateFallback ?? this.writeValidationIntoConsole;
            this._onServerFallback = config?.onServerFallback ?? FormHandler._globalConfig?.onServerFallback ?? this.writeErrorIntoConsole;
            this._extractor = config?.extractor ?? FormHandler._globalConfig?.extractor ?? this.defaultExtractor;
            this._onSuccess = config?.onSuccess ?? FormHandler._globalConfig?.onSuccess;
            this._submitFct = config?.submit;
            this.defaultValues = config?.defaultValues ?? {} as T;
            this.onWatcherChanged = this.onWatcherChanged.bind(this);
            this.__watcher = Aventus.Watcher.get({
                form: {},
                item: this.defaultValues
            }, this.onWatcherChanged);

            this.__watcher.form = this.transformForm(schema);
        }


        /**
         * Logs validation errors to the console.
         */
        private writeValidationIntoConsole(errors: { [K in keyof T]?: string[]; }) {
            for(let name in errors) {
                if(!errors[name]) continue;
                for(let error of errors[name]) {
                    console.log(name + ": " + error);
                }
            }
        }
        /**
         * Logs generic errors to the console.
         */
        private writeErrorIntoConsole(errors: Aventus.GenericError[]) {
            for(let error in errors) {
                console.log(error);
            }
        }
        /**
         * Transforms the raw form schema into an internal representation.
         */
        protected transformForm(form: FormSchema<T>): InternalForm<T> {
            const result = form as unknown as InternalForm<T>;
            const normalizePart = (part: FormSchema<T>[any]) => {
                let needTransform = true;
                if(typeof part == 'object' && !Array.isArray(part)) {
                    const keys = Object.keys(part);
                    const keysAllows: (keyof FormPart)[] = ['validate', 'validateOnChange'];
                    let isValid = true;
                    for(let i = 0; i < keys.length; i++) {
                        const allows = keysAllows as string[];
                        if(!allows.includes(keys[i])) {
                            isValid = false;
                            break;
                        }
                    }
                    if(isValid) {
                        needTransform = false;
                    }
                }

                if(needTransform) {
                    return {
                        validate: part
                    } as FormPart<T[keyof T]>;
                }
                return part as FormPart<T[keyof T]>;
            };
            const createKey = (key: any) => {
                const f = form as any;
                f[key] = normalizePart(f[key]);
                this.transformFormPart(key, f[key]);
            };
            for(let key in result) {
                createKey(key);
            }
            return result;
        }
        /**
         * Transforms a single form part within the internal form representation.
         */
        protected transformFormPart(key: keyof T, part: FormPart | undefined) {
            if(!part) return;

            const realPart = part as InternalFormPart;
            realPart.onValidation = new Aventus.Callback();
            realPart.onValueChange = new Aventus.Callback();
            realPart.handler = this;
            if(part.validate) {
                const isConstructor = (validate: FormPartValidate<T> | Constructor<Validator<any>>): validate is Constructor<Validator<any>> => {
                    return isClass(validate);
                };
                let validate: FormPartValidate<any>;
                if(Array.isArray(part.validate)) {
                    const fcts: FormPartValidate<any>[] = [];
                    for(let temp of part.validate) {
                        if(temp instanceof Validator) {
                            fcts.push(temp.validate);
                        }
                        else {
                            let resultTemp = new temp();
                            fcts.push(resultTemp.validate);
                        }
                    }
                    validate = async (value, name, globalFct) => {
                        let result: string[] = [];
                        for(let fct of fcts) {
                            const temp = await fct(value, name, globalFct);
                            if(temp === false) {
                                result.push('Le champs n\'est pas valide');
                            }
                            else if(Array.isArray(temp)) {
                                for(let error of temp) {
                                    result.push(error);
                                }
                            }
                            else if(typeof temp == 'string') {
                                result.push(temp);
                            }
                        }
                        return result.length == 0 ? undefined : result;
                    };
                }
                else if(part.validate instanceof Validator) {
                    validate = part.validate.validate;
                }
                else if(isConstructor(part.validate)) {
                    let cst = part.validate;
                    let resultTemp = new cst() as Validator<any>;
                    validate = resultTemp.validate;
                }
                else {
                    validate = part.validate;
                }
                realPart.validate = validate;
            }
            realPart.test = async () => {
                const result = await this.validate(key);
                return result;
            };
            if(!this._elements[key]) {
                this._elements[key] = [];
            }
            realPart.register = (el) => {
                if(this._elements[key] && !this._elements[key].includes(el)) {
                    this._elements[key].push(el);
                }
            };
            realPart.unregister = (el) => {
                if(!this._elements[key]) return;
                const index = this._elements[key].indexOf(el);
                if(index != -1) {
                    this._elements[key].splice(index, 1);
                }
            };
            realPart.value = {
                get: () => {
                    return Aventus.getValueFromObject(key as string, this.item);
                },
                set: (value: any) => {
                    return Aventus.setValueToObject(key as string, this.item, value);
                }
            };
            return;
        }


        /**
         * Handles changes observed by the watcher, triggering value change and validation for relevant form parts.
         */
        protected async onWatcherChanged(action: Aventus.WatchAction, path: string, value: any) {
            if(!this.parts) return;
            if(path == "item") {
                for(let key in this.parts) {
                    let formPart = this.parts[key] as InternalFormPart;
                    formPart.onValueChange.trigger();
                }
            }
            else if(path.startsWith("item.")) {
                let key = path.substring("item.".length);
                const parts = this.parts as any;
                if(parts[key]) {
                    let formPart = parts[key] as InternalFormPart;
                    formPart.onValueChange.trigger();
                    const validateOnChange = formPart.validateOnChange === undefined ? this._validateOnChange : formPart.validateOnChange;
                    if(validateOnChange) {
                        this.validate(key as keyof T);
                    }
                }
                this.onItemChange.trigger(action, key, value);
            }
        }
        private async _validate(key: keyof T | undefined): Promise<{ [key: string]: string[]; }> {
            try {
                if(!this.parts) return { "@general": ["Aucun formulaire trouvé"] };

                if(key !== undefined) {
                    let errorsForm: string[] = [];
                    if(this.parts[key]) {
                        let formPart = this.parts[key] as InternalFormPart;
                        let value = formPart.value.get();

                        const resultToError = (result: FormValidateResult) => {
                            if(result === false) {
                                errorsForm.push('Le champs n\'est pas valide');
                            }
                            else if(typeof result == 'string' && result !== "") {
                                errorsForm.push(result);
                            }
                            else if(Array.isArray(result)) {
                                errorsForm = [...errorsForm, ...result];
                            }
                        };

                        if(formPart.validate) {
                            const global = async () => {
                                if(this._globalValidation) {
                                    const result = await this._globalValidation(key as string, value);
                                    resultToError(result);
                                }
                            };

                            let result = await formPart.validate(value, key as string, global);
                            resultToError(result);


                        }
                        else if(this._globalValidation) {
                            const result = await this._globalValidation(key as string, value);
                            resultToError(result);
                        }

                        const proms = formPart.onValidation.trigger(errorsForm);
                        const errors2d = await Promise.all(proms);
                        const errors: string[] = [];
                        for(let errorsTemp of errors2d) {
                            for(let errorTemp of errorsTemp) {
                                if(!errors.includes(errorTemp)) {
                                    errors.push(errorTemp);
                                }
                            }
                        }
                        errorsForm = errors;
                    }
                    return errorsForm.length == 0 ? {} : { [key]: errorsForm };
                }

                let errors: { [key: string]: string[]; } = {};
                for(let key in this.parts) {
                    errors = { ...errors, ...await this._validate(key) };
                }

                return errors;
            } catch(e) {
                return { "@general": [e + ""] };
            }
        }

        /**
         * Validates the form or a specific field, and triggers fallback handlers for unhandled errors.
         */
        public async validate(key: keyof T): Promise<boolean>;
        public async validate(): Promise<boolean>;
        public async validate(key?: keyof T): Promise<boolean> {
            const result = await this._validate(key);
            const unhandle: { [K in keyof T]?: string[]; } = {};
            let triggerUnhandle = false;
            const els = this._elements as any;
            for(let key in result) {
                // si on ne trouve pas de formElement, on affiche un message
                if(!els[key] || els[key].length == 0) {
                    triggerUnhandle = true;
                    unhandle[key as keyof T] = result[key];
                }
            }

            if(triggerUnhandle && this._onValidateFallback) {
                this._onValidateFallback(unhandle);
            }

            return Object.keys(result).length == 0;
        }

        /**
         * Handles form submission, including validation and execution of the submission function.
         */
        public async submit<X>(query?: SubmitFunction<T, X>): Promise<WithError<X> | null> {
            const result = await this.validate();
            if(!result) {
                return null;
            }
            return this.execute(query);
        }

        protected transformToSend(item: T): T {
            return item;
        }

        /**
         * Executes the form's submission function after validation.
         */
        public async execute<X>(query?: SubmitFunction<T, X>): Promise<WithError<X>> {
            if(!query) {
                query = this._submitFct as SubmitFunction<T, X> | undefined;
            }
            if(!query) {
                const res = new VoidWithError();
                res.errors.push(new GenericError(403, "No submit function defined"));
                return res as WithError<X>;
            }
            if(typeof query == "function") {
                if(!this.item) {
                    const result = new VoidWithError();
                    result.errors.push(new GenericError(404, "No item inside the form"));
                    return result as WithError<X>;
                }
                query = query(this.transformToSend(this.item));
            }
            let queryResult = await query;

            if(queryResult.errors.length > 0) {
                queryResult.errors = this.parseErrors(queryResult);
                if(queryResult.errors.length > 0 && this._onServerFallback) {
                    this._onServerFallback(queryResult.errors);
                }
            }
            else {
                let result = queryResult instanceof ResultWithError ? queryResult.result : undefined;
                if(this._onSuccess)
                    await this._onSuccess(result);
            }
            return queryResult;
        }

        /**
         * Extracts field-specific error messages from a generic error object.
         */
        private defaultExtractor(error: Aventus.GenericError): { fieldName: string, messages: string[]; }[] {
            // v1
            if(Array.isArray(error.details)) {
                for(let detail of error.details) {
                    if(Object.hasOwn(detail, "Name")) {
                        return [{ fieldName: detail.Name, messages: [error.message] }];
                    }
                }
            }

            // v2
            const result: { fieldName: string, messages: string[]; }[] = [];
            const details = error.details;
            for(let key in details) {
                const messages = (details as any)[key];
                result.push({
                    fieldName: key,
                    messages: messages
                });
            }
            return result;
        }
        /**
         * Parse errors and display them inside the FormElement if possible
         */
        public parseErrors<X>(queryResult: WithError<X>): Aventus.GenericError[] {
            const unappliedErrors: Aventus.GenericError[] = [];
            const elements = this.elements;

            for(const error of queryResult.errors) {
                const extractions = this._extractor(error);
                let applied = false;

                for(const { fieldName, messages } of extractions) {
                    const targetElements = elements[fieldName as keyof typeof elements] as IFormElement<any>[] | undefined;
                    if(targetElements) {
                        for(let element of targetElements) {
                            element.errors.push(...messages);
                        }
                        applied = true;
                    }
                }

                if(!applied) {
                    unappliedErrors.push(error);
                }
            }
            return unappliedErrors;
        }

        /**
         * Reset form with default values
         */
        public reset() {
            this.item = this.defaultValues;
        }
    }
}