:host {
	position: absolute;
}

:host(:not([is_active])) {
	opacity: 0;
	visibility: hidden;
}


/* #region position */
:host([position="bottom left"]) {
	bottom: 0px;
	left: 0px;
}

:host([position="top left"]) {
	left: 0;
	top: 0;

}

:host([position="bottom right"]) {
	bottom: 0;
	right: 0;
}

:host([position="top right"]) {
	right: 0;
	top: 0;
}


:host([position="top"]) {
	left: 50%;
	top: 0;
	transform: translateX(-50%);
}

:host([position="bottom"]) {
	bottom: 0;
	left: 50%;
	transform: translateX(-50%);
}

/* #endregion */
