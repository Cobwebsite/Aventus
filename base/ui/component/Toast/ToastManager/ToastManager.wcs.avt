:host {
	--_toast-space-bottom: var(--toast-space-bottom, 20px);
	--_toast-space-top: var(--toast-space-top, 20px);
	--_toast-space-right: var(--toast-space-right, 10px);
	--_toast-space-left: var(--toast-space-left, 10px);
	--_toast-z-index: var(--toast-z-index, 70);
}

:host {
	bottom: var(--_toast-space-bottom);
	left: var(--_toast-space-left);
	overflow: visible;
	pointer-events: none;
	position: fixed;
	right: var(--_toast-space-right);
	top: var(--_toast-space-top);
	z-index: var(--_toast-z-index);

	::slotted(*) {
		pointer-events: auto;
	}
}
