abstract class StorableRouter<T extends Aventus.IData, U extends AventusSharp.Routes.Request.Request | T = T, R extends AventusSharp.Routes.Response.Resource | T = T, S extends AventusSharp.Routes.Response.Resource | T = R> extends Aventus.HttpRoute {

