     * Adds a new toast notification to the manager. It handles instantiation, positioning, stacking, and queuing if height limits are exceeded.
     */
    add<T extends Aventus.Toast.ToastOptions>(toast: Aventus.Toast.ToastElement<T> | T): Promise<boolean>;
