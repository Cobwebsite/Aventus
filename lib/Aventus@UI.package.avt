    private _notifyTop;
    /**
     * Helper method to add a toast to the 'bottom' position (centered), managing stacking.
     */
    private _notifyBottom;
    /**
     * Lifecycle hook called when the component is connected to the DOM. Sets this instance as the static singleton ToastManager.instance if not_main is false.
     */
    protected postConnect(): void;
    /**
     * Lifecycle hook called when the component is disconnected from the DOM. Clears the static singleton ToastManager.instance if it was this instance.
     */
    protected postDisconnect(): void;
}
}

/**
 * Utility class for executing asynchronous processes and handling errors.
 */
class Process {
    /**
