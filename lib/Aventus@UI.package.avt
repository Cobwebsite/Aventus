     */
    private hasTransition;
    /**
     * An array of callbacks to execute after a CSS transition completes.
     */
    private waitTransitionCbs;
    /**
     * Initializes a new instance of the ToastElement and sets up transition event listeners.
     */
    constructor();
    /**
     * Internal method to apply ToastOptions to the toast, then delegates to the abstract setOptions().
     */
    private _setOptions;
    /**
     * Abstract method to be implemented by subclasses to apply specific options to the toast's content or styling.
     */
    abstract setOptions(options: T): Aventus.Asyncable<void>;
    /**
     * Displays the toast notification. If the component is ready, it sets is_active to true and starts the auto-hide delay. Otherwise, it sets showAsked to true.
     */
    show(onHideCallback: (result: boolean) => void): void;
    /**
     * Initiates the auto-hide timer if delay is greater than 0.
     */
    protected startDelay(): void;
    /**
     * Hides and removes the toast, triggering the onHideCallback. This method is typically called when the toast timer expires or the user interacts with it.
     */
    protected close(): any;
    /**
     * Sets up event listeners for transitionstart and transitionend to manage the hasTransition flag and execute queued callbacks.
     */
    protected addTransition(): void;
    /**
     * Returns a Promise that resolves when the current CSS transition on the element completes. If no transition is active, it resolves immediately.
     */
    waitTransition(): Promise<void>;
    /**
     * Lifecycle hook called after the component is created. If showAsked is true, it activates the toast and starts the auto-hide delay.
     */
    protected postCreation(): void;
}
}

namespace Toast {
/**
 * Options for configuring an individual toast notification.
 */
type ToastOptions = {
    position?: Aventus.Toast.ToastPosition;
    /**
     * Use minus -1 to have an infinite timer
     */
    delay?: number;
    hasTransition?: boolean;
};
}

namespace Toast {
/**
