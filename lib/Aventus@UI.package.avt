{"av-toast-manager":{"class":"Aventus.Toast.ToastManager","name":"av-toast-manager","description":"/**\r\n * A web component that manages the display, positioning, and lifecycle of toast notifications. It provides functionality for adding new toasts, configuring default behaviors, and handling toast stacking and removal.\r\n */","attributes":{"not_main":{"name":"not_main","description":"If true, this ToastManager instance will not be set as the static singleton instance.","type":"boolean","values":[]}}},"av-progress-circle":{"class":"Aventus.ProgressCircle","name":"av-progress-circle","description":"/**\r\n * Renders a circular progress indicator using SVG. It allows customization of the progress value and the thickness of the circle stroke.\r\n */","attributes":{"value":{"name":"value","description":"Represents the progress percentage (0-100). Changes to this property trigger the render() method.","type":"number","values":[]},"stroke_width":{"name":"stroke_width","description":"Defines the thickness of the progress circle's stroke. Changes to this property trigger the render() method.","type":"number","values":[]}}},"av-router-link":{"class":"Aventus.Navigation.RouterLink","name":"av-router-link","description":"/**\r\n * Provides declarative navigation within an Aventus application. It functions similarly to an HTML tag but integrates with the application's router for client-side routing, applying an \"active\" class based on the current route/state.\r\n */","attributes":{"state":{"name":"state","description":"Specifies the internal route state path to navigate to.","type":"string","values":[]},"active_state":{"name":"active_state","description":"If set, defines a custom pattern to determine when the link should be considered \"active\", overriding the default behavior of matching state.","type":"string","values":[]},"onActiveChange":{"name":"@activeChange","description":"/**\r\n * Callback triggered when the active state of the link changes.\r\n */","values":[]}}},"av-link":{"class":"Aventus.Navigation.Link","name":"av-link","description":"/**\r\n * Provides declarative navigation within an Aventus application. It functions similarly to an HTML tag but integrates with the application's router for client-side routing, applying an \"active\" class based on the current route.\r\n */","attributes":{"to":{"name":"to","description":"Specifies the internal route path to navigate to.","type":"string","values":[]},"active_pattern":{"name":"active_pattern","description":"If set, defines a custom pattern to determine when the link should be considered \"active\", overriding the default behavior of matching to.","type":"string","values":[]},"onActiveChange":{"name":"@activeChange","description":"/**\r\n * Callback triggered when the active state of the link changes.\r\n */","values":[]}}},"av-row":{"class":"Aventus.Layout.Row","name":"av-row","description":"/**\r\n * A fundamental building block for creating flexible and responsive layouts. It acts as a container for Col components, arranging them horizontally, and is configured to work with CSS Container Queries.\r\n */","attributes":{}},"av-collapse":{"class":"Aventus.Collapse","name":"av-collapse","description":"/**\r\n * Provides a simple web component to toggle the visibility of content, often with a collapsing/expanding animation driven by CSS.\r\n */","attributes":{"open":{"name":"open","description":"Controls the collapsed/expanded state of the component. When true, the content is visible; when false, it's hidden.","type":"boolean","values":[]},"no_animation":{"name":"no_animation","description":"When true, disables the collapsing/expanding animation.","type":"boolean","values":[]},"horizontal":{"name":"horizontal","description":"","type":"boolean","values":[]},"reverse":{"name":"reverse","description":"","type":"boolean","values":[]}}},"av-col":{"class":"Aventus.Layout.Col","name":"av-col","description":"/**\r\n * A foundational element for creating responsive grid layouts. Its behavior (sizing, offsetting, centering) is driven by CSS rules applied based on its attributes.\r\n */","attributes":{"use_container":{"name":"use_container","description":"Indicates if the column should act as a container. Can be configured globally or overridden per instance.","type":"boolean","values":[]},"size":{"name":"size","description":"Defines the column's width.","type":"number","values":[]},"size_xs":{"name":"size_xs","description":"Defines the column's width for extra small screens.","type":"number","values":[]},"size_sm":{"name":"size_sm","description":"Defines the column's width for small screens.","type":"number","values":[]},"size_md":{"name":"size_md","description":"Defines the column's width for medium screens.","type":"number","values":[]},"size_lg":{"name":"size_lg","description":"Defines the column's width for large screens.","type":"number","values":[]},"size_xl":{"name":"size_xl","description":"Defines the column's width for extra large screens.","type":"number","values":[]},"offset":{"name":"offset","description":"Defines the column's left offset.","type":"number","values":[]},"offset_xs":{"name":"offset_xs","description":"Defines the column's left offset for extra small screens.","type":"number","values":[]},"offset_sm":{"name":"offset_sm","description":"Defines the column's left offset for small screens.","type":"number","values":[]},"offset_md":{"name":"offset_md","description":"Defines the column's left offset for medium screens.","type":"number","values":[]},"offset_lg":{"name":"offset_lg","description":"Defines the column's left offset for large screens.","type":"number","values":[]},"offset_xl":{"name":"offset_xl","description":"Defines the column's left offset for extra large screens.","type":"number","values":[]},"offset_right":{"name":"offset_right","description":"Defines the column's right offset.","type":"number","values":[]},"offset_right_xs":{"name":"offset_right_xs","description":"Defines the column's right offset for extra small screens.","type":"number","values":[]},"offset_right_sm":{"name":"offset_right_sm","description":"Defines the column's right offset for small screens.","type":"number","values":[]},"offset_right_md":{"name":"offset_right_md","description":"Defines the column's right offset for medium screens.","type":"number","values":[]},"offset_right_lg":{"name":"offset_right_lg","description":"Defines the column's right offset for large screens.","type":"number","values":[]},"offset_right_xl":{"name":"offset_right_xl","description":"Defines the column's right offset for extra large screens.","type":"number","values":[]},"center":{"name":"center","description":"When true, centers the content within the column.","type":"boolean","values":[]}}},"av-img":{"class":"Aventus.Img","name":"av-img","description":"/**\r\n * A sophisticated image display component that handles responsive sizing, different content modes (stretch, contains, cover), and asynchronous loading of both raster images and SVG files. It ensures images are displayed correctly within their container, even with dynamic resizing.\r\n */","attributes":{"cache":{"name":"cache","description":"If true, the image will be loaded and cached as a base64 string.","type":"boolean","values":[]},"src":{"name":"src","description":"The URL of the image to display. Changes to this property trigger onSrcChanged().","type":"string","values":[]},"mode":{"name":"mode","description":"Determines how the image content should fit within its container. - 'stretch': Stretches the image to fill the container. - 'contains': Scales the image to fit within the container while preserving its aspect ratio. - 'cover': Scales the image to cover the entire container while preserving its aspect ratio.","type":"string","values":[{"name":"stretch","description":""},{"name":"contains","description":""},{"name":"cover","description":""}]}}},"av-form":{"class":"Aventus.Form.Form","name":"av-form","description":"/**\r\n * Core web component for managing forms, including data handling, validation, and submission. It acts as an orchestrator for child form elements and can integrate with backend API routes.\r\n */","attributes":{"form":{"name":":form","description":"/**\r\n * The injected FormHandler instance managing form data, validation, and submission logic.\r\n */","values":[]},"request":{"name":":request","description":"/**\r\n * An injected function for custom submission handling.\r\n */","values":[]},"onSubmit":{"name":"@submit","description":"/**\r\n * Callback triggered when the form is successfully submitted after validation, and no custom request function is provided.\r\n */","values":[]}}},"av-grid-helper":{"class":"Aventus.Layout.GridHelper","name":"av-grid-helper","description":"/**\r\n * Provides a comprehensive visual grid system and guide management for UI development. Features include configurable grid lines, rulers, draggable guides with magnetic snapping, and persistent storage for guide positions.\r\n */","attributes":{"show_rulers":{"name":"show_rulers","description":"Whether to display the rulers.","type":"boolean","values":[]},"show_grid":{"name":"show_grid","description":"Whether to display the grid lines.","type":"boolean","values":[]},"show_ruler":{"name":"show_ruler","description":"Whether to display the rulers.","type":"boolean","values":[]},"show_guides":{"name":"show_guides","description":"Whether to display the draggable guides.","type":"boolean","values":[]},"lock":{"name":"lock","description":"If true, guides cannot be dragged or created.","type":"boolean","values":[]},"visible":{"name":"visible","description":"Overall visibility of the GridHelper component.","type":"boolean","values":[]},"unit":{"name":"unit","description":"The unit of measurement for grid and ruler calculations. Changes update CSS variables for ruler styling.","type":"string","values":[{"name":"px","description":""},{"name":"rem","description":""},{"name":"cm","description":""},{"name":"mm","description":""},{"name":"in","description":""}]},"nb_col":{"name":"nb_col","description":"The number of columns in the grid. If 0, col_width is used.","type":"number","values":[]},"nb_row":{"name":"nb_row","description":"The number of rows in the grid. If 0, row_height is used.","type":"number","values":[]},"col_width":{"name":"col_width","description":"The width of each column. Used if nb_col is 0.","type":"number","values":[]},"row_height":{"name":"row_height","description":"The height of each row. Used if nb_row is 0.","type":"number","values":[]},"ruler_size":{"name":"ruler_size","description":"The size (thickness) of the rulers in the specified unit.","type":"number","values":[]},"step":{"name":"step","description":"The base step size for grid lines and guide snapping in the specified unit.","type":"number","values":[]},"step_big":{"name":"step_big","description":"A larger step size for major grid lines, if different from step.","type":"number","values":[]},"magnetic":{"name":"magnetic","description":"The magnetic snap distance for guides in the specified unit.","type":"number","values":[]}}},"av-grid-guide-helper":{"class":"Aventus.Layout.GridGuideHelper","name":"av-grid-guide-helper","description":"/**\r\n * Utility component for providing visual guides (like rulers or snap lines) within a grid layout. It allows users to drag these guides and snap them to a predefined grid, aiding in precise UI alignment.\r\n */","attributes":{"direction":{"name":"direction","description":"Specifies the orientation of the guide: \"x\" for vertical, \"y\" for horizontal.","type":"string","values":[{"name":"y","description":""},{"name":"x","description":""}]},"moving":{"name":"moving","description":"Indicates whether the guide is currently being dragged.","type":"boolean","values":[]}}},"av-scrollable":{"class":"Aventus.Layout.Scrollable","name":"av-scrollable","description":"/**\r\n * A highly customizable and interactive scroll container web component. It supports advanced features like zooming, pinch-to-zoom, custom scrollbars, auto-hide scrollbars, momentum scrolling, mouse-dragging for scrolling, and auto-scrolling.\r\n */","attributes":{"min_zoom":{"name":"min_zoom","description":"The minimum allowed zoom level for the content.","type":"number","values":[]},"max_zoom":{"name":"max_zoom","description":"The maximum allowed zoom level for the content.","type":"number","values":[]},"floating_scroll":{"name":"floating_scroll","description":"Determines if the custom scrollbars will be floating over the content or occupy space.","type":"boolean","values":[]},"x_scroll":{"name":"x_scroll","description":"Determines if horizontal scrolling is allowed.","type":"boolean","values":[]},"y_scroll":{"name":"y_scroll","description":"Determines if vertical scrolling is allowed.","type":"boolean","values":[]},"auto_hide":{"name":"auto_hide","description":"If true, the custom scrollers will hide when not in use and reappear on interaction.","type":"boolean","values":[]},"break":{"name":"break","description":"Controls the decay rate of momentum scrolling (value between 0 and 1).","type":"number","values":[]},"disable":{"name":"disable","description":"If true, disables all user interaction (scrolling, zooming, dragging) with the component.","type":"boolean","values":[]},"mouse_drag":{"name":"mouse_drag","description":"If true, allows scrolling by dragging with the mouse.","type":"boolean","values":[]},"pinch":{"name":"pinch","description":"If true, enables pinch-to-zoom functionality for touch devices.","type":"boolean","values":[]},"flex":{"name":"flex","description":"If true, sets the internal content containers to display: flex and flex-direction: column, useful for allowing content to take up remaining space.","type":"boolean","values":[]},"zoom":{"name":"zoom","description":"Sets the zoom level to apply to the container's content. Changes trigger a recalculation of dimensions and transformations.","type":"number","values":[]},"onScrollChange":{"name":"@scrollChange","description":"/**\r\n * Callback triggered whenever the scroll position changes.\r\n */","values":[]},"onZoomChange":{"name":"@zoomChange","description":"/**\r\n * Callback triggered whenever the zoom level changes.\r\n */","values":[]}}},"av-default-404":{"class":"Aventus.Navigation.Default404","name":"av-default-404","description":"/**\r\n * A specialized Page component intended to be displayed when a requested route or resource is not found (a \"404 Not Found\" error).\r\n */","attributes":{"visible":{"name":"visible","description":"Controls the visibility of the page. Changes to this property trigger onShow() or onHide() methods.","type":"boolean","values":[]}}}}
