    /**
     * Defines where the toast should appear on the screen.
     */
    @Attribute()
	@StoryValue('top right')
	position: Aventus.Toast.ToastPosition;
    /**
     * The duration (in milliseconds) before the toast automatically closes. Use -1 for an infinite timer.
     */
    @Attribute()
	@StoryValue(5000)
	delay: number;
    /**
     * Reflects whether the toast is currently active/visible.
     */
    @Attribute()
	protected is_active: boolean;
    /**
     * A flag to indicate if show() was called before the component was ready.
     */
    protected showAsked: boolean;
    /**
     * A callback function to be executed when the toast is hidden or closed.
     */
    protected onHideCallback: (result: boolean) => void;
    /**
     * Stores the setTimeout ID for the auto-hide delay.
     */
    timeout: number;
    /**
