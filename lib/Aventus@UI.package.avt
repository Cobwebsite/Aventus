     * The default delay (in milliseconds) for new toasts if not specified in options.
     */
    @Internal()
	private static defaultDelay;
    /**
     * The spacing (in pixels) between multiple toasts in the same position stack.
     */
    private static gap;
    /**
     * The percentage of the container height available for toasts before queuing them.
     */
    private static heightLimitPercent;
