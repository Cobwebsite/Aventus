    private _notifyBottomRight;
    /**
     * Helper method to add a toast to the 'top right' position, managing stacking.
     */
    private _notifyTopRight;
    /**
     * Helper method to add a toast to the 'bottom left' position, managing stacking.
     */
    private _notifyBottomLeft;
    /**
     * Helper method to add a toast to the 'top left' position, managing stacking.
     */
    private _notifyTopLeft;
    /**
     * Helper method to add a toast to the 'top' position (centered), managing stacking.
