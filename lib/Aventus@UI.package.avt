// Aventus@UI:1.0.1
// npm:@aventusjs/ui
//#region js def //
declare global {

namespace Aventus{
/**
 * Configuration options for the Process utility class.
 */
type ProcessConfig = {
    handleErrors: (msg: string, errors: Aventus.GenericError[]) => void;
};

namespace Toast {
/**
 * Defines the possible positions where a toast notification can appear on the screen.
 */
type ToastPosition = 'bottom' | 'top' | 'bottom left' | 'top left' | 'bottom right' | 'top right';
}

/**
 * Renders a circular progress indicator using SVG. It allows customization of the progress value and the thickness of the circle stroke.
 */
class ProgressCircle extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Represents the progress percentage (0-100). Changes to this property trigger the render() method.
     */
    @Property((target: ProgressCircle) => {
        target.render();
    })
	value: number;
    /**
     * Defines the thickness of the progress circle's stroke. Changes to this property trigger the render() method.
     */
    @Property((target: ProgressCircle) => {
        target.render();
    })
	stroke_width: number;
    /**
     * Reference to the HTML element within the component's template where the SVG will be rendered.
     */
    @ViewElement()
	protected containerEl: HTMLDivElement;
    /**
     * Reference to the dynamically created SVG element.
     */
    private svg?;
    /**
     * Reference to the SVG circle element representing the background of the progress circle.
     */
    private backCircle?;
    /**
     * Reference to the SVG circle element representing the filled progress of the circle.
     */
    private percentCircle?;
    /**
     * Ensures the input value is within the valid range of 0 to 100.
     */
    private getLimitedValue;
    /**
     * The core rendering logic for the progress circle. It calculates the necessary SVG attributes (radius, circumference, stroke-dashoffset) based on the component's dimensions, value, and stroke_width. It then creates or updates the SVG and its circle elements, appending them to containerEl.
     */
    protected render(): void;
    /**
     * Lifecycle hook called after the component is created. It attaches a ResizeObserver to the component to re-render the progress circle whenever the component's size changes, ensuring responsiveness. Also performs an initial render.
     */
    protected postCreation(): void;
}

namespace Navigation {
/**
 * Configuration options for a page component.
 */
interface PageConfig {
    /** Define the page title for browser tab. */
    title?: string;
    /** Define the page description for browser tab. */
    description?: string;
    /** Define the page keywords for browser tab. */
    keywords?: string[];
    /** Define if the page should be destroyed when the page will be hidden. */
    destroy?: boolean;
}
}

/**
 * Manages the state and history of routes within an Aventus application.
 */
class RouterStateManager extends Aventus.StateManager {
    /**
     * Retrieves the singleton instance of the RouterStateManager.
     */
    static getInstance(): RouterStateManager;
}

namespace Navigation {
/**
 * Provides declarative navigation within an Aventus application. It functions similarly to an HTML tag but integrates with the application's router for client-side routing, applying an "active" class based on the current route/state.
 */
@Deprecated()
class RouterLink extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Specifies the internal route state path to navigate to.
     */
    @Attribute()
	state?: string;
    /**
     * If set, defines a custom pattern to determine when the link should be considered "active", overriding the default behavior of matching state.
     */
    @Attribute()
	active_state?: string;
    /**
     * Callback triggered when the active state of the link changes.
     */
    onActiveChange: Aventus.Callback<(isActive: boolean) => void>;
    /**
     * Sets up a PressManager to handle click events on the link. When clicked, it normalizes the state path (handling relative paths) and uses Aventus.State.activate to navigate via the RouterStateManager.
     */
    protected addClickEvent(): void;
    /**
     * Subscribes to the RouterStateManager to listen for state changes. When the current state matches state (or active_state), it adds the "active" class to the component and triggers onActiveChange. When inactive, it removes the class.
     */
    protected registerActiveStateListener(): void;
    /**
     * Utility method to prevent the default behavior of an event.
     */
    protected prevent(e: Event): void;
    /**
     * Lifecycle hook called after the component is created. Registers the active listener and adds the click event handler.
     */
    protected postCreation(): void;
}
}

namespace Navigation {
/**
 * Provides declarative navigation within an Aventus application. It functions similarly to an HTML tag but integrates with the application's router for client-side routing, applying an "active" class based on the current route.
 */
class Link extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Specifies the internal route path to navigate to.
     */
    @Attribute()
	to?: string;
    /**
     * If set, defines a custom pattern to determine when the link should be considered "active", overriding the default behavior of matching to.
     */
    @Attribute()
	active_pattern?: string;
    /**
     * Callback triggered when the active state of the link changes.
     */
    onActiveChange: Aventus.Callback<(isActive: boolean) => void>;
    /**
     * Sets up a PressManager to handle click events on the link. When clicked, it normalizes the to path (handling relative paths) and uses Aventus.State.activate to navigate via the RouterStateManager.
     */
    protected addClickEvent(): void;
    /**
     * Subscribes to the RouterStateManager to listen for route changes. When the current route matches to (or active_pattern), it adds the "active" class to the component and triggers onActiveChange. When inactive, it removes the class.
     */
    protected registerActivetoListener(): void;
    /**
     * Utility method to prevent the default behavior of an event.
     */
    protected prevent(e: Event): void;
    /**
     * Lifecycle hook called after the component is created. Registers the active listener and adds the click event handler.
     */
    protected postCreation(): void;
}
}

namespace Navigation {
/**
 * Options for defining an asynchronously loaded route.
 */
type RouteAsyncOption = {
    route: string;
    scriptUrl: string;
    render: () => new () => Aventus.Navigation.Page;
};
}

namespace Modal {
/**
 * Defines configuration options for a modal dialog.
 */
interface ModalOptions<T = any> {
    /**
     * If true, the modal can be closed by pressing the Escape key.
     */
    closeWithEsc?: boolean;
    /**
     * If true, the modal can be closed by clicking outside its content area.
     */
    closeWithClick?: boolean;
    /**
     * The value with which the modal's promise will be rejected if closed without a specific resolution.
     */
    rejectValue?: T | null;
}
}

/**
 * Tracks touch or pointer events to calculate movement, delta, and velocity.
 */
class Tracker {
    /**
     * Multiplier for velocity calculations based on device pixel ratio.
     */
    private readonly velocityMultiplier;
    /**
     * Timestamp of the last update.
     */
    updateTime: number;
    /**
     * Change in position since the last update.
     */
    delta: {
        x: number;
        y: number;
    };
    /**
     * Current velocity of the tracker.
     */
    velocity: {
        x: number;
        y: number;
    };
    /**
     * Last recorded position.
     */
    lastPosition: {
        x: number;
        y: number;
    };
    /**
     * Initializes a new Tracker instance.
     */
    constructor(touch: Touch | PointerEvent | MouseEvent);
    /**
     * Updates the tracker's position, delta, and velocity.
     */
    update(touch: Touch | PointerEvent | MouseEvent): void;
    /**
     * Extracts pointer data from a given event.
     */
    private getPointerData;
    /**
     * Retrieves the client coordinates from a pointer event.
     */
    private getPosition;
}

namespace Layout {
/**
 * A fundamental building block for creating flexible and responsive layouts. It acts as a container for Col components, arranging them horizontally, and is configured to work with CSS Container Queries.
 */
class Row extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Initializes a new instance of the Row component. Sets CSS containerName to "row" and containerType to "inline-size" to enable CSS Container Queries for responsive child styling.
     */
    constructor();
}
}

namespace Lib {
/**
 * Enumerates special keys that can be used in keyboard shortcuts.
 */
enum SpecialTouch {
    Backspace = 0,
    Insert = 1,
    End = 2,
    PageDown = 3,
    PageUp = 4,
    Escape = 5,
    AltGraph = 6,
    Control = 7,
    Alt = 8,
    Shift = 9,
    CapsLock = 10,
    Tab = 11,
    Delete = 12,
    ArrowRight = 13,
    ArrowLeft = 14,
    ArrowUp = 15,
    ArrowDown = 16,
    Enter = 17
}
}

namespace Lib {
/**
 * Configuration options for subscribing to keyboard shortcuts.
 */
interface ShortcutManagerOptions {
    replaceTemp?: boolean;
    preventDefault?: boolean;
}
}

/**
 * Provides a simple web component to toggle the visibility of content, often with a collapsing/expanding animation driven by CSS.
 */
class Collapse extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Controls the collapsed/expanded state of the component. When true, the content is visible; when false, it's hidden.
     */
    @Attribute()
	open: boolean;
    /**
     * When true, disables the collapsing/expanding animation.
     */
    @Attribute()
	no_animation: boolean;
    @Attribute()
	horizontal: boolean;
    @Attribute()
	reverse: boolean;
    /**
     * Dispatches a new event when a CSS transition ends, allowing parent components or external listeners to react.
     */
    protected transitionEnd(e: Event): void;
    /**
     * Toggles the open property, switching the collapse component's state between open and closed.
     */
    protected toggleOpen(): void;
}

namespace Layout {
/**
 * Defines configuration options for the Col component.
 */
interface ColOptions {
    /**
     * Whether the column should act as a container.
     */
    use_container?: boolean;
}
}

namespace Layout {
/**
 * A foundational element for creating responsive grid layouts. Its behavior (sizing, offsetting, centering) is driven by CSS rules applied based on its attributes.
 */
class Col extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Static property indicating the default use_container value for all Col instances.
     */
    @Attribute()
	@StoryValue(false)
	private static use_container;
    /**
     * Allows global configuration of Col components.
     */
    static configure(options: Aventus.Layout.ColOptions): void;
    /**
     * Indicates if the column should act as a container. Can be configured globally or overridden per instance.
     */
    @Attribute()
	@StoryValue(false)
	use_container: boolean;
    /**
     * Defines the column's width.
     */
    @Attribute()
	size: number;
    /**
     * Defines the column's width for extra small screens.
     */
    @Attribute()
	size_xs: number;
    /**
     * Defines the column's width for small screens.
     */
    @Attribute()
	size_sm: number;
    /**
     * Defines the column's width for medium screens.
     */
    @Attribute()
	size_md: number;
    /**
     * Defines the column's width for large screens.
     */
    @Attribute()
	size_lg: number;
    /**
     * Defines the column's width for extra large screens.
     */
    @Attribute()
	size_xl: number;
    /**
     * Defines the column's left offset.
     */
    @Attribute()
	offset: number;
    /**
     * Defines the column's left offset for extra small screens.
     */
    @Attribute()
	offset_xs: number;
    /**
     * Defines the column's left offset for small screens.
     */
    @Attribute()
	offset_sm: number;
    /**
     * Defines the column's left offset for medium screens.
     */
    @Attribute()
	offset_md: number;
    /**
     * Defines the column's left offset for large screens.
     */
    @Attribute()
	offset_lg: number;
    /**
     * Defines the column's left offset for extra large screens.
     */
    @Attribute()
	offset_xl: number;
    /**
     * Defines the column's right offset.
     */
    @Attribute()
	offset_right: number;
    /**
     * Defines the column's right offset for extra small screens.
     */
    @Attribute()
	offset_right_xs: number;
    /**
     * Defines the column's right offset for small screens.
     */
    @Attribute()
	offset_right_sm: number;
    /**
     * Defines the column's right offset for medium screens.
     */
    @Attribute()
	offset_right_md: number;
    /**
     * Defines the column's right offset for large screens.
     */
    @Attribute()
	offset_right_lg: number;
    /**
     * Defines the column's right offset for extra large screens.
     */
    @Attribute()
	offset_right_xl: number;
    /**
     * When true, centers the content within the column.
     */
    @Attribute()
	center: boolean;
}
}

/**
 * A sophisticated image display component that handles responsive sizing, different content modes (stretch, contains, cover), and asynchronous loading of both raster images and SVG files. It ensures images are displayed correctly within their container, even with dynamic resizing.
 */
class Img extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * If true, the image will be loaded and cached as a base64 string.
     */
    @Attribute()
	cache: boolean;
    /**
     * The URL of the image to display. Changes to this property trigger onSrcChanged().
     */
    @Property((target: Img) => {
        target.onSrcChanged();
    })
	src?: string;
    /**
     * Determines how the image content should fit within its container. - 'stretch': Stretches the image to fill the container. - 'contains': Scales the image to fit within the container while preserving its aspect ratio. - 'cover': Scales the image to cover the entire container while preserving its aspect ratio.
     */
    @Property((target: Img) => {
        if(target.src != "") {
            target.calculateSize();
        }
    })
	mode: 'stretch' | 'contains' | 'cover';
    /**
     * Reference to the HTMLImageElement within the component's template, used for raster images.
     */
    @ViewElement()
	protected imgEl: HTMLImageElement;
    /**
     * Reference to the HTMLDivElement within the component's template, used for SVG content.
     */
    @ViewElement()
	protected svgEl: HTMLDivElement;
    /**
     * A flag to prevent redundant size calculations during calculateSize.
     */
    private isCalculing?;
    /**
     * The maximum number of retry attempts for calculateSize if initial dimensions are zero.
     */
    private maxCalculateSize;
    /**
     * Stores the aspect ratio (width / height) of the image.
     */
    private ratio;
    /**
     * An instance of Aventus.ResizeObserver to detect changes in the component's dimensions.
     */
    private resizeObserver?;
    /**
     * Calculates and applies the correct width, height, transform (for centering), and opacity styles to the image or SVG element based on the mode and available space. Includes retry logic if the element's dimensions are initially zero.
     */
    private calculateSize;
    /**
     * Asynchronously loads the image or SVG content based on the src property. If an SVG, it fetches and injects the content. If cache is true, it loads raster images as base64. Calls calculateSize() after loading.
     */
    private onSrcChanged;
    /**
     * Lifecycle hook called before the component is destroyed. Disconnects the resizeObserver to prevent memory leaks.
     */
    protected postDestruction(): void;
    /**
     * Lifecycle hook called after the component is created. Initializes and observes the component with Aventus.ResizeObserver to react to dimension changes and trigger calculateSize().
     */
    protected postCreation(): void;
}

namespace Form {
/**
 * Checks if a given class is a subclass of another class.
 */
function isSubclassOf(subClass: Function, superClass: Function): boolean;
}

namespace Form {
type LastParameter<T extends any> = T extends (...args: any) => any ? Aventus.Last<Parameters<T>> : never;
}

namespace Form {
type ObjectParameter<T extends any> = T extends (...args: any) => any ? Aventus.Last<Parameters<T>> extends Object ? Aventus.Last<Parameters<T>> : never : never;
}

namespace Form {
/**
 * Represents the internal structure of a single form field or part, including its value, validation rules, and associated elements.
 */
interface InternalFormPart<T = any> {
    /**
     * The value of the form part, which can be of type T or an object with get and set methods.
     */
    value: {
        get: () => T;
        set: (value: T | undefined) => void;
    };
    /**
     * A validation function for the form part.
     */
    validate?: Aventus.Form.FormPartValidate<T>;
    /**
     * Indicates whether validation should be performed on value change.
     */
    validateOnChange?: boolean;
    onValueChange: Aventus.Callback<() => void>;
    onValidation: Aventus.Callback<(errors: string[]) => Promise<string[]>, Promise<string[]>>;
    register: (element: Aventus.Form.IFormElement) => void;
    unregister: (element: Aventus.Form.IFormElement) => void;
    test: () => Promise<boolean>;
    handler: Aventus.Form.FormHandler<any>;
}
}

namespace Form {
type IsUnion<T, U = T> = T extends U ? [U] extends [T] ? false : true : never;
}

namespace Form {
type FilterPrefix<T> = T extends `getPrefix` ? never : T;
}

namespace Form {
/**
 * Represents the internal structure of a form, mapping field names to their internal form parts.
 */
type InternalForm<T> = {
    [K in keyof T]?: Aventus.Form.InternalFormPart<T[K]>;
};
}

namespace Form {
type OmitClass<T> = Exclude<{
    [K in keyof T]: T[K] extends Function ? never : K;
}[keyof T], "$type" | "className" | "namespace">;
}

namespace Form {
/**
 * Represents a type that can either be a successful result or an error.
 */
type WithError<X> = [X] extends [void] ? Aventus.VoidWithError : Aventus.ResultWithError<X>;
}

namespace Form {
/**
 * Extracts the successful result type from a WithError type.
 */
type ExtractError<X> = [X] extends [Aventus.ResultWithError<infer Y>] ? Y : [X] extends [Aventus.VoidWithError] ? void : X;
}

namespace Form {
/**
 * Represents a constructor type, with an option to allow abstract classes.
 */
type Constructor<T, AllowAbstract extends boolean = false> = AllowAbstract extends false ? new (...args: any[]) => T : abstract new (...args: any[]) => T;
}

namespace Toast {
/**
 * Configuration options for the ToastManager.
 */
type ToastManagerOptions = {
    defaultToast: Aventus.Form.Constructor<Aventus.Toast.ToastElement>;
    defaultToastManager: Aventus.Form.Constructor<Aventus.Toast.ToastManager>;
    defaultPosition: Aventus.Toast.ToastPosition;
    defaultDelay: number;
    heightLimitPercent: number;
    gap: number;
};
}

namespace Navigation {
/**
 * Configuration options for the Router component.
 */
type RouterOptions = {
    page404?: Aventus.Form.Constructor<Aventus.Navigation.Page>;
    destroyPage?: boolean;
};
}

namespace Layout.Tabs {
/**
 * Abstract web component that serves as a container for a tabbed interface. It manages the loading, rendering, and activation of Tab content components and their corresponding TabHeader components.
 */
abstract class Tabs<T extends Aventus.Layout.Tabs.Tab, U extends Aventus.Layout.Tabs.TabHeader<T>> extends Aventus.WebComponent implements Aventus.DefaultComponent {

    /**
     * Reference to the HTML element where the TabHeader components will be rendered.
     */
    @ViewElement()
	protected headerEl: HTMLDivElement;
    /**
     * Reference to the HTML element where the Tab content components will be rendered.
     */
    @ViewElement()
	protected bodyEl: HTMLDivElement;
    /**
     * Stores a reference to the currently active TabHeader component.
     */
    protected activeHeader?: Aventus.Layout.Tabs.TabHeader<T>;
    /**
     * An object that maps tab identifiers (from Tab.identifier()) to their corresponding Tab content components.
     */
    protected tabs: {
        [label: string]: T;
    };
    /**
     * Asynchronously discovers child Tab components within its slot. For each Tab, it instantiates a TabHeader (defined by defineTabHeader()), initializes it, and appends it to headerEl. It also determines the initial active tab.
     */
    protected loadTabs(): any;
    @BindThis()
	protected reloadFromSlot(): any;
    /**
     * Sets a specific tab as active. It can accept a TabHeader instance, an index (number), or a tab identifier (string). It deactivates the previously active tab and activates the new one, managing their active and selected attributes and display styles.
     */
    setActive(tabHeader: Aventus.Layout.Tabs.TabHeader<T> | number | string): boolean;
    /**
     * Abstract method that concrete Tabs implementations must provide. It should return the constructor for the specific TabHeader component to be used.
     */
    protected abstract defineTabHeader(): Aventus.Form.Constructor<U>;
    /**
     * Lifecycle hook called after the component is created. Overrides the base method to load the tabs when the component is instantiated.
     */
    protected postCreation(): void;
}
}

namespace Form {
/**
 * Represents the result of form validation.
 * It can be a string, a boolean, undefined, or a promise of these types.
 */
type FormValidateResult = Aventus.Asyncable<string | string[] | boolean | undefined>;
}

namespace Form {
/**
 * Represents a global validation function for a form field.
 */
type FormValidate = (field: string, value: unknown) => Aventus.Form.FormValidateResult;
}

namespace Form {
/**
 * Represents a validation function for a value of type T.
 * The function takes a value of type T or undefined and returns a FormValidateResult.
 */
type FormPartValidate<T> = (value: T | undefined, name: string, globalValidation: () => Promise<void>) => Aventus.Form.FormValidateResult;
}

namespace Form {
/**
 * Abstract base class for creating custom form validators.
 */
abstract class Validator<T> {
    /**
     * The default error message for the validator.
     */
    static msg: string | (() => string);
    /**
     * Statically tests a value against one or more validators.
     */
    static Test(validators: Aventus.Form.Constructor<Aventus.Form.Validator<any>> | Aventus.Form.Constructor<Aventus.Form.Validator<any>>[], value: any, name: string, globalValidation: () => Promise<void>): Promise<string[] | undefined>;
    private _msg?;
    /**
     * Initializes a new Validator instance with an optional custom error message.
     */
    constructor(msg?: string | (() => string));
    /**
     * Retrieves the error message for the validator, optionally replacing placeholders.
     */
    protected getMsg(replace?: {
        [field: string]: string;
    }): string;
    /**
     * Abstract method to be implemented by subclasses for custom validation logic.
     */
    @BindThis()
	abstract validate(value: T | undefined, name: string, globalValidation: () => Promise<void>): Aventus.Form.FormValidateResult;
}
}

namespace Form.Validators {
/**
 * Validator for checking if a field has a value.
 */
class Required extends Aventus.Form.Validator<any> {
    /**
     * The default error message for a required field.
     */
    static msg: string | (() => string);
    /**
     * @inheritdoc
     * Validates if the provided value is not undefined, null, or an empty string.
     */
    validate(value: any | undefined, name: string, globalValidation: () => Promise<void>): string | boolean;
}
}

namespace Form.Validators {
/**
 * Validator for checking if a string is a valid email address.
 */
class Email extends Aventus.Form.Validator<string> {
    /**
     * The default error message for invalid email addresses.
     */
    static msg: string | (() => string);
    /**
     * @inheritdoc
     * Validates if the provided value is a valid email address.
     */
    validate(value: string | undefined, name: string, globalValidation: () => Promise<void>): boolean | string;
}
}

namespace Form {
/**
 * Represents a list of validation functions or validators for a form part.
 */
type FormPartValidateList<T> = Aventus.Form.FormPartValidate<T> | Aventus.Form.Constructor<Aventus.Form.Validator<T>> | Aventus.Form.Validator<T> | (Aventus.Form.Constructor<Aventus.Form.Validator<T>> | Aventus.Form.Validator<T>)[];
}

namespace Form {
/**
 * Represents a function that handles form submission, returning an asynchronous result with potential errors.
 */
type SubmitFunction<T, X> = Aventus.Asyncable<Aventus.Form.WithError<X>> | ((body: T) => Aventus.Asyncable<Aventus.Form.WithError<X>>);
}

namespace Form {
/**
 * Configuration options for a FormHandler instance, including validation rules, error handling, and submission behavior.
 */
type FormHandlerConfig<T, R = any> = {
    defaultValues?: T;
    /** Define global validation rules for your forms. */
    validate?: Aventus.Form.FormValidate;
    /** Define if the form element must be validated on input change. */
    validateOnChange?: boolean;
    /** Define how to handle error in form when name isn't linked to an input. */
    onValidateFallback?: (errors: {
        [K in keyof T]?: string[];
    }) => Aventus.Asyncable<void>;
    /** Define how to handle error after submitting the form when name isn't linked to an input. */
    onServerFallback?: (errors: Aventus.GenericError[]) => Aventus.Asyncable<void>;
    /** Define how to parse errors to set them to fields. */
    extractor?: (error: Aventus.GenericError) => {
        fieldName: string;
        messages: string[];
    }[];
    /** Define what to do when form is submitted successfully. */
    onSuccess?: (result: Aventus.Form.ExtractError<R>) => Aventus.Asyncable<void>;
    /** Define the submit function to use. */
    submit?: Aventus.Form.SubmitFunction<T, R>;
};
}

namespace Form {
/**
 * Defines the structure and behavior of a single part within a form schema.
 */
interface FormPart<T = any> {
    /**
     * A validation function for the form part.
     */
    validate?: Aventus.Form.FormPartValidateList<T>;
    /**
     * Indicates whether validation should be performed on value change.
     */
    validateOnChange?: boolean;
}
}

namespace Form {
/**
 * Defines the schema for an entire form, specifying the structure and validation for each field.
 */
type FormSchema<T> = {
    [K in Aventus.Form.OmitClass<T> as undefined extends T[K] ? never : K]: Aventus.Form.FormPart<K> | Aventus.Form.FormPartValidateList<K>;
} & {
    [K in Aventus.Form.OmitClass<T> as undefined extends T[K] ? K : never]?: Aventus.Form.FormPart<K> | Aventus.Form.FormPartValidateList<K>;
};
}

namespace Form {
type MethodName<Ctrl extends Aventus.HttpRoute> = Aventus.Form.FilterPrefix<keyof Ctrl>;
}

namespace Form {
type MethodResult<Ctrl extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<Ctrl> = Aventus.Form.MethodName<Ctrl>> = Ctrl[M] extends (...args: any) => any ? ReturnType<Ctrl[M]> : any;
}

namespace Form {
type MethodNameExist<Ctrl extends Aventus.HttpRoute> = Aventus.Form.IsUnion<Aventus.Form.MethodName<Ctrl>> extends true ? never : Aventus.Form.MethodName<Ctrl>;
}

namespace Form {
type MethodBody<Ctrl extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<Ctrl> = Aventus.Form.MethodName<Ctrl>, Key extends (keyof Aventus.Form.ObjectParameter<Ctrl[M]> | '') = ''> = Key extends '' ? Aventus.Form.LastParameter<Ctrl[M]> : Aventus.Form.LastParameter<Ctrl[M]>[Key];
}

namespace Form {
type MethodResultParsed<Ctrl extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<Ctrl> = Aventus.Form.MethodName<Ctrl>> = Aventus.Form.ExtractError<Awaited<Aventus.Form.MethodResult<Ctrl, M>>>;
}

namespace Form {
type FormHandlerControllerConfig<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T> = Aventus.Form.MethodName<T>, Key extends (keyof Aventus.Form.ObjectParameter<T[M]> | '') = ''> = Omit<Omit<Aventus.Form.FormHandlerConfig<Aventus.Form.MethodBody<T, M, Key>>, 'onSuccess'>, 'submit'> & {
    onSuccess?: (result: Aventus.Form.MethodResultParsed<T, M>) => Aventus.Asyncable<void>;
    submit?: T[M];
};
}

namespace Form {
/**
 * Defines the contract for individual form elements.
 */
interface IFormElement<T = any> {
    errors: string[];
    value: T | undefined;
    onChange: Aventus.Callback<(value: T) => void>;
    formPart?: Aventus.Form.InternalFormPart<T>;
}
}

namespace Form {
/**
 * Abstract base class for all individual form input elements in the Aventus framework. It provides core functionality for value management, validation, error display, and integration with the parent Form component.
 */
@Storybook()
abstract class FormElement<T> extends Aventus.WebComponent implements Aventus.DefaultComponent, Aventus.Form.IFormElement<T> {
    /**
     * Indicates that this web component can be associated with a form.
     */
    static get formAssociated(): boolean;
    /**
     * Reflects whether the element currently has validation errors.
     */
    @Attribute()
	protected has_errors: boolean;
    /**
     * Indicates whether the form element is disabled. This is a property that can be reflected from a disabled state of the form.
     */
    @Property()
	disabled: boolean;
    /**
     * The current value of the form element. Changes to this property trigger onValueChange().
     */
    @Watch((target: FormElement<T>) => {
            target.onValueChange(target.value);
        })
	value: T | undefined;
    /**
     * List of error messages for the current form element. Changes to this property trigger onErrorsChange().
     */
    @Watch((target: FormElement<T>) => {
            target.onErrorsChange();
        })
	errors: string[];
    /**
     * Internal reference to the element's part within the overall form handler.
     */
    private _form?;
    /**
     * Gets or sets the element's part within the overall form handler. Setting this property will unlink and relink the form part.
     */
    @Injectable()
	get form(): Aventus.Form.InternalFormPart<T> | undefined;
    @Injectable()
	set form(value: Aventus.Form.InternalFormPart<T> | undefined);
    /**
     * Provides access to the form internals of the custom element, used for interacting with form validity state and setting form values.
     */
    protected internals: ElementInternals;
    /**
     * Flag indicating if the element is ready to link its value and errors to the form.
     */
    protected canLinkValueToForm: boolean;
    /**
     * Reference to the parent form handler, if available.
     */
    protected handler?: Aventus.Form.IForm;
    /**
     * Initializes a new instance of the FormElement.
     */
    constructor();
    /**
     * Callback triggered when the value of the form element changes.
     */
    onChange: Aventus.Callback<(value: T | undefined) => void>;
    /**
     * Refreshes the element's value and clears its errors based on the state of the associated form part.
     */
    @BindThis()
	protected refreshValueFromForm(): void;
    /**
     * Unregisters the element from its associated form part and removes event listeners.
     */
    protected unlinkFormPart(): void;
    /**
     * Registers the element with its associated form part and adds event listeners.
     */
    protected linkFormPart(): void;
    /**
     * Handles validation results from the parent form, combining its own validation errors.
     */
    @BindThis()
	onFormValidation(errors: string[]): Promise<string[]>;
    /**
     * Triggers the element's custom validation or delegates to the form's validation if linked.
     */
    validate(): Promise<boolean>;
    /**
     * Abstract method to be implemented by subclasses to define custom validation rules.
     */
    protected validation(): Promise<string[]>;
    /**
     * Clears all current validation errors.
     */
    protected clearErrors(): void;
    /**
     * Updates the element's value, triggers the onChange callback, and updates the form's value if linked.
     */
    protected triggerChange(value: T | undefined): void;
    /**
     * Called when the value property changes. Links the new value to the form.
     */
    protected onValueChange(value: T | undefined): void;
    /**
     * Called when the errors property changes. Updates has_errors and links errors to the form.
     */
    protected onErrorsChange(): void;
    /**
     * Sets the form's validity based on the errors array using ElementInternals.
     */
    protected linkErrorToForm(): void;
    /**
     * Sets the form's value based on the element's value using ElementInternals.
     */
    protected linkValueToForm(): void;
    /**
     * Lifecycle callback invoked when the component is associated with a form.
     */
    protected formAssociatedCallback(form: HTMLFormElement): void;
    /**
     * Lifecycle callback invoked when the component's disabled state changes.
     */
    protected formDisabledCallback(disabled: boolean): void;
    /**
     * Lifecycle hook called after the component is created. Registers the element with the parent Form component.
     */
    protected postCreation(): void;
    /**
     * Lifecycle hook called before the component is destroyed. Unlinks the element from the form.
     */
    protected postDestruction(): void;
}
}

namespace Form {
/**
 * Defines the contract for classes that can act as a form handler.
 */
interface IForm {
    registerElement(element: Aventus.Form.FormElement<any>): Aventus.Form.IForm;
    registerSubmit(element: Aventus.Form.ButtonElement): Aventus.Form.IForm;
    requestSubmit(): Aventus.Asyncable<void>;
}
}

namespace Form {
/**
 * Base class for form button elements, handling submission logic and integration with the Aventus form system.
 */
abstract class ButtonElement extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Indicates that this web component can be associated with a form.
     */
    static get formAssociated(): boolean;
    /**
     * Defines the behavior of the button. - 'button': A generic button with no default behavior. - 'submit': Submits the form data. - 'reset': Resets the form to its initial state. - 'menu': A button that opens a menu.
     */
    @Property()
	type: 'button' | 'submit' | 'reset' | 'menu';
    /**
     * Provides access to the form internals of the custom element.
     */
    protected internals: ElementInternals;
    /**
     * Reference to the parent form handler, if available.
     */
    protected handler?: Aventus.Form.IForm;
    /**
     * Initializes a new instance of the ButtonElement.
     */
    constructor();
    /**
     * Triggers the form submission if the button type is 'submit'. Manages loading state and calls requestSubmit() on the associated form or handler.
     */
    protected triggerSubmit(): any;
    protected registerSubmit(): void;
    /**
     * Lifecycle hook called after the component is created. Registers the button with the parent form and sets up event listeners for submission.
     */
    protected postCreation(): void;
}
}

namespace Form {
/**
 * Core web component for managing forms, including data handling, validation, and submission. It acts as an orchestrator for child form elements and can integrate with backend API routes.
 */
class Form<T extends any = any, R = any> extends Aventus.WebComponent implements Aventus.DefaultComponent, Aventus.Form.IForm {

    /**
     * Factory method to create a FormHandlerController instance from an HttpRoute controller. This allows automatic form generation based on backend route definitions.
     */
    static createFromController<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T> = Aventus.Form.MethodNameExist<T>>(controller: new () => T, schema: Aventus.Form.FormSchema<Aventus.Form.MethodBody<T, M>>, config?: Aventus.Form.FormHandlerControllerConfig<T, M>): Aventus.Form.FormHandlerController<T, M>;
    static createFromController<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T>>(controller: new () => T, name: M, schema?: Aventus.Form.FormSchema<Aventus.Form.MethodBody<T, M>>, config?: Aventus.Form.FormHandlerControllerConfig<T, M>): Aventus.Form.FormHandlerController<T, M>;
    /**
     * Factory method to create a FormHandler instance directly from a FormSchema.
     */
    static create<T, R = any>(schema: Aventus.Form.FormSchema<T>, config?: Aventus.Form.FormHandlerConfig<T, R>): Aventus.Form.FormHandler<T, R>;
    /**
     * Sets a global default configuration for all FormHandler instances.
     */
    static configure(value: Aventus.Form.FormHandlerConfig<any>): void;
    /**
     * Gets the global default configuration for FormHandler instances.
     */
    static get defaultConfig(): Aventus.Form.FormHandlerConfig<any> | undefined;
    /**
     * Sets the list of constructors for IForm implementing elements.
     */
    static set formElements(value: Aventus.Form.Constructor<Aventus.Form.IForm, true>[]);
    /**
     * Gets the list of constructors for IForm implementing elements.
     */
    static get formElements(): Aventus.Form.Constructor<Aventus.Form.IForm, true>[];
    /**
     * The injected FormHandler instance managing form data, validation, and submission logic.
     */
    @Injectable()
	form?: Aventus.Form.FormHandler<any, R>;
    /**
     * An injected function for custom submission handling.
     */
    @Injectable()
	request?: Aventus.Form.SubmitFunction<T, R>;
    /**
     * An array of FormElement instances currently registered with this form.
     */
    protected elements: Aventus.Form.FormElement<any>[];
    /**
     * An array of ButtonElement instances associated with this form, typically submit buttons.
     */
    protected btns: Aventus.Form.ButtonElement[];
    /**
     * Callback triggered when the form is successfully submitted after validation, and no custom request function is provided.
     */
    onSubmit: Aventus.Callback<() => void>;
    /**
     * Handles keyboard events, specifically triggering form submission when the "Enter" key is pressed.
     */
    @BindThis()
	protected checkEnter(e: KeyboardEvent): void;
    /**
     * Registers a FormElement instance with this form. It ensures only the latest registered element has the 'keyup' event listener for "Enter" key.
     */
    registerElement(element: Aventus.Form.FormElement<any>): Aventus.Form.Form;
    /**
     * Registers a ButtonElement instance as a submit button for this form.
     */
    registerSubmit(element: Aventus.Form.ButtonElement): Aventus.Form.Form;
    /**
     * Asynchronously handles the form submission process. It finds the associated FormHandler if not already set, manages loading states of buttons, and either calls a custom submission function or triggers validation and the onSubmit callback.
     */
    requestSubmit(): Promise<void>;
}
}

namespace Form {
/**
 * Provides core logic for handling forms, including data management, validation, and submission.
 */
class FormHandler<T, R = any> {
    /**
     * Global configuration settings for FormHandler instances.
     */
    @Internal()
	private static _globalConfig?;
    /**
     * List of constructors for elements that implement IForm.
     */
    @Internal()
	private static _IFormElements;
    /**
     * Internal watcher instance for tracking form data changes.
     */
    private __watcher;
    /**
     * The data item associated with the form.
     */
    get item(): T;
    /**
     * Sets the data item associated with the form.
     */
    set item(item: T);
    /**
     * Provides access to the internal form parts for the schema.
     */
    get parts(): Aventus.Form.InternalForm<T>;
    /**
     * Internal map of registered form elements by field name.
     */
    private _elements;
    /**
     * Provides access to the registered form elements.
     */
    get elements(): {
        [K in keyof T]?: Aventus.Form.IFormElement[];
    };
    /**
     * Global validation function for the form.
     */
    private _globalValidation?;
    /**
     * Indicates if validation should occur on input change.
     */
    private _validateOnChange;
    /**
     * Fallback handler for validation errors not linked to a specific input.
     */
    private _onValidateFallback?;
    /**
     * Fallback handler for server-side errors not linked to a specific input.
     */
    private _onServerFallback?;
    /**
     * Function to extract field-specific error messages from a generic error.
     */
    private _extractor;
    /**
     * Callback executed upon successful form submission.
     */
    private _onSuccess?;
    /**
     * The internal function responsible for submitting the form.
     */
    private _submitFct?;
    /**
     * Checks if a submission function is defined for the form.
     */
    get hasSubmitFct(): boolean;
    /**
     * The default values for the form fields.
     */
    defaultValues: T;
    /**
     * Callback triggered when an item's property changes.
     */
    onItemChange: Aventus.Callback<(action: Aventus.WatchAction, path: string, value: any) => void>;
    /**
     * Initializes a new FormHandler instance with a given schema and optional configuration.
     */
    constructor(schema: Aventus.Form.FormSchema<T>, config?: Aventus.Form.FormHandlerConfig<T, R>);
    /**
     * Logs validation errors to the console.
     */
    private writeValidationIntoConsole;
    /**
     * Logs generic errors to the console.
     */
    private writeErrorIntoConsole;
    /**
     * Transforms the raw form schema into an internal representation.
     */
    protected transformForm(form: Aventus.Form.FormSchema<T>): Aventus.Form.InternalForm<T>;
    /**
     * Transforms a single form part within the internal form representation.
     */
    protected transformFormPart(key: keyof T, part: Aventus.Form.FormPart | undefined): void;
    /**
     * Handles changes observed by the watcher, triggering value change and validation for relevant form parts.
     */
    protected onWatcherChanged(action: Aventus.WatchAction, path: string, value: any): any;
    private _validate;
    /**
     * Validates the form or a specific field, and triggers fallback handlers for unhandled errors.
     */
    validate(key: keyof T): Promise<boolean>;
    validate(): Promise<boolean>;
    /**
     * Handles form submission, including validation and execution of the submission function.
     */
    submit<X>(query?: Aventus.Form.SubmitFunction<T, X>): Promise<Aventus.Form.WithError<X> | null>;
    protected transformToSend(item: T): T;
    /**
     * Executes the form's submission function after validation.
     */
    execute<X>(query?: Aventus.Form.SubmitFunction<T, X>): Promise<Aventus.Form.WithError<X>>;
    /**
     * Extracts field-specific error messages from a generic error object.
     */
    private defaultExtractor;
    /**
     * Parse errors and display them inside the FormElement if possible
     */
    parseErrors<X>(queryResult: Aventus.Form.WithError<X>): Aventus.GenericError[];
    /**
     * Reset form with default values
     */
    reset(): void;
}
}

namespace Form {
/**
 * Extends FormHandler to integrate with Aventus HttpRoute controllers for form submissions.
 */
class FormHandlerController<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T> = Aventus.Form.MethodNameExist<T>, Key extends (keyof Aventus.Form.ObjectParameter<T[M]> | '') = ''> extends Aventus.Form.FormHandler<Aventus.Form.MethodBody<T, M, Key>> {
    private _controller;
    private _formKey?;
    /**
     * The HttpRoute controller constructor.
     */
    get controller(): new () => T;
    /**
     * Creates a FormHandlerController instance, inferring the submission method if only one exists.
     */
    static create<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T> = Aventus.Form.MethodNameExist<T>>(controller: new () => T, schema: Aventus.Form.FormSchema<Aventus.Form.MethodBody<T, M>>, config?: Aventus.Form.FormHandlerControllerConfig<T, M>): any;
    /**
     * Creates a FormHandlerController instance with a explicitly named submission method.
     */
    static createWithName<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T>>(controller: new () => T, name: M, schema: Aventus.Form.FormSchema<Aventus.Form.MethodBody<T, M>>, config?: Aventus.Form.FormHandlerControllerConfig<T, M>): any;
    /**
     * Creates a FormHandlerController instance, inferring the submission method if only one exists.
     */
    static createSubForm<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T> = Aventus.Form.MethodNameExist<T>, Key extends (keyof Aventus.Form.ObjectParameter<T[M]> | '') = ''>(controller: new () => T, formKey: Key, schema: Aventus.Form.FormSchema<Aventus.Form.MethodBody<T, M, Key>>, config?: Aventus.Form.FormHandlerControllerConfig<T, M, Key>): any;
    /**
     * Creates a FormHandlerController instance with a explicitly named submission method.
     */
    static createSubFormWithName<T extends Aventus.HttpRoute, M extends Aventus.Form.MethodName<T>, Key extends (keyof Aventus.Form.ObjectParameter<T[M]> | '') = ''>(controller: new () => T, name: M, formKey: Key, schema: Aventus.Form.FormSchema<Aventus.Form.MethodBody<T, M, Key>>, config?: Aventus.Form.FormHandlerControllerConfig<T, M, Key>): any;
    /**
     * Initializes a new FormHandlerController instance.
     */
    private constructor();
    protected transformToSend(item: Aventus.Form.MethodBody<T, M, Key>): Aventus.Form.MethodBody<T, M, Key>;
}
}

namespace Lib {
/**
 * Manages global keyboard shortcuts, allowing subscription and unsubscription for custom key combinations.
 */
class ShortcutManager {
    /**
     * Stores registered shortcut callbacks.
     */
    private static memory;
    /**
     * List of shortcut key combinations that should automatically prevent default browser behavior.
     */
    private static autoPrevents;
    /**
     * Indicates if the ShortcutManager has been initialized.
     */
    private static isInit;
    /**
     * Currently pressed keys.
     */
    private static arrayKeys;
    /**
     * Stores options for each registered shortcut callback.
     */
    private static options;
    /**
     * Stores temporarily replaced shortcut callbacks.
     */
    private static replacingMemory;
    /**
     * Checks if a given key is a printable character or a space.
     */
    private static isTxt;
    /**
     * Converts a key combination into a standardized string representation.
     */
    private static getText;
    /**
     * Subscribes a callback function to a specific keyboard shortcut combination.
     */
    static subscribe(combinaison: (Aventus.Lib.SpecialTouch | string)[] | (Aventus.Lib.SpecialTouch | string), cb: () => void | false | Promise<void> | Promise<false>, options?: Aventus.Lib.ShortcutManagerOptions): void;
    /**
     * Unsubscribes a callback function from a keyboard shortcut combination.
     */
    static unsubscribe(combinaison: (Aventus.Lib.SpecialTouch | string)[] | (Aventus.Lib.SpecialTouch | string), cb: () => void | false | Promise<void> | Promise<false>): void;
    /**
     * Handles keydown events, processing registered shortcuts and preventing default behavior.
     */
    private static onKeyDown;
    /**
     * Handles keyup events, removing the released key from the currently pressed keys.
     */
    private static onKeyUp;
    /**
     * Initializes the ShortcutManager, setting up global event listeners.
     */
    static init(): void;
    /**
     * Sets key combinations that should automatically prevent default browser behavior.
     */
    static setAutoPrevents(combinaisons: (Aventus.Lib.SpecialTouch | string)[][]): void;
    /**
     * Deinitializes the ShortcutManager, removing global event listeners.
     */
    private static uninit;
}
}

namespace Layout {
/**
 * Provides a comprehensive visual grid system and guide management for UI development. Features include configurable grid lines, rulers, draggable guides with magnetic snapping, and persistent storage for guide positions.
 */
class GridHelper extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * The unit of measurement for grid and ruler calculations. Changes update CSS variables for ruler styling.
     */
    @Property((target: GridHelper) => {
            target.rulerLeftEl.style.setProperty("--ruler-size", target.ruler_size + target.unit);
            target.rulerTopEl.style.setProperty("--ruler-size", target.ruler_size + target.unit);
            target.lockEl.style.setProperty("--ruler-size", target.ruler_size + target.unit);
        })
	unit: 'px' | 'rem' | 'cm' | 'mm' | 'in';
    /**
     * The number of columns in the grid. If 0, col_width is used.
     */
    @Property()
	nb_col: number;
    /**
     * The number of rows in the grid. If 0, row_height is used.
     */
    @Property((target: GridHelper) => {

        })
	nb_row: number;
    /**
     * The width of each column. Used if nb_col is 0.
     */
    @Property()
	col_width: number;
    /**
     * The height of each row. Used if nb_row is 0.
     */
    @Property((target: GridHelper) => {

        })
	row_height: number;
    /**
     * Whether to display the rulers.
     */
    @Attribute()
	show_rulers: boolean;
    /**
     * Whether to display the grid lines.
     */
    @Attribute()
	show_grid: boolean;
    /**
     * Whether to display the rulers.
     */
    @Attribute()
	show_ruler: boolean;
    /**
     * Whether to display the draggable guides.
     */
    @Attribute()
	show_guides: boolean;
    /**
     * If true, guides cannot be dragged or created.
     */
    @Attribute()
	lock: boolean;
    /**
     * Overall visibility of the GridHelper component.
     */
    @Attribute()
	visible: boolean;
    /**
     * The size (thickness) of the rulers in the specified unit.
     */
    @Property((target: GridHelper) => {
            target.rulerLeftEl.style.setProperty("--ruler-size", target.ruler_size + target.unit);
            target.rulerTopEl.style.setProperty("--ruler-size", target.ruler_size + target.unit);
            target.lockEl.style.setProperty("--ruler-size", target.ruler_size + target.unit);
        })
	ruler_size: number;
    /**
     * The base step size for grid lines and guide snapping in the specified unit.
     */
    @Property()
	step: number;
    /**
     * A larger step size for major grid lines, if different from step.
     */
    @Property()
	step_big: number;
    /**
     * The magnetic snap distance for guides in the specified unit.
     */
    @Property()
	magnetic: number;
    /**
     * Reference to the main grid container element.
     */
    @ViewElement()
	protected gridEl: HTMLDivElement;
    /**
     * Reference to the element containing column grid lines.
     */
    @ViewElement()
	protected colsEl: HTMLDivElement;
    /**
     * Reference to the element containing row grid lines.
     */
    @ViewElement()
	protected rowsEl: HTMLDivElement;
    /**
     * Reference to the top ruler element.
     */
    @ViewElement()
	protected rulerTopEl: HTMLDivElement;
    /**
     * Reference to the left ruler element.
     */
    @ViewElement()
	protected rulerLeftEl: HTMLDivElement;
    /**
     * Reference to the content area of the top ruler.
     */
    @ViewElement()
	protected rulerTopContentEl: HTMLDivElement;
    /**
     * Reference to the content area of the left ruler.
     */
    @ViewElement()
	protected rulerLeftContentEl: HTMLDivElement;
    /**
     * Reference to the element containing the draggable guides.
     */
    @ViewElement()
	protected guidesEl: HTMLDivElement;
    /**
     * Reference to the lock indicator element.
     */
    @ViewElement()
	protected lockEl: HTMLDivElement;
    /**
     * Converts a given number from the component's unit to pixels.
     */
    inPx(nb: number): number;
    /**
     * Converts a given number from pixels to the component's unit.
     */
    fromPx(nbPx: number): number;
    /**
     * Toggles the lock property, enabling or disabling guide interaction.
     */
    protected toggleLock(): void;
    /**
     * Renders the grid lines (columns and rows) based on configured nb_col, nb_row, col_width, and row_height.
     */
    protected draw(): void;
    /**
     * Renders the top ruler, including major and minor step markers, based on step, step_big, and ruler_size.
     */
    protected drawRulerTop(): void;
    /**
     * Renders the left ruler, including major and minor step markers, based on step, step_big, and ruler_size.
     */
    protected drawRulerLeft(): void;
    /**
     * Adds drag-and-drop functionality to the left ruler area for creating and moving horizontal GridGuideHelper instances. Also adds a double-press listener to prompt for a specific top position.
     */
    protected addDragLeft(): void;
    /**
     * Adds drag-and-drop functionality to the top ruler area for creating and moving vertical GridGuideHelper instances. Also adds a double-press listener to prompt for a specific left position.
     */
    protected addDragTop(): void;
    /**
     * Programmatically creates a vertical guide at a specified left position.
     */
    createGuideFromLeft(left: number): void;
    /**
     * Programmatically creates a horizontal guide at a specified top position.
     */
    createGuideFromTop(top: number): void;
    /**
     * Sets up keyboard shortcuts (e.g., Ctrl+K followed by 'v' for visible, 'g' for grid, 'r' for ruler, 'j' for guides, 'l' for lock) to control the visibility and state of grid elements.
     */
    protected addShortCut(): void;
    /**
     * Attaches a ResizeObserver to the component to redraw the grid and rulers when the component's dimensions change.
     */
    protected addResize(): void;
    /**
     * Saves the positions of the currently active GridGuideHelper instances to localStorage for persistence.
     */
    save(): void;
    /**
     * Loads saved guide positions from localStorage and recreates GridGuideHelper instances.
     */
    reload(): void;
    /**
     * Lifecycle hook called after the component is created. Initializes the component by reloading saved guides, adding resize observers, keyboard shortcuts, and drag functionalities for rulers, and drawing the initial grid.
     */
    protected postCreation(): void;
}
}

namespace Layout {
/**
 * Utility component for providing visual guides (like rulers or snap lines) within a grid layout. It allows users to drag these guides and snap them to a predefined grid, aiding in precise UI alignment.
 */
class GridGuideHelper extends Aventus.WebComponent implements Aventus.DefaultComponent {

    /**
     * Specifies the orientation of the guide: "x" for vertical, "y" for horizontal.
     */
    @Attribute()
	direction: "y" | "x";
    /**
     * Indicates whether the guide is currently being dragged.
     */
    @Attribute()
	moving: boolean;
    /**
     * Reference to the HTML element within the component's template, likely used to display the guide's current position.
     */
    @ViewElement()
	protected positionEl: HTMLDivElement;
    /**
     * Reference to the parent GridHelper component, which provides context for grid properties like step and magnetic snap.
     */
    container: Aventus.Layout.GridHelper;
    /**
     * Updates the inner HTML of the component to display the guide's current position, converted to the appropriate unit by the container.
     */
    displayValue(v: number): void;
    /**
     * Callback executed when dragging starts. Sets the moving attribute to true.
     */
    @BindThis()
	onStart(): void;
    /**
     * Calculates a new position for the guide, applying a "magnetic" snapping effect based on the GridHelper's magnetic and step properties.
     */
    protected applyMagnetic(valuePx: number): number;
    /**
     * Callback executed during horizontal dragging. Updates the guide's top style and positionEl's left style, applying magnetic snapping and displaying the new value.
     */
    @BindThis()
	onMoveX(e: Aventus.NormalizedEvent): void;
    /**
     * Callback executed during vertical dragging. Updates the guide's left style and positionEl's top style, applying magnetic snapping and displaying the new value.
     */
    @BindThis()
	onMoveY(e: Aventus.NormalizedEvent): void;
    /**
     * Callback executed when dragging stops. Sets moving to false and calls the save() method on the parent container.
     */
    @BindThis()
	onStop(): void;
    /**
     * Lifecycle hook called after the component is created. Initializes DragAndDrop functionality based on the direction and sets up a PressManager for double-press events to remove the guide. It also finds its parent GridHelper if not already set.
     */
    protected postCreation(): void;
}
}

/**
 * Records and manages multiple touch/pointer events for gestures like pinch-to-zoom.
 */
class TouchRecord {
    /**
     * The identifier of the currently active touch/pointer.
     */
    private _activeTouchID?;
    /**
     * A map of active touch/pointer IDs to their respective Trackers.
     */
    private _touchList;
    /**
     * Returns a primitive zero-value coordinate object.
     */
    private get _primitiveValue();
    /**
     * Checks if there is an active touch/pointer event.
     */
    isActive(): boolean;
    /**
     * Retrieves the delta movement of the active tracker.
     */
    getDelta(): any;
    /**
     * Retrieves the velocity of the active tracker.
     */
    getVelocity(): any;
    /**
     * Returns the number of active touch/pointer events.
     */
    getNbOfTouches(): any;
    /**
     * Returns an array of active Tracker instances.
     */
    getTouches(): any;
    /**
     * Calculates the easing distance based on current velocity and damping.
     */
    getEasingDistance(damping: number): {
        x: number;
        y: number;
    };
    /**
     * Starts tracking new touch/pointer events.
     */
    track(evt: TouchEvent | PointerEvent | MouseEvent): {
        [id: number]: Aventus.Tracker;
    };
    /**
     * Updates existing tracked touch/pointer events.
     */
    update(evt: TouchEvent | PointerEvent | MouseEvent): {
        [id: number]: Aventus.Tracker;
    };
    /**
     * Releases tracking for ended touch/pointer events.
     */
    release(evt: TouchEvent | PointerEvent | MouseEvent): void;
    /**
     * Retrieves a unique identifier for a touch or pointer event.
     */
    private _getIdentifier;
    /**
     * Adds a new touch/pointer event to the tracker list.
     */
    private _add;
    /**
     * Renews an existing touch/pointer event in the tracker list.
     */
    private _renew;
    /**
     * Deletes a touch/pointer event from the tracker list.
     */
    private _delete;
    /**
     * Checks if a touch/pointer event is being tracked.
     */
    private _has;
    /**
     * Sets the identifier of the currently active touch/pointer event.
     */
    private _setActiveID;
    /**
     * Retrieves the currently active Tracker instance.
     */
    private _getActiveTracker;
}

namespace Layout {
/**
 * A highly customizable and interactive scroll container web component. It supports advanced features like zooming, pinch-to-zoom, custom scrollbars, auto-hide scrollbars, momentum scrolling, mouse-dragging for scrolling, and auto-scrolling.
 */
class Scrollable extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Locks scrolling for a Scrollable component that is a parent of the given element.
     */
    static lock(element: Aventus.WebComponent): void;
    /**
     * Unlocks scrolling for a Scrollable component that is a parent of the given element.
     */
    static unlock(element: Aventus.WebComponent): void;
    /**
     * Sets the zoom level to apply to the container's content. Changes trigger a recalculation of dimensions and transformations.
     */
    @Property((target: Scrollable) => {
            target.changeZoom();
        })
	zoom: number;
    /**
     * The minimum allowed zoom level for the content.
     */
    @Attribute()
	min_zoom: number;
    /**
     * The maximum allowed zoom level for the content.
     */
    @Attribute()
	max_zoom: number;
    /**
     * Reflects whether the vertical scrollbar is currently visible.
     */
    @Attribute()
	private y_scroll_visible;
    /**
     * Reflects whether the horizontal scrollbar is currently visible.
     */
    @Attribute()
	private x_scroll_visible;
    /**
     * Determines if the custom scrollbars will be floating over the content or occupy space.
     */
    @Attribute()
	floating_scroll: boolean;
    /**
     * Determines if horizontal scrolling is allowed.
     */
    @Attribute()
	x_scroll: boolean;
    /**
     * Determines if vertical scrolling is allowed.
     */
    @Attribute()
	y_scroll: boolean;
    /**
     * If true, the custom scrollers will hide when not in use and reappear on interaction.
     */
    @Attribute()
	auto_hide: boolean;
    /**
     * Controls the decay rate of momentum scrolling (value between 0 and 1).
     */
    @Attribute()
	break: number;
    /**
     * If true, disables all user interaction (scrolling, zooming, dragging) with the component.
     */
    @Attribute()
	disable: boolean;
    /**
     * Internal property to prevent user text selection during drag interactions.
     */
    @Attribute()
	private no_user_select;
    /**
     * If true, allows scrolling by dragging with the mouse.
     */
    @Attribute()
	mouse_drag: boolean;
    /**
     * If true, enables pinch-to-zoom functionality for touch devices.
     */
    @Attribute()
	pinch: boolean;
    /**
     * If true, sets the internal content containers to display: flex and flex-direction: column, useful for allowing content to take up remaining space.
     */
    @Attribute()
	flex: boolean;
    /**
     * Reference to the internal DIV element that wraps the actual scrollable content.
     */
    @ViewElement()
	private contentWrapper;
    /**
     * Reference to the internal DIV element that handles zooming transformations.
     */
    @ViewElement()
	private contentZoom;
    /**
     * Reference to the main container element of the Scrollable component.
     */
    @ViewElement()
	private mainContainer;
    /**
     * Reference to an internal DIV element used for adjusting content area based on scrollbar presence.
     */
    @ViewElement()
	private contentHidder;
    /**
     * Reference to the container element for the vertical scrollbar.
     */
    @ViewElement()
	private verticalScrollerContainer;
    /**
     * Reference to the draggable element representing the vertical scrollbar thumb.
     */
    @ViewElement()
	private verticalScroller;
    /**
     * Reference to the container element for the horizontal scrollbar.
     */
    @ViewElement()
	private horizontalScrollerContainer;
    /**
     * Reference to the draggable element representing the horizontal scrollbar thumb.
     */
    @ViewElement()
	private horizontalScroller;
    /**
     * An instance of Aventus.ResizeObserver to detect size changes of the component and its content.
     */
    private observer?;
    /**
     * Stores the current visible dimensions (width, height) of the content area.
     */
    private display;
    /**
     * Stores the maximum scrollable distance (width, height) in pixels.
     */
    private max;
    /**
     * Stores the calculated margin adjustments due to scrollbar presence.
     */
    private margin;
    /**
     * Stores the current scroll position (x, y) in pixels.
     */
    private position;
    /**
     * Stores the current momentum (velocity) for momentum scrolling.
     */
    private momentum;
    /**
     * Stores the actual dimensions (offsetWidth, offsetHeight) of the content wrapper.
     */
    private contentWrapperSize;
    /**
     * Utility object to access horizontal/vertical scroller elements.
     */
    private scroller;
    /**
     * Utility object to access horizontal/vertical scroller container elements.
     */
    private scrollerContainer;
    /**
     * Stores setTimeout IDs for auto-hiding scrollbars.
     */
    private hideDelay;
    /**
     * An instance of TouchRecord to track touch events for multi-touch and pinch gestures.
     */
    private touchRecord;
    /**
     * The number of active pointers (touches/mouse buttons).
     */
    private pointerCount;
    /**
     * Flag indicating if the component has been rendered at least once.
     */
    private loadedOnce;
    /**
     * Stores the scroll position as a percentage during reloads or size changes.
     */
    private savedPercent?;
    /**
     * Flag indicating if the user is currently dragging a custom scrollbar.
     */
    private isDragScroller;
    /**
     * Cached SVG element used for DOMMatrix creation.
     */
    private cachedSvg?;
    /**
     * Stores the midpoint between two touch points for pinch gestures.
     */
    private previousMidPoint?;
    /**
     * Stores the distance between two touch points for pinch gestures.
     */
    private previousDistance?;
    /**
     * Stores the initial translation during a pinch gesture.
     */
    private startTranslate;
    /**
     * Getter for the current horizontal scroll position.
     */
    get x(): number;
    /**
     * Getter for the current vertical scroll position.
     */
    get y(): number;
    /**
     * Getter for the maximum horizontal scroll position.
     */
    get xMax(): number;
    /**
     * Getter for the maximum vertical scroll position.
     */
    get yMax(): number;
    /**
     * Initializes a new instance of the Scrollable component, binding event handlers and setting up the animation instance.
     */
    constructor();
    /**
     * Callback triggered whenever the scroll position changes.
     */
    onScrollChange: Aventus.Callback<(x: number, y: number) => void>;
    /**
     * Callback triggered whenever the zoom level changes.
     */
    onZoomChange: Aventus.Callback<(zoom: number) => void>;
    /**
     * The animation instance responsible for smooth momentum scrolling.
     */
    private renderAnimation;
    /**
     * Creates and configures the Aventus.Animation instance for momentum scrolling.
     */
    private createAnimation;
    /**
     * Calculates the next scroll position and remaining momentum for a given direction.
     */
    private nextPosition;
    /**
     * Applies the calculated scroll position for a given direction, updates the scroller element's transform, manages auto-hide for scrollbars, and triggers the onScrollChange callback.
     */
    private scrollDirection;
    /**
     * Scrolls the content to a specified percentage of the total scrollable distance.
     */
    private scrollDirectionPercent;
    /**
     * Ensures that the scroll value remains within the valid bounds (0 to max[direction]).
     */
    private correctScrollValue;
    /**
     * Triggers the onScrollChange callback with the current x and y scroll positions.
     */
    private triggerScrollChange;
    /**
     * Scrolls the content to a specific absolute (x, y) pixel position.
     */
    scrollToPosition(x: number, y: number): void;
    /**
     * Scrolls the content horizontally to a specific absolute pixel position.
     */
    scrollX(x: number): void;
    /**
     * Scrolls the content horizontally to a specific percentage of its total width.
     */
    scrollXPercent(x: number): void;
    /**
     * Scrolls the content vertically to a specific absolute pixel position.
     */
    scrollY(y: number): void;
    /**
     * Scrolls the content vertically to a specific percentage of its total height.
     */
    scrollYPercent(y: number): void;
    /**
     * Stores setInterval IDs for active auto-scrolling directions.
     */
    private autoScrollInterval;
    /**
     * Stores the calculated pixel speed for auto-scrolling in each direction.
     */
    private autoScrollSpeed;
    /**
     * Initiates auto-scrolling to the right.
     */
    private startAutoScrollRight;
    /**
     * Starts auto-scrolling the content to the right with a specified speed percentage.
     */
    autoScrollRight(percent?: number): void;
    /**
     * Stops any active auto-scrolling to the right.
     */
    stopAutoScrollRight(): void;
    /**
     * Initiates auto-scrolling to the left.
     */
    private startAutoScrollLeft;
    /**
     * Starts auto-scrolling the content to the left with a specified speed percentage.
     */
    autoScrollLeft(percent?: number): void;
    /**
     * Stops any active auto-scrolling to the left.
     */
    stopAutoScrollLeft(): void;
    /**
     * Initiates auto-scrolling upwards.
     */
    private startAutoScrollTop;
    /**
     * Starts auto-scrolling the content upwards with a specified speed percentage.
     */
    autoScrollTop(percent?: number): void;
    /**
     * Stops any active auto-scrolling upwards.
     */
    stopAutoScrollTop(): void;
    /**
     * Initiates auto-scrolling downwards.
     */
    private startAutoScrollBottom;
    /**
     * Starts auto-scrolling the content downwards with a specified speed percentage.
     */
    autoScrollBottom(percent?: number): void;
    /**
     * Stops any active auto-scrolling downwards.
     */
    stopAutoScrollBottom(): void;
    /**
     * Creates a new SVG DOMMatrix for transformations.
     */
    private createMatrix;
    /**
     * Calculates the midpoint between two touch trackers.
     */
    private getMidPoint;
    /**
     * Calculates the distance between two touch trackers.
     */
    private getDistance;
    /**
     * Zooms the content around a specific client coordinate.
     */
    zoomOnPoint(clientX: number, clientY: number, newZoom: number): void;
    /**
     * Handles the logic for pinch-to-zoom gestures.
     */
    private pinchAction;
    /**
     * Manages press, drag, and touch events for the scrollable component.
     */
    private pressManager;
    /**
     * Attaches primary event listeners for wheel, touch (via PressManager), and pointer events.
     */
    private addAction;
    /**
     * Attaches event listeners to document.body for move-related touch/pointer events.
     */
    private addActionMove;
    /**
     * Removes event listeners from document.body for move-related touch/pointer events.
     */
    private removeActionMove;
    /**
     * Adds drag-and-drop functionality to the custom scrollbar elements (horizontal or vertical).
     */
    private addScrollDrag;
    /**
     * Determines whether a scroll event should stop propagation based on scroll boundaries.
     */
    private shouldStopPropagation;
    /**
     * Adds a delta value to the current momentum and starts the rendering animation.
     */
    private addDelta;
    /**
     * Event handler for wheel events, managing scrolling and pinch-to-zoom (with Ctrl key).
     */
    private onWheel;
    /**
     * Handles the start of a touch or pointer event, initiating tracking.
     */
    private onTouchStartPointer;
    /**
     * General handler for touch/pointer/mouse start events, resetting momentum and tracking touches.
     */
    private onTouchStart;
    /**
     * Handles move events for touch or pointer, updating touch tracking.
     */
    private onTouchMovePointer;
    /**
     * General handler for touch/pointer/mouse move events, processing pinch-to-zoom or scrolling.
     */
    private onTouchMove;
    /**
     * Handles end events for touch or pointer, releasing touch tracking.
     */
    private onTouchEndPointer;
    /**
     * General handler for touch/pointer/mouse end events, applying easing momentum and cleaning up.
     */
    private onTouchEnd;
    /**
     * Calculates the actual offsetWidth and offsetHeight of the content area, accounting for zoom, and determines if dimensions have changed.
     */
    private calculateRealSize;
    /**
     * Calculates and adjusts the position of the scrollbar containers based on direction.
     */
    private calculatePositionScrollerContainer;
    /**
     * Calculates and adjusts the position of the vertical scrollbar container.
     */
    private calculatePositionScrollerContainerY;
    /**
     * Calculates and adjusts the position of the horizontal scrollbar container.
     */
    private calculatePositionScrollerContainerX;
    /**
     * Calculates and sets the size of the custom scrollbar thumb for a given direction.
     */
    private calculateSizeScroller;
    /**
     * Applies the zoom transformation to contentZoom and triggers a dimension refresh.
     */
    private changeZoom;
    /**
     * Recalculates and updates all scroll-related dimensions and positions. Manages scrollbar visibility and ensures correct layout after size changes.
     */
    private dimensionRefreshed;
    /**
     * Creates and returns an Aventus.ResizeObserver instance configured to call dimensionRefreshed() on resize events.
     */
    private createResizeObserver;
    /**
     * Initializes and attaches the ResizeObserver to monitor the component and its contentWrapper for size changes.
     */
    private addResizeObserver;
    /**
     * Helper function for safe division, returning nb1 if nb2 is zero or falsy.
     */
    private div;
    /**
     * Lifecycle hook called after the component is created. Initializes dimensions, sets up resize observers, and adds interaction actions.
     */
    protected postCreation(): void;
}
}

namespace Layout.Tabs {
/**
 * Abstract base class for the clickable header of an individual tab within a tabbed interface. It manages its active state, links to its corresponding Tab content, and handles user interaction to activate the tab.
 */
abstract class TabHeader<T extends Aventus.Layout.Tabs.Tab> extends Aventus.WebComponent implements Aventus.DefaultComponent {

    /**
     * Indicates whether this tab header is currently active.
     */
    @Attribute()
	active: boolean;
    /**
     * Internal reference to the associated Tab content component.
     */
    private _tab;
    /**
     * Gets the associated Tab instance.
     */
    get tab(): T;
    /**
     * Reference to the parent Tabs component, enabling interaction with the tab group.
     */
    protected tabs: Aventus.Layout.Tabs.Tabs<T, this>;
    /**
     * Initializes the TabHeader by linking it to a Tab component and its parent Tabs component, then triggers its render() method.
     */
    init(tab: T, tabs: Aventus.Layout.Tabs.Tabs<T, this>): any;
    /**
     * Abstract method that concrete TabHeader implementations must provide to define how they visually render themselves.
     */
    abstract render(): Aventus.Asyncable<void>;
    /**
     * Called when the tab header is pressed. If the tab is not already active, it calls setActive() on the parent Tabs component to activate this tab.
     */
    onPress(): void;
    /**
     * Sets up a PressManager to listen for press events on the tab header, triggering the onPress() method.
     */
    protected addPress(): void;
    /**
     * Lifecycle hook called after the component is created. Overrides the base method to set up press event listeners.
     */
    protected postCreation(): void;
}
}

namespace Layout.Tabs {
/**
 * Abstract base class for individual tab content panels within a tabbed interface. It manages its selected state and maintains a reference to its corresponding tab header.
 */
abstract class Tab extends Aventus.WebComponent implements Aventus.DefaultComponent {

    /**
     * Indicates whether this tab is currently active/selected.
     */
    @Attribute()
	selected: boolean;
    @Attribute()
	loaded: boolean;
    /**
     * Reference to the associated TabHeader component. Allows the tab content to interact with its header.
     */
    @InternalProtected()
	protected tabHeader?: Aventus.Layout.Tabs.TabHeader<this>;
    /**
     * Abstract method that concrete tab implementations must provide. It should return a unique string identifier for the tab, used to link the tab content with its header.
     */
    abstract identifier(): string;
}
}

namespace Modal {
/**
 * Abstract base class for creating various types of modal dialogs or pop-ups. It provides core functionality for showing, closing, and configuring modal behavior, including options for closing with the Escape key or outside clicks.
 */
abstract class ModalElement<T, U extends Aventus.Modal.ModalOptions<T> = Aventus.Modal.ModalOptions<T>> extends Aventus.WebComponent implements Aventus.DefaultComponent {
    /**
     * Global default for whether modals can be closed with the Escape key.
     */
    private static defaultCloseWithEsc;
    /**
     * Global default for whether modals can be closed by clicking outside.
     */
    private static defaultCloseWithClick;
    /**
     * Global default for the reject value when a modal is closed without specific resolution.
     */
    private static defaultRejectValue;
    /**
     * Allows global configuration of modal options for all instances.
     */
    static configure(options: Partial<Aventus.Modal.ModalOptions<any>>): void;
    /**
     * Factory method to create, initialize, and display a modal.
     */
    protected static _show<TModal extends Aventus.Modal.ModalElement<TResult, TOptions>, TResult = Aventus.Modal.ExtractTypeModal<TModal>, TOptions extends Aventus.Modal.ModalOptions<TResult> = Aventus.Modal.ModalOptions<TResult>>(modal: TModal, element?: Element): Promise<TResult | null>;
    /**
     * The callback function that is triggered when the modal is closed, resolving the Promise returned by show().
     */
    protected cb?: (response: T | null) => void;
    /**
     * The configuration options for this specific modal instance. Changes to this property trigger onOptionsChanged().
     */
    @Watch((target: ModalElement<T, U>, action: Aventus.WatchAction, path: string, value: any) => {
            target.onOptionsChanged();
        })
	protected options: U;
    /**
     * Reference to the internal modal content element within the component's template, used to prevent closing when clicking inside the modal.
     */
    @ViewElement()
	protected modalEl: HTMLDivElement;
    /**
     * Manages click events on the modal for closing behavior (outside click).
     */
    protected pressManagerClickClose?: Aventus.PressManager;
    /**
     * Manages click events on the modal content to prevent closing when clicking inside.
     */
    protected pressManagerPrevent?: Aventus.PressManager;
    /**
     * Initializes a new instance of the ModalElement, applying default options which can be overridden by the instance-specific configure() method.
     */
    constructor();
    /**
     * Abstract method to be implemented by subclasses to provide instance-specific modal options.
     */
    abstract configure(): U;
    /**
     * A placeholder method called when the options property changes. Subclasses can override this to react to option updates.
     */
    protected onOptionsChanged(): void;
    /**
     * Initializes the modal's callback and sets up event listeners for Escape key (using ShortcutManager) and click-to-close behavior (using PressManager).
     */
    protected init(cb: (response: T | null) => void): void;
    /**
     * Displays the modal, appending it to the specified element or document.body.
     */
    show(element?: Element): Promise<T | null>;
    /**
     * Cleans up event listeners and removes the modal from the DOM.
     */
    @BindThis()
	protected close(): void;
    /**
     * Closes the modal and resolves its promise with the configured rejectValue.
     */
    @BindThis()
	protected reject(no_close?: boolean): void;
    /**
     * Closes the modal and resolves its promise with a specified response value.
     */
    @BindThis()
	protected resolve(response: T, no_close?: boolean): void;
}
}

namespace Modal {
/**
 * A utility type to extract the return type (U) from a ModalElement instance X.
 */
type ExtractTypeModal<X extends Aventus.Modal.ModalElement<U, Y>, U = any, Y extends Aventus.Modal.ModalOptions = any> = X extends Aventus.Modal.ModalElement<infer U, Y> ? U : never;
}

namespace Navigation {
/**
 * Abstract base class for all routable pages within an Aventus application. It provides core functionality for page lifecycle management, visibility control, data loading, and access control.
 */
abstract class Page<Slug extends Aventus.UriParamsValue = {}> extends Aventus.WebComponent implements Aventus.DefaultComponent {

    /**
     * Controls the visibility of the page. Changes to this property trigger onShow() or onHide() methods.
     */
    @Property((target: Page) => {
            if(target.visible) {
                target.onShow();
            }
            else {
                target.onHide();
            }
        })
	visible: boolean;
    /**
     * Reference to the parent Router component that manages this page.
     */
    router?: Aventus.Navigation.Router;
    /**
     * The Aventus.State object associated with the current route, providing access to route parameters and other state information.
     */
    protected state?: Aventus.State;
    /**
     * Abstract method that concrete page implementations must provide to return a PageConfig object, defining how the page should behave (e.g., whether it should be destroyed on hide).
     */
    abstract configure(): Aventus.Asyncable<Aventus.Navigation.PageConfig>;
    /**
     * Asynchronously makes the page visible, setting the state property and triggering onShow().
     */
    show(state?: Aventus.State): any;
    /**
     * Asynchronously makes the page hidden, clearing the state property and triggering onHide().
     */
    hide(): any;
    /**
     * Lifecycle hook called when the page becomes visible. Subclasses can override this to implement custom logic.
     */
    onShow(): void;
    /**
     * Lifecycle hook called when the page becomes hidden. Subclasses can override this to implement custom logic.
     */
    onHide(): void;
    /**
     * Asynchronous method that can be overridden to implement custom access control logic.
     * Return true if evrything is ok
     * False will prevent showing
     * string or state will redirect to the page
     */
    isAllowed(state: Aventus.State, pattern: string, router: Aventus.Navigation.Router): Aventus.Asyncable<boolean | Aventus.State | string>;
    /**
     * Asynchronous method that can be overridden to load data required by the page.
     * Return true if evrything is ok
     * False will prevent showing
     * string or state will redirect to the page
     */
    loadData(state: Aventus.State, path: string): Aventus.Asyncable<boolean | Aventus.State | string>;
    getSlugs(): Partial<Slug> | undefined;
    getSlugs(path: string): Partial<Slug> | undefined;
}
}

namespace Navigation {
/**
 * A specialized Page component intended to be displayed when a requested route or resource is not found (a "404 Not Found" error).
 */
class Default404 extends Aventus.Navigation.Page implements Aventus.DefaultComponent {
    /**
     * @inheritdoc
