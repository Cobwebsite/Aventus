is.update.bind(this);\n        this.destroy = this.destroy.bind(this);\n    }\n    getResourceDetails() {\n        return undefined;\n    }\n    normalizeUri(uri) {\n        return uri.replace(/\\/\\/+/g, \"/\");\n    }\n    async index() {\n        const uri = this.normalizeUri(`${this.getPrefix()}/${this.getUri()}`);\n        const request = new Aventus.HttpRequest(uri, Aventus.HttpMethod.GET);\n        return await request.queryJSON(this.router);\n    }\n    async store(body) {\n        const uri = this.normalizeUri(`${this.getPrefix()}/${this.getUri()}`);\n        const request = new Aventus.HttpRequest(uri, Aventus.HttpMethod.POST);\n        request.setBody(body);\n        return await request.queryJSON(this.router);\n    }\n    // @BindThis()\n    // public async storeMany(body: U[]): Promise<Aventus.ResultWithError<S[]>> {\n    //     const requestBody = new ItemsManyRequest<T>();\n    //     const request = new Aventus.HttpRequest(`${this.getPrefix()}/${this.getUri()}/many`, Aventus.HttpMethod.POST);\n    //     request.setBody(requestBody);\n    //     return await request.queryJSON<S[]>(this.router);\n    async show(id) {\n        const uri = this.normalizeUri(`${this.getPrefix()}/${this.getUri()}/${id}`);\n        const request = new Aventus.HttpRequest(uri, Aventus.HttpMethod.GET);\n        return await request.queryJSON(this.router);\n    }\n    // @BindThis()\n    // public async showMany(ids: (string | number)[]): Promise<Aventus.ResultWithError<S[]>> {\n    //     const requestBody = new IdsManyRequest();\n    //     const request = new Aventus.HttpRequest(`${this.getPrefix()}/${this.getUri()}/show_many`, Aventus.HttpMethod.POST);\n    //     request.setBody(requestBody);\n    //     return await request.queryJSON<S[]>(this.router);\n    async update(id, body) {\n        const uri = this.normalizeUri(`${this.getPrefix()}/${this.getUri()}/${id}`);\n        const request = new Aventus.HttpRequest(uri, Aventus.HttpMethod.PUT);\n        request.enableMet